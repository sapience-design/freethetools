{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sapience-design/freethetools",
  "title": "Free the Tools",
  "description": "Local PDF, image, data and text tools for AI assistants. Files stay on your computer.",
  "websiteUrl": "https://freethetools.com",
  "icons": [
    { "src": "https://freethetools.com/icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] },
    { "src": "https://freethetools.com/icon.svg", "mimeType": "image/svg+xml", "sizes": ["any"] }
  ],
  "repository": {
    "url": "https://github.com/sapience-design/freethetools",
    "source": "github",
    "subfolder": "packages/freethetools"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "freethetools",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "FREETHETOOLS_LIBRARY",
          "description": "Folder where results and the record of jobs are kept. Default: a folder named freethetools in your home folder.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
