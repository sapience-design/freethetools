---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { REPO } from "../data/catalogue";

// Keep in step with NOTICE. Shipped = sent to your browser; build = used only to make the site.
const parts = [
  { name: "Ghostscript 9.56", by: "Artifex Software", licence: "AGPL-3.0", use: "Shipped: PDF engine in Compress PDF", url: "https://www.ghostscript.com/" },
  { name: "@jspawn/ghostscript-wasm 0.0.2", by: "jspawn", licence: "AGPL-3.0", use: "Shipped: Ghostscript compiled to WebAssembly", url: "https://www.npmjs.com/package/@jspawn/ghostscript-wasm" },
  { name: "qpdf 11.0.0", by: "Jay Berkenbilt and contributors", licence: "Apache-2.0", use: "Shipped: PDF engine in Unlock PDF", url: "https://qpdf.org/" },
  { name: "@jspawn/qpdf-wasm 0.0.2", by: "jspawn", licence: "Apache-2.0", use: "Shipped: qpdf compiled to WebAssembly", url: "https://www.npmjs.com/package/@jspawn/qpdf-wasm" },
  { name: "libheif 1.22", by: "Dirk Farin and contributors", licence: "LGPL-3.0", use: "Shipped: HEIC decoder in HEIC to JPG", url: "https://github.com/strukturag/libheif" },
  { name: "heic-to 1.6.5", by: "Hopper Gee", licence: "LGPL-3.0", use: "Shipped: libheif compiled to WebAssembly", url: "https://github.com/hoppergee/heic-to" },
  { name: "Schibsted Grotesk", by: "Schibsted Media Group", licence: "OFL-1.1", use: "Shipped: typeface", url: "https://github.com/schibsted/schibsted-grotesk" },
  { name: "Bricolage Grotesque", by: "The Bricolage Grotesque Project Authors", licence: "OFL-1.1", use: "Shipped: headings typeface", url: "https://github.com/ateliertriay/bricolage" },
  { name: "Phosphor Icons", by: "Phosphor Icons", licence: "MIT", use: "Shipped: icons, inlined at build time", url: "https://phosphoricons.com/" },
  { name: "pdf-lib 1.17", by: "Andrew Dillon", licence: "MIT", use: "Shipped: Merge, Split, Rotate, Images to PDF", url: "https://pdf-lib.js.org/" },
  { name: "pdf.js 6.3", by: "Mozilla", licence: "Apache-2.0", use: "Shipped: PDF to Images", url: "https://mozilla.github.io/pdf.js/" },
  { name: "MiniSearch 7", by: "Luca Ongaro", licence: "MIT", use: "Shipped: site search", url: "https://lucaong.github.io/minisearch/" },
  { name: "Papa Parse 5.7", by: "Matt Holt and contributors", licence: "MIT", use: "Shipped: CSV to JSON", url: "https://www.papaparse.com/" },
  { name: "fflate 0.8", by: "Arjun Barrett", licence: "MIT", use: "Shipped: Download all as a ZIP", url: "https://github.com/101arrowz/fflate" },
  { name: "qrcode-generator 2", by: "Kazuhiko Arase", licence: "MIT", use: "Shipped: QR Code Maker", url: "https://github.com/kazuhikoarase/qrcode-generator" },
  { name: "jsdiff 9", by: "Kevin Decker and contributors", licence: "BSD-3-Clause", use: "Shipped: Text Diff", url: "https://github.com/kpdecker/jsdiff" },
  { name: "marked 18", by: "Christopher Jeffrey and contributors", licence: "MIT", use: "Shipped: Markdown to HTML, File Converter", url: "https://marked.js.org/" },
  { name: "Turndown 7", by: "Dom Christie", licence: "MIT", use: "Shipped: Markdown to HTML, File Converter", url: "https://github.com/mixmark-io/turndown" },
  { name: "DOMPurify 3", by: "Cure53 and contributors", licence: "MPL-2.0 or Apache-2.0", use: "Shipped: cleaning HTML in Markdown to HTML", url: "https://github.com/cure53/DOMPurify" },
  { name: "IBM Plex Mono", by: "IBM", licence: "OFL-1.1", use: "Shipped: typeface", url: "https://github.com/IBM/plex" },
  { name: "Astro", by: "The Astro Technology Company", licence: "MIT", use: "Build: static site generator", url: "https://astro.build/" },
  { name: "opentype.js", by: "Frederik De Bleser and contributors", licence: "MIT", use: "Build: text in share images", url: "https://opentype.js.org/" },
  { name: "jsdom", by: "Domenic Denicola and contributors", licence: "MIT", use: "Build: tests for Markdown to HTML", url: "https://github.com/jsdom/jsdom" },
  { name: "sharp (with libvips)", by: "Lovell Fuller; libvips contributors", licence: "Apache-2.0 (libvips: LGPL-3.0)", use: "Build: renders share images", url: "https://sharp.pixelplumbing.com/" },
  { name: "PyMuPDF", by: "Artifex Software", licence: "AGPL-3.0", use: "Command-line version of Compress PDF only", url: "https://pymupdf.readthedocs.io/" },
];
---
<Base page="licenses" title="Licences | Free the Tools" description="Free the Tools is open source under AGPL-3.0. Here are the licences of the open-source projects it is built on.">
  <div class="page licences">
  <a class="back" href="/"><Icon name="caret-left" />All tools</a>
  <div class="intro">
    <h1 class="h1">Built in the open, on the work of others.</h1>
    <p class="lede">Free the Tools is licensed under the GNU Affero General Public License v3.0. Copyright © Sapience Design and contributors. The complete source for everything this site runs is at <a href={REPO}>{REPO.replace("https://", "")}</a>.</p>
  </div>

  <div class="card parts-wrap">
  <table class="specs parts">
    <thead><tr><th>Project</th><th>By</th><th>Licence</th><th>Used for</th></tr></thead>
    <tbody>
      {parts.map((p) => <tr><td><a href={p.url}>{p.name}</a></td><td>{p.by}</td><td class="mono">{p.licence}</td><td>{p.use}</td></tr>)}
    </tbody>
  </table>
  </div>

  <p class="note">"Free the Tools" and the Sapience name and logo are trademarks of Sapience Design and are not licensed under AGPL-3.0. Forks are welcome to use the code under a different name. See <a href={`${REPO}/blob/main/TRADEMARKS.md`}>TRADEMARKS.md</a>.</p>
  </div>
</Base>

<style>
  .licences { display: grid; gap: 24px; }
  .intro { display: grid; gap: 12px; max-width: var(--read); }
  .intro a { color: var(--ink); }
  .parts-wrap { padding: 4px 18px; }
  .parts thead th { width: auto; font-weight: 650; color: var(--soft); }
  .parts tbody tr:last-child td { border-bottom: 0; }
  .parts a { color: var(--ink); font-weight: 600; }
  .note { max-width: 70ch; color: var(--soft); font-size: 15px; }
  .note a { color: var(--ink); }
  @media (max-width: 700px) { .parts thead { display: none; } .parts tr { display: grid; padding: 10px 0; border-bottom: 1px solid var(--hair); } .parts tbody tr:last-child { border-bottom: 0; } .parts td { border: 0; padding: 2px 0; } }
</style>
