---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { loadCatalogue, REPO } from "../data/catalogue";

const { tools, aisles } = await loadCatalogue();
const planned = aisles.reduce((n, a) => n + a.wanted.length, 0);
---
<Base
  page="home"
  title="Free the Tools – everyday tools that never leave your device"
  description="Open-source tools that run in your browser. Compress PDFs and more without uploading a thing. No accounts, no ads, no tracking. A Sapience initiative."
  jsonLd={{ "@type": "WebSite", name: "Free the Tools", url: "https://freethetools.com/", description: "Open-source tools that run in your browser. Nothing is uploaded." }}
>
  <section class="opening">
    <p class="eyebrow">A Sapience initiative</p>
    <h1>Everyday tools, made to <em>stay with you.</em></h1>
    <p>Every tool here works inside your browser, so your files never leave your device. {tools.length} in stock, {planned} made to order, and anyone can make the next one.</p>
  </section>

  {aisles.map((a) => (
    <section class="shelf" aria-labelledby={`s-${a.slug}`}>
      <div class="shelf-head">
        <h2 id={`s-${a.slug}`}>{a.name}</h2>
        <a href={`/${a.slug}/`}>View all</a>
      </div>
      <ul class="grid">
        {a.sectionsUsed.flatMap((s) => [
          ...s.live.map((t) => <Card name={t.data.name} href={t.url} category={a.slug} number={t.number} blurb={t.data.tagline} toolId={t.id} />),
          ...s.wanted.map((w) => <Card name={w.name} href={w.url} category={a.slug} number={w.number} blurb={w.blurb} planned />),
        ])}
      </ul>
    </section>
  ))}

  <section class="about-strip" aria-label="How it works">
    <div><h3>Stays on your device</h3><p>Each page is locked to this site, so a tool can't send your files anywhere. Our tests check it on every change.</p></div>
    <div><h3>Made to order</h3><p>Grey prototypes are tools people have asked for. <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Make one</a> and it goes on the shelf with your name.</p></div>
    <div><h3>Open source</h3><p>All code is public under AGPL-3.0. A Sapience Design initiative, built with contributors.</p></div>
  </section>
</Base>

<style>
  .shelf + .shelf { margin-top: var(--s7); }
  .shelf-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s2); margin-bottom: var(--s3); }
  .shelf-head h2 { font-size: var(--t-lg); line-height: var(--lh-lg); font-weight: 600; }
  .shelf-head a { font-size: var(--t-sm); line-height: var(--lh-sm); color: var(--muted); text-decoration: none; }
  .shelf-head a:hover { color: var(--ink); }
  .grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: var(--s5) var(--s3); }
  .about-strip { margin-top: var(--s7); padding-top: var(--s4); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--s4) var(--s5); }
  .about-strip h3 { font-family: var(--serif); font-weight: 400; font-size: var(--t-xl); line-height: var(--lh-xl); margin-bottom: 4px; }
  .about-strip p { font-size: var(--t-sm); line-height: var(--lh-sm-ui); color: var(--muted); max-width: 38ch; }
  .about-strip a { color: var(--ink); }
</style>
