---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { CATEGORIES } from "../../data/categories";
import { loadCatalogue, REPO } from "../../data/catalogue";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const { aisles } = await loadCatalogue();
const a = aisles.find((x) => x.slug === category)!;
---
<Base
  category={a.slug}
  title={`${a.title} that run in your browser | Free the Tools`}
  description={`${a.blurb} Open source, no accounts, and nothing is uploaded.`}
  jsonLd={{
    "@type": "CollectionPage",
    name: a.title,
    description: a.blurb,
    hasPart: a.live.map((t) => ({ "@type": "WebApplication", name: t.data.name, url: new URL(t.url, Astro.site).href })),
  }}
>
  <section class="opening">
    <p class="eyebrow">{a.name} tools</p>
    <h1 class="sm">{a.blurb}</h1>
    <p>Each tool runs in your browser and never uploads your files.</p>
  </section>

  {a.live.length > 0 && (
    <section class="sect first" aria-labelledby="now">
      <div class="sect-head"><h2 id="now">Available now</h2><span>{a.live.length}</span></div>
      <ul class="grid">
        {a.live.map((t) => <Card name={t.data.name} href={t.url} category={a.slug} toolId={t.id} blurb={t.data.tagline} group={t.data.section} />)}
      </ul>
    </section>
  )}

  {a.wanted.length > 0 && (
    <section class:list={["sect", { first: !a.live.length }]} aria-labelledby="planned">
      <div class="sect-head"><h2 id="planned">In the works</h2><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Build one</a></div>
      <ul class="list">
        {a.wanted.map((w) => <li><a href={w.url}><span>{w.name}</span><span class="meta">{w.section} · open request</span></a></li>)}
      </ul>
      <p class="more"><a href={`${REPO}/issues/new?template=tool_request.yml`}>Missing something? Request a {a.name === a.name.toUpperCase() ? a.name : a.name.toLowerCase()} tool</a></p>
    </section>
  )}
</Base>

<style>
  .first { margin-top: 0; }
  .more { margin-top: var(--s3); font-size: var(--t-sm); }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--ink); }
</style>
