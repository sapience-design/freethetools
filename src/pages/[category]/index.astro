---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import SortBar from "../../components/SortBar.astro";
import { CATEGORIES } from "../../data/categories";
import { loadCatalogue, REPO } from "../../data/catalogue";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const { aisles } = await loadCatalogue();
const a = aisles.find((x) => x.slug === category)!;
---
<Base
  category={a.slug}
  title={`${a.title} that run in your browser | Free the Tools`}
  description={`${a.blurb} Open source, no accounts, and nothing is uploaded.`}
  jsonLd={{
    "@type": "CollectionPage",
    name: a.title,
    description: a.blurb,
    hasPart: a.live.map((t) => ({ "@type": "WebApplication", name: t.data.name, url: new URL(t.url, Astro.site).href })),
  }}
>
  <section class="opening">
    <p class="eyebrow">{a.name} · {a.live.length} in stock · {a.wanted.length} made to order</p>
    <h1>{a.blurb}</h1>
    <p>Each tool runs in your browser and never uploads your files.</p>
  </section>

  <SortBar />

  {a.sectionsUsed.map((s) => (
    <section class="shelf" aria-labelledby={`sec-${s.name.replace(/\W+/g, "-")}`}>
      <div class="shelf-head"><h2 id={`sec-${s.name.replace(/\W+/g, "-")}`}>{s.name}</h2></div>
      <ul class="grid">
        {s.live.map((t) => <Card name={t.data.name} href={t.url} category={a.slug} number={t.number} blurb={t.data.tagline} toolId={t.id} added={t.data.added} />)}
        {s.wanted.map((w) => <Card name={w.name} href={w.url} category={a.slug} number={w.number} blurb={w.blurb} planned />)}
      </ul>
    </section>
  ))}

  <p class="more"><a href={`${REPO}/issues/new?template=tool_request.yml`}>Missing something? Request a tool</a></p>
</Base>

<style>
  .shelf + .shelf { margin-top: var(--s6); }
  .shelf-head { margin-bottom: var(--s3); }
  .shelf-head h2 { font-size: var(--t-lg); line-height: var(--lh-lg); font-weight: 600; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: var(--s5) var(--s3); }
  .more { margin-top: var(--s6); font-size: var(--t-sm); }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--ink); }
</style>
