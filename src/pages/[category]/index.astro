---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ToolRow from "../../components/ToolRow.astro";
import { CATEGORIES } from "../../data/categories";
import { loadCatalogue, SUGGEST_URL } from "../../data/catalogue";
import { artFor } from "../../data/art";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const { aisles } = await loadCatalogue();
const a = aisles.find((x) => x.slug === category)!;
const shot = artFor(a.shot, a.slug, `grp${a.slug}`);
const secId = (name: string) => `sec-${name.replace(/\W+/g, "-")}`;
---
<Base
  category={a.slug}
  title={`${a.title} that run in your browser | Free the Tools`}
  description={`${a.blurb} Open source, no accounts, and nothing is uploaded.`}
  jsonLd={{
    "@type": "CollectionPage",
    name: a.title,
    description: a.blurb,
    hasPart: a.live.map((t) => ({ "@type": "WebApplication", name: t.data.name, url: new URL(t.url, Astro.site).href })),
  }}
>
  <div class="page group" data-g={a.slug}>
    <a class="back" href="/"><Icon name="caret-left" />All tools</a>
    <div class="banner">
      <div class="banner-text">
        <span class="tag on-tint"><span class="tag-ic"><Icon name={a.mark} /></span>{a.label}</span>
        <h1 class="h1">{a.blurb}</h1>
        <p>{a.sub}</p>
      </div>
      <span class="banner-shot" aria-hidden="true" set:html={shot} />
    </div>

    {a.sectionsUsed.map((s) => (
      <section class="sec" aria-labelledby={secId(s.name)}>
        <h2 class="label-caps" id={secId(s.name)}>{s.name}</h2>
        <ul class="rows card">
          {s.live.map((t) => <ToolRow href={t.url} task={t.data.task} sub={t.data.tagline} group={a.slug} icon={t.icon} tool={t.id} added={t.data.added} isNew={t.isNew} />)}
          {s.wanted.map((w) => <ToolRow href={w.url} task={w.name} wantId={w.id} sub={w.blurb} group={a.slug} icon={a.mark} want />)}
        </ul>
      </section>
    ))}

    <p class="more">Missing something? <a href={SUGGEST_URL}>Suggest a tool</a>, or <a href="/support/#company-h">sponsor one</a> so it is built sooner.</p>
  </div>
</Base>

<script>
  import { showWants } from "../../lib/stats";
  showWants();
</script>

<style>
  .group { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 3vw, 32px); }
  .banner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 440px); gap: clamp(16px, 2.5vw, 28px); align-items: center; padding: clamp(18px, 2.5vw, 28px); border: 1.5px solid var(--edge); border-radius: var(--r-xl); background: var(--tint); box-shadow: var(--shadow); }
  .banner-text { display: grid; gap: 14px; justify-items: start; }
  .banner-text p { color: var(--soft); }
  .banner-shot { display: block; aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; border: 1.5px solid var(--edge); }
  .banner-shot :global(svg) { display: block; width: 100%; height: 100%; }
  .sec { display: grid; gap: 10px; }
  .sec .row { min-height: 68px; }
  .sec .row-sub { font-size: 15px; }
  .more { color: var(--soft); }
  .more a { color: var(--ink); font-weight: 650; }
  @media (max-width: 760px) {
    .banner { grid-template-columns: minmax(0, 1fr); }
  }
</style>
