---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { loadCatalogue, REPO } from "../../../data/catalogue";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((t) => {
    const [category, tool] = t.id.split("/");
    return { params: { category, tool } };
  });
}

const { category, tool: slug } = Astro.params;
const { tools } = await loadCatalogue();
const tool = tools.find((t) => t.id === `${category}/${slug}`)!;
const d = tool.data;
const uis = import.meta.glob<{ default: any }>("../../../../tools/*/*/Tool.astro", { eager: true });
const UI = uis[`../../../../tools/${tool.id}/Tool.astro`]?.default;
if (!UI) throw new Error(`tools/${tool.id}/Tool.astro is missing`);
const url = new URL(tool.url, Astro.site).href;
const specs: [string, string][] = [
  ["Price", "$0, free forever"],
  ["Runs", d.offline ? "In your browser. Nothing is uploaded." : "In your browser"],
  ...Object.entries(d.specs),
  ["Licence", "AGPL-3.0"],
  ["Added", d.added],
];
---
<Base
  category={category}
  tool={slug}
  title={`${d.seoTitle} | Free the Tools`}
  description={d.description}
  jsonLd={{
    "@graph": [
      {
        "@type": "WebApplication",
        name: d.name,
        url,
        description: d.description,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any (web browser)",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        license: "https://www.gnu.org/licenses/agpl-3.0.html",
        author: d.authors.map((a) => ({ "@type": "Person", name: a.name, ...(a.github ? { url: `https://github.com/${a.github}` } : {}) })),
      },
      ...(d.faq.length ? [{ "@type": "FAQPage", mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
    ],
  }}
>
  <header class="head">
    <div>
      <p class="crumbs caps"><a href="/">All tools</a> / <a href={`/${tool.category.slug}/`}>{tool.category.name}</a></p>
    </div>
  </header>

  <div class="product">
    <div class="work">
      <UI />
    </div>

    <aside class="info">
      <h1>{d.name}</h1>
      <p class="price mono"><span class="sticker">$0</span> Free, forever</p>
      <p class="tagline">{d.tagline}</p>
      <div class="actions">
        <button class="btn line" type="button" data-save={tool.id} data-name={d.name} data-href={tool.url} aria-pressed="false">
          <span class="off">Save to my tools</span><span class="on">Saved</span>
        </button>
      </div>
      <table class="specs">
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
          <tr><th scope="row">Built by</th><td>{d.authors.map((a, i) => <>{i > 0 && ", "}{a.github ? <a href={`https://github.com/${a.github}`}>{a.name}</a> : a.name}</>)}</td></tr>
          <tr><th scope="row">Source</th><td><a href={`${REPO}/tree/main/tools/${tool.id}`}>tools/{tool.id}</a></td></tr>
          {d.cli && <tr><th scope="row">Command line</th><td><a href={`${REPO}/tree/main/tools/${tool.id}/cli`} class="mono">{d.cli}</a></td></tr>}
        </tbody>
      </table>
      <p class="report"><a href={`${REPO}/issues/new?template=bug_report.yml&tool=${encodeURIComponent(tool.id)}`}>Report a problem</a></p>
    </aside>
  </div>

  {d.faq.length > 0 && (
    <section class="faq" aria-labelledby="faq">
      <h2 id="faq" class="caps">Questions</h2>
      {d.faq.map((f) => <details class="qa"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  )}
</Base>

<style>
  .crumbs { color: var(--muted); }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }
  .product { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr); gap: 40px clamp(24px, 4vw, 64px); align-items: start; }
  .info { display: grid; gap: 18px; position: sticky; top: 28px; }
  .info h1 { font-size: clamp(28px, 3.2vw, 38px); letter-spacing: -0.025em; line-height: 1.05; }
  .price { display: flex; align-items: center; gap: 10px; font-size: 13px; }
  .sticker { background: var(--yellow); color: #111; padding: 3px 8px; border-radius: 999px; font-weight: 500; transform: rotate(-6deg); display: inline-block; }
  .tagline { color: var(--ink-soft); max-width: 46ch; }
  .actions .on { display: none; }
  .actions [aria-pressed="true"] .on { display: inline; }
  .actions [aria-pressed="true"] .off { display: none; }
  .actions [aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .specs a { color: var(--ink); }
  .report { font-size: 12.5px; }
  .report a { color: var(--muted); }
  .faq { margin-top: 80px; max-width: 760px; }
  .faq h2 { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  @media (max-width: 1000px) {
    .product { grid-template-columns: 1fr; }
    .info { position: static; order: -1; }
  }
</style>
