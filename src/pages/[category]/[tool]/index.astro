---
// /<group>/<tool>/: a real tool, or the page for a tool that is wanted but not built yet.
// Building a tool removes its entry from src/data/wanted.json; the address then simply becomes the tool.
import { getCollection } from "astro:content";
import ToolPage from "../../../components/ToolPage.astro";
import WantedTool from "../../../components/WantedTool.astro";
import { loadCatalogue } from "../../../data/catalogue";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  const { aisles } = await loadCatalogue();
  return [
    ...tools.map((t) => {
      const [category, tool] = t.id.split("/");
      return { params: { category, tool }, props: { wanted: false } };
    }),
    ...aisles.flatMap((a) => a.wanted.map((w) => ({ params: { category: a.slug, tool: w.slug }, props: { wanted: true } }))),
  ];
}

const { category, tool } = Astro.params;
const { wanted } = Astro.props;
---
{wanted ? <WantedTool category={category} slug={tool} /> : <ToolPage category={category} slug={tool} />}
