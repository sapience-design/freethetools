---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { loadCatalogue, REPO } from "../../../data/catalogue";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((t) => {
    const [category, tool] = t.id.split("/");
    return { params: { category, tool } };
  });
}

const { category, tool: slug } = Astro.params;
const { tools } = await loadCatalogue();
const tool = tools.find((t) => t.id === `${category}/${slug}`)!;
const d = tool.data;
const uis = import.meta.glob<{ default: any }>("../../../../tools/*/*/Tool.astro", { eager: true });
const UI = uis[`../../../../tools/${tool.id}/Tool.astro`]?.default;
if (!UI) throw new Error(`tools/${tool.id}/Tool.astro is missing`);
const hasAgent = `../../../../tools/${tool.id}/agent.js` in import.meta.glob("../../../../tools/*/*/agent.js");
const url = new URL(tool.url, Astro.site).href;
const specs: [string, string][] = [
  ["Runs", d.offline ? "In your browser. Nothing is uploaded." : "In your browser"],
  ...Object.entries(d.specs),
  ["Licence", "AGPL-3.0"],
  ["Added", new Date(d.added).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })],
];
---
<Base
  category={category}
  tool={slug}
  title={`${d.seoTitle} | Free the Tools`}
  description={d.description}
  jsonLd={{
    "@graph": [
      {
        "@type": "WebApplication",
        name: d.name,
        url,
        description: d.description,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any (web browser)",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        license: "https://www.gnu.org/licenses/agpl-3.0.html",
        author: d.authors.map((a) => ({ "@type": "Person", name: a.name, ...(a.github ? { url: `https://github.com/${a.github}` } : {}) })),
      },
      ...(d.faq.length ? [{ "@type": "FAQPage", mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
    ],
  }}
>
  <div class="product">
    <div class="work" id="tool-work" data-tool={tool.id}>
      <UI />
    </div>

    <aside class="info">
      <p class="eyebrow"><span class="mono">{tool.number}</span> · <a href={`/${tool.category.slug}/`}>{tool.category.name}</a> · {d.section}</p>
      <h1>{d.name}</h1>
      <p class="stock">In stock · runs on your device</p>
      <p class="tagline">{d.tagline}</p>
      <div class="actions">
        <button class="btn line" type="button" data-save={tool.id} data-name={d.name} data-href={tool.url} aria-pressed="false">
          <span class="off">Save</span><span class="on">Saved</span>
        </button>
        <button class="btn line like" type="button" id="tool-like" aria-pressed="false" aria-label={`Like ${d.name}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13.6 2.9 8.7a3.1 3.1 0 0 1 4.4-4.4l.7.7.7-.7a3.1 3.1 0 0 1 4.4 4.4Z" /></svg>
          <span id="tool-like-label">Like</span><span class="count" id="tool-like-count"></span>
        </button>
      </div>
      <p class="usage" id="tool-usage" hidden></p>
      <table class="specs">
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
          <tr><th scope="row">Built by</th><td>{d.authors.map((a, i) => <>{i > 0 && ", "}{a.github ? <a href={`https://github.com/${a.github}`}>{a.name}</a> : a.name}</>)}</td></tr>
          <tr><th scope="row">Source</th><td><a href={`${REPO}/tree/main/tools/${tool.id}`}>tools/{tool.id}</a></td></tr>
          {d.cli && <tr><th scope="row">Command line</th><td><a href={`${REPO}/tree/main/tools/${tool.id}/cli`} class="mono">{d.cli}</a></td></tr>}
        </tbody>
      </table>
      <p class="report"><a href={`${REPO}/issues/new?template=bug_report.yml&tool=${encodeURIComponent(tool.id)}`}>Report a problem</a></p>
    </aside>
  </div>

  {hasAgent && (
    <section class="agent-activity" id="agent-activity" aria-labelledby="agent-activity-h" hidden>
      <h2 id="agent-activity-h">AI agent activity</h2>
      <p class="muted">An AI agent used this tool on this page. The files stay on this device and are saved in your <a href="/library/">library</a>.</p>
      <ul class="agent-log" id="agent-log"></ul>
    </section>
  )}
  {hasAgent && <p class="sr-only" id="agent-status" role="status"></p>}

  {d.faq.length > 0 && (
    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {d.faq.map((f) => <details class="qa"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  )}
</Base>

<script>
  import { trackView, watchUse, watchOutcomes, isLiked, setLiked, summary, fmtCount } from "../../../lib/stats";
  const work = document.getElementById("tool-work")!;
  const tool = work.dataset.tool!;
  const like = document.getElementById("tool-like") as HTMLButtonElement;
  const count = document.getElementById("tool-like-count")!;
  const label = document.getElementById("tool-like-label")!;
  const usage = document.getElementById("tool-usage")!;

  import { startAgentPage } from "../../../agent/page.js";
  trackView(tool);
  watchUse(tool, work);
  watchOutcomes(tool, work);
  startAgentPage(work, tool);

  function paint(on: boolean) {
    like.setAttribute("aria-pressed", String(on));
    label.textContent = on ? "Liked" : "Like";
  }
  paint(isLiked(tool));
  summary().then((s) => {
    const t = s?.[tool];
    if (!t) return;
    count.textContent = t.likes ? fmtCount(t.likes) : "";
    if (t.uses) { usage.textContent = `Used ${fmtCount(t.uses)} ${t.uses === 1 ? "time" : "times"}`; usage.hidden = false; }
  });
  like.addEventListener("click", async () => {
    const on = like.getAttribute("aria-pressed") !== "true";
    paint(on);
    const total = await setLiked(tool, on);
    if (total !== null) count.textContent = total ? fmtCount(total) : "";
  });
</script>

<style>
  .product { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr); gap: var(--s5) clamp(var(--s4), 5vw, var(--s7)); align-items: start; }
  .info { display: grid; gap: var(--s3); position: sticky; top: var(--s5); }
  .info .eyebrow a { color: inherit; text-decoration: none; }
  .info .eyebrow a:hover { color: var(--ink); }
  .info h1 { font-family: var(--serif); font-weight: 400; font-size: var(--t-3xl); line-height: var(--lh-3xl); }
  .stock { font-size: var(--t-xs); line-height: var(--lh-xs); font-weight: 500; margin-top: -12px; }
  .tagline { color: var(--ink-soft); font-size: var(--t-lg); line-height: var(--lh-lg); max-width: 38ch; }
  .actions .on { display: none; }
  .actions [aria-pressed="true"] .on { display: inline; }
  .actions [aria-pressed="true"] .off { display: none; }
  .actions [aria-pressed="true"] { background: var(--ink); color: var(--paper); box-shadow: none; }
  .like svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; transition: transform .2s; }
  .like .count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .like .count:empty { display: none; }
  .actions .like[aria-pressed="true"] { background: var(--paper); color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .like[aria-pressed="true"] svg { fill: #e5484d; stroke: #e5484d; transform: scale(1.1); }
  .usage { font-size: var(--t-sm); line-height: var(--lh-sm); color: var(--muted); margin-top: -8px; }
  .report { font-size: var(--t-sm); }
  .report a { color: var(--muted); }
  .report a:hover { color: var(--ink); }
  .faq { margin-top: var(--s7); max-width: 760px; }
  .faq h2 { font-size: var(--t-lg); line-height: var(--lh-lg); padding-bottom: var(--s2); border-bottom: 1px solid var(--line); }
  .agent-activity { margin-top: var(--s6); max-width: 760px; display: grid; gap: var(--s2); }
  .agent-activity h2 { font-size: var(--t-lg); line-height: var(--lh-lg); padding-bottom: var(--s2); border-bottom: 1px solid var(--line); }
  .agent-activity[hidden] { display: none; }
  .agent-log { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .agent-log :global(.agent-call) { display: grid; gap: 6px; padding: var(--s2) 0; border-bottom: 1px solid var(--line); font-size: var(--t-sm); line-height: var(--lh-sm); }
  .agent-log :global(.agent-call p) { margin: 0; }
  .agent-log :global(.agent-call.bad .agent-head + p) { color: var(--bad); }
  .agent-log :global(.agent-data) { color: var(--ink-soft); overflow-wrap: anywhere; }
  .agent-log :global(.agent-files) { display: flex; flex-wrap: wrap; gap: var(--s1); }
  @media (max-width: 1080px) {
    .product { grid-template-columns: 1fr; }
    .info { position: static; order: -1; }
  }
</style>
