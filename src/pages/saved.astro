---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base page="saved" title="Favourites | Free the Tools" description="The tools you use most, kept in this browser only." noindex>
  <div class="page narrow saved">
    <a class="back" href="/"><Icon name="caret-left" />All tools</a>
    <div class="intro">
      <h1 class="h1">Your favourites</h1>
      <p class="lede">The tools you use most, kept in this browser. Nothing is stored anywhere else.</p>
    </div>
    <ul class="rows card" id="saved-list" hidden></ul>
    <div class="empty card" id="saved-empty">
      <p><b>No favourites yet.</b> Press <b>Add to favourites</b> on any tool to keep it here.</p>
      <p>To keep the whole site handy, bookmark it with <kbd>Ctrl</kbd> + <kbd>D</kbd> (<kbd>⌘</kbd> + <kbd>D</kbd> on a Mac), or install it as an app from your browser's address bar.</p>
      <p><a class="btn" href="/">Browse all tools</a></p>
    </div>
  </div>
</Base>

<style>
  .saved { display: grid; gap: 24px; }
  .intro { display: grid; gap: 12px; }
  .saved-list :global(li), #saved-list :global(li) { display: flex; align-items: center; gap: 8px; padding-right: 10px; }
  #saved-list :global(.row) { flex: 1; min-width: 0; grid-template-columns: minmax(0, 1fr) auto; }
  #saved-list :global(.row-sub) { grid-column: 1; }
  #saved-list :global(.row-go) { grid-column: 2; }
  .empty { display: grid; gap: 14px; padding: 18px; color: var(--soft); }
  .empty b { color: var(--ink); }
</style>

<script>
  const list = document.getElementById("saved-list")!;
  const empty = document.getElementById("saved-empty")!;
  type Saved = Record<string, { name: string; href: string }>;
  const load = (): Saved => { try { return JSON.parse(localStorage.getItem("ftt:saved") || "{}"); } catch { return {}; } };
  document.addEventListener("saved-change", (e) => render((e as CustomEvent).detail));
  render(load());

  function render(saved: Saved) {
    const ids = Object.keys(saved);
    empty.hidden = ids.length > 0;
    list.hidden = ids.length === 0;
    list.replaceChildren(
      ...ids.map((id) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.className = "row";
        a.href = saved[id].href;
        const t = document.createElement("span");
        t.className = "row-title";
        const b = document.createElement("b");
        b.textContent = saved[id].name;
        t.append(b);
        const sub = document.createElement("span");
        sub.className = "row-sub";
        sub.textContent = saved[id].href;
        a.append(t, sub);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn quiet small";
        btn.dataset.save = id;
        btn.dataset.name = saved[id].name;
        btn.dataset.href = saved[id].href;
        btn.textContent = "Remove";
        li.append(a, btn);
        return li;
      }),
    );
  }
</script>
