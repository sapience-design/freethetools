---
// One tool in a list: tinted icon tile, the job in plain words, a sub line, a caret.
// Planned tools ("Requested") link to their own page, where people can say they want it, and carry
// an "I want this" button beside the link (a sibling, never inside it). stats.ts wires the button.
// Sorting and search read the data- attributes; [data-stat] is filled with usage figures in the
// browser, and [data-want] with "12 want this" on planned tools.
import Icon from "./Icon.astro";
import { t } from "../i18n/index";
import { SPONSOR_URL } from "../data/catalogue";

interface Props {
  href: string;
  task: string;
  sub: string;
  group: string;
  icon: string;
  tool?: string;
  added?: string;
  isNew?: boolean;
  want?: boolean;
  /** "group/slug" of a planned tool, the id its "I want this" votes are counted under. */
  wantId?: string;
  lang?: string;
}
const { href, task, sub, group, icon, tool, added, isNew = false, want = false, wantId, lang = "en" } = Astro.props;
const canVote = want && !!wantId;
const wantText = t(lang, "wanted.want");
---
<li class:list={[{ want, vote: canVote }]} data-g={group} data-tool={tool} data-added={added} data-name={task} data-u={href} data-want-id={wantId}>
  <a class:list={["row", { want }]} href={href}>
    <span class="row-ic"><Icon name={icon} weight={want ? "bold" : "duotone"} /></span>
    <span class="row-title"><b>{task}</b>{isNew && <span class="badge new">{t(lang, "row.new")}</span>}{want && <span class="badge want">{t(lang, "row.notBuilt")}</span>}</span>
    <span class="row-sub">{sub}<span data-want></span><span data-stat></span></span>
    <span class="row-go"><Icon name="caret-right" /></span>
  </a>
  {canVote && (
    <div class="row-acts">
    <button class="row-want" type="button" data-want-btn aria-label={`${wantText}: ${task}`}
      data-done-label={`${t(lang, "js.wanted.done")}: ${task}`}
      data-done={t(lang, "js.wanted.done")} data-failed={t(lang, "js.wanted.failed")}>
      <Icon name="thumbs-up" /><span class="row-want-t">{wantText}</span>
    </button>
    <a class="row-sponsor" href={SPONSOR_URL} aria-label={`${t(lang, "wanted.sponsor")}: ${task}`}><Icon name="hand-heart" /><span>{t(lang, "wanted.sponsor")}</span></a>
    <span class="sr-only" role="status" data-want-live></span>
    </div>
  )}
</li>
