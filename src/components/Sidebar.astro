---
// Two-level sidebar: the top level lists tool groups; inside a group it swaps to that group's
// own list with a back link. Typing in search replaces the list with results.
import { loadCatalogue, REPO } from "../data/catalogue";

interface Props { category?: string; tool?: string; page?: "home" | "about" | "licenses" | "saved" }
const { category, tool, page } = Astro.props;
const { aisles, searchIndex } = await loadCatalogue();
const aisle = aisles.find((a) => a.slug === category);
---
<aside class="side" id="side" aria-label="Site navigation">
  <div class="side-in">
    <div class="top">
      <a class="wordmark" href="/" aria-label="Free the Tools, home"><span class="mark" aria-hidden="true"></span><span>Free <i>the</i> Tools</span></a>
      <button class="close" id="side-close" type="button" aria-label="Close menu">Close</button>
    </div>

    <form class="search" role="search" action="/" method="get">
      <label for="find" class="sr-only">Search tools</label>
      <input id="find" name="q" type="search" placeholder="Search" autocomplete="off">
      <kbd id="find-key">/</kbd>
    </form>

    <nav class="panels">
      <ul class="nav results" id="side-results" hidden aria-live="polite"></ul>

      {aisle ? (
        <div class="panel nav-sub" id="panel">
          <a class="back" href="/"><span aria-hidden="true">←</span> All tools</a>
          <p class="group-title">{aisle.name}</p>
          <ul class="nav">
            <li><a class:list={[{ on: !tool }]} href={`/${aisle.slug}/`} aria-current={!tool ? "page" : undefined}>Overview</a></li>
          </ul>
          {aisle.sectionsUsed.map((s) => (
            <div class="sec">
              <p class="sec-name eyebrow">{s.name}</p>
              <ul class="nav">
                {s.live.map((t) => (
                  <li><a class:list={[{ on: tool === t.slug }]} href={t.url} aria-current={tool === t.slug ? "page" : undefined}>{t.data.short}</a></li>
                ))}
                {s.wanted.map((w) => (
                  <li><a class="want" href={w.url} title="Not built yet. Open the request on GitHub.">{w.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <a class="add" href={`${REPO}/issues/new?template=tool_request.yml`}>Request a tool</a>
        </div>
      ) : (
        <div class="panel nav-root" id="panel">
          <p class="sec-name eyebrow">Tools</p>
          <ul class="nav">
            <li><a class:list={[{ on: page === "home" }]} href="/" aria-current={page === "home" ? "page" : undefined}>All tools</a></li>
            {aisles.map((a) => (
              <li><a class="drill" href={`/${a.slug}/`}>{a.name}<span>{a.live.length ? a.live.length : ""}</span></a></li>
            ))}
          </ul>
          <p class="sec-name eyebrow">Project</p>
          <ul class="nav">
            <li><a class:list={[{ on: page === "about" }]} href="/about/">About</a></li>
            <li><a href={`${REPO}/issues/new?template=tool_request.yml`}>Request a tool</a></li>
            <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Build a tool</a></li>
          </ul>
        </div>
      )}

      <ul class="nav gap">
        <li><a class:list={["drill", { on: page === "saved" }]} href="/saved/">Saved<span data-saved-count>0</span></a></li>
      </ul>
    </nav>

    <a class="initiative" href="https://sapience.design">
      <span>A Sapience initiative</span>
      <img src="/brand/sapience-wordmark.webp" alt="Sapience" width="76" height="14">
    </a>
  </div>
  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
</aside>
<div class="scrim" id="scrim" hidden></div>

<style>
  .side { position: sticky; top: 0; height: 100vh; }
  .side-in { height: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: var(--s4); padding: var(--s5) 0 var(--s3); }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: var(--t-base); line-height: var(--lh-base); letter-spacing: -0.01em; text-decoration: none; color: var(--ink); white-space: nowrap; }
  .wordmark i { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 17px; margin: 0 1px; }
  .mark { width: 22px; height: 22px; border-radius: 6px; background: var(--ink); position: relative; flex: none; }
  .mark::after { content: ""; position: absolute; left: 5px; right: 5px; bottom: 5px; height: 3px; border-radius: 2px; background: var(--accent); }
  .close { display: none; border: 0; background: none; font: inherit; font-size: var(--t-sm); color: var(--muted); cursor: pointer; }

  .search { position: relative; }
  .search input { width: 100%; height: 36px; font: inherit; font-size: var(--t-sm); line-height: var(--lh-sm-ui); padding: 0 32px 0 12px; border: 1px solid var(--control-line); border-radius: 8px; background: var(--paper); color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .search input::placeholder { color: var(--muted); }
  .search input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 35%, transparent); }
  .search kbd { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); }

  .panels { flex: 1; display: grid; align-content: start; gap: var(--s3); }
  .nav-root, .nav-sub { display: grid; gap: var(--s1); }
  .nav-root { view-transition-name: nav-root; }
  .nav-sub { view-transition-name: nav-sub; }
  .nav { list-style: none; margin: 0 0 var(--s2); padding: 0; display: grid; gap: 1px; }
  .nav a { position: relative; display: flex; align-items: center; gap: var(--s1); min-height: 32px; padding: 0 10px; margin: 0 -10px; border-radius: 8px; color: var(--ink-soft); text-decoration: none; font-size: var(--t-sm); line-height: var(--lh-sm-ui); font-weight: 500; transition: background .15s, color .15s; }
  .nav a:hover { background: var(--studio); color: var(--ink); }
  .nav a.on { background: var(--studio); color: var(--ink); font-weight: 500; }
  .drill span { margin-left: auto; font-size: var(--t-xs); color: var(--muted); font-variant-numeric: tabular-nums; }
  .want { color: var(--muted) !important; }
  .want { font-weight: 400 !important; }
  .want::after { content: "to order"; margin-left: auto; font-size: var(--t-xs); line-height: var(--lh-xs); color: var(--muted); }
  .sec-name { padding: var(--s1) 0 2px; }
  .group-title { font-size: var(--t-lg); line-height: var(--lh-lg); font-weight: 600; color: var(--ink-strong); margin-bottom: 4px; }
  .back { display: inline-flex; gap: 6px; font-size: var(--t-sm); color: var(--muted); text-decoration: none; margin-bottom: var(--s2); }
  .back:hover { color: var(--ink); }
  .sec { display: grid; gap: 2px; }
  .add { font-size: var(--t-sm); color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); }
  .add:hover { color: var(--ink); text-decoration-color: currentColor; }

  .results :global(a) { display: grid; min-height: 0; padding: 6px 10px; margin: 0 -10px; border-radius: 8px; font-size: var(--t-sm); line-height: var(--lh-sm-ui); font-weight: 500; color: var(--ink); text-decoration: none; }
  .results :global(a:hover), .results :global(a.sel) { background: var(--studio); }
  .results :global(small) { font-size: var(--t-xs); color: var(--muted); }
  .results :global(.empty) { font-size: var(--t-sm); color: var(--muted); }

  .initiative { display: grid; gap: 8px; font-size: var(--t-xs); color: var(--muted); text-decoration: none; }
  .initiative img { height: 15px; width: auto; opacity: .9; }
  .initiative:hover { color: var(--ink); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .initiative img { filter: invert(1); } }

  .scrim { display: none; }
  @media (max-width: 960px) {
    .side { position: fixed; inset: 0 auto 0 0; z-index: 30; width: min(86vw, 320px); height: 100%; background: var(--paper); padding: 0 var(--s3); transform: translateX(-100%); transition: transform .25s cubic-bezier(.2,.7,.2,1); }
    .side.open { transform: none; box-shadow: 0 0 80px rgba(0,0,0,.2); }
    .side-in { padding-top: var(--s3); }
    .close { display: block; }
    .scrim { display: block; position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.3); }
  }
</style>

<script>
  type Item = { n: string; c: string; u: string; k: string; w?: 1 };
  const index: Item[] = JSON.parse(document.getElementById("search-index")!.textContent!);
  const input = document.getElementById("find") as HTMLInputElement;
  const key = document.getElementById("find-key")!;
  const results = document.getElementById("side-results")!;
  const panel = document.getElementById("panel")!;
  const side = document.getElementById("side")!;
  const scrim = document.getElementById("scrim")!;

  function search() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    results.hidden = !words.length;
    panel.hidden = !!words.length;
    if (!words.length) return;
    const hits = index
      .filter((i) => words.every((w) => `${i.n} ${i.c} ${i.k}`.toLowerCase().includes(w)))
      .sort((a, b) => (a.w ?? 0) - (b.w ?? 0));
    results.replaceChildren(
      ...hits.map((h, i) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = h.u;
        if (i === 0) a.className = "sel";
        a.append(h.n);
        const small = document.createElement("small");
        small.textContent = h.w ? `${h.c} · planned` : h.c;
        a.append(small);
        li.append(a);
        return li;
      }),
    );
    if (!hits.length) {
      const li = document.createElement("li");
      li.className = "empty";
      li.textContent = "No tool matches yet. Press Enter to request it.";
      results.append(li);
    }
  }

  input.addEventListener("input", search);
  input.form!.addEventListener("submit", (e) => {
    e.preventDefault();
    const first = results.querySelector("a") as HTMLAnchorElement | null;
    location.href = first ? first.href : "https://github.com/sapience-design/freethetools/issues/new?template=tool_request.yml";
  });
  input.addEventListener("focus", () => (key.hidden = true));
  input.addEventListener("blur", () => (key.hidden = !!input.value));
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key === "/" && t.tagName !== "INPUT" && t.tagName !== "TEXTAREA") { e.preventDefault(); openSide(); input.focus(); }
    if (e.key === "Escape") { input.value = ""; search(); closeSide(); }
  });
  const q = new URLSearchParams(location.search).get("q");
  if (q) { input.value = q; search(); }

  // Phone: the sidebar is a drawer.
  function openSide() { side.classList.add("open"); scrim.hidden = false; }
  function closeSide() { side.classList.remove("open"); scrim.hidden = true; }
  document.getElementById("menu")?.addEventListener("click", openSide);
  document.getElementById("side-close")!.addEventListener("click", closeSide);
  scrim.addEventListener("click", closeSide);
</script>
