---
// Two-level sidebar panel: the top level lists tool groups; inside a group it swaps to that group's
// own list with a back link. Typing in search replaces the list with results. The theme switch and
// the Sapience mark sit in a footer pinned to the bottom of the panel.
import { loadCatalogue, REPO } from "../data/catalogue";

interface Props { category?: string; tool?: string; page?: "home" | "about" | "licenses" | "saved" | "stats" }
const { category, tool, page } = Astro.props;
const { aisles, searchIndex } = await loadCatalogue();
const aisle = aisles.find((a) => a.slug === category);
const icon = {
  system: '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M6 13.5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
  light: '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
  dark: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 9.6A5.5 5.5 0 0 1 6.4 2.8a5.5 5.5 0 1 0 6.8 6.8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>',
};
---
<aside class="side" id="side" aria-label="Site navigation">
  <div class="side-head">
    <a class="wordmark" href="/" aria-label="Free the Tools, home"><span class="mark" aria-hidden="true"></span><span>Free <i>the</i> Tools</span></a>
    <button class="close" id="side-close" type="button" aria-label="Close menu">Close</button>
  </div>

  <form class="search" role="search" action="/" method="get">
    <label for="find" class="sr-only">Search tools</label>
    <input id="find" name="q" type="search" placeholder="Search tools" autocomplete="off">
    <kbd id="find-key">/</kbd>
  </form>

  <!-- Always in the page, so a screen reader hears each change. The results list below is hidden until you type. -->
  <p class="sr-only" id="side-status" role="status"></p>

  <nav class="side-scroll" aria-label="Tools">
    <ul class="nav results" id="side-results" hidden></ul>

    {aisle ? (
      <div class="panel nav-sub" id="panel">
        <a class="back" href="/"><span aria-hidden="true">←</span> All tools</a>
        <p class="group-title">{aisle.name}</p>
        <ul class="nav">
          <li><a class:list={[{ on: !tool }]} href={`/${aisle.slug}/`} aria-current={!tool ? "page" : undefined}>Overview</a></li>
        </ul>
        {aisle.sectionsUsed.map((s) => (
          <div class="sec">
            <p class="sec-name">{s.name}</p>
            <ul class="nav">
              {s.live.map((t) => (
                <li><a class:list={[{ on: tool === t.slug }]} href={t.url} aria-current={tool === t.slug ? "page" : undefined}>{t.data.short}</a></li>
              ))}
              {s.wanted.map((w) => (
                <li><a class="want" href={w.url} title="Not built yet. Open the request on GitHub.">{w.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <a class="add" href={`${REPO}/issues/new?template=tool_request.yml`}>Request a tool</a>
      </div>
    ) : (
      <div class="panel nav-root" id="panel">
        <div class="sec">
          <ul class="nav">
            <li><a class:list={[{ on: page === "home" }]} href="/" aria-current={page === "home" ? "page" : undefined}>All tools</a></li>
            <li><a class:list={["drill", { on: page === "saved" }]} href="/saved/">Saved<span data-saved-count>0</span></a></li>
          </ul>
        </div>
        <div class="sec">
          <p class="sec-name">Groups</p>
          <ul class="nav">
            {aisles.map((a) => (
              <li><a class="drill" href={`/${a.slug}/`}>{a.name}<span>{a.live.length || ""}</span></a></li>
            ))}
          </ul>
        </div>
        <div class="sec">
          <p class="sec-name">Project</p>
          <ul class="nav">
            <li><a class:list={[{ on: page === "about" }]} href="/about/">About</a></li>
            <li><a class:list={[{ on: page === "stats" }]} href="/stats/">Usage stats</a></li>
            <li><a href={`${REPO}/issues/new?template=tool_request.yml`}>Request a tool</a></li>
            <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Build a tool</a></li>
          </ul>
        </div>
      </div>
    )}
  </nav>

  <div class="side-foot">
    <div class="theme" role="group" aria-label="Theme">
      <button type="button" data-theme-set="system" aria-pressed="true" title="Match your device" aria-label="System theme" set:html={icon.system} />
      <button type="button" data-theme-set="light" aria-pressed="false" title="Light" aria-label="Light theme" set:html={icon.light} />
      <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark" aria-label="Dark theme" set:html={icon.dark} />
    </div>
    <a class="initiative" href="https://sapience.design" aria-label="A Sapience initiative">
      <img src="/brand/sapience-wordmark.webp" alt="Sapience" width="76" height="14">
    </a>
  </div>
  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
</aside>
<div class="scrim" id="scrim" hidden></div>

<style>
  .side {
    position: sticky; top: 0; height: 100vh; height: 100dvh; display: flex; flex-direction: column;
    background: var(--side-bg); border-right: 1px solid var(--line);
  }
  .side-head { display: flex; justify-content: space-between; align-items: center; height: 60px; padding: 0 20px; flex: none; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: var(--t-base); line-height: var(--lh-base); letter-spacing: -0.01em; text-decoration: none; color: var(--ink); white-space: nowrap; }
  .wordmark i { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 17px; margin: 0 1px; }
  .mark { width: 22px; height: 22px; border-radius: 6px; background: var(--ink); position: relative; flex: none; }
  .mark::after { content: ""; position: absolute; left: 5px; right: 5px; bottom: 5px; height: 3px; border-radius: 2px; background: var(--accent); }
  .close { display: none; border: 0; background: none; font: inherit; font-size: var(--t-sm); color: var(--muted); cursor: pointer; }

  .search { position: relative; margin: 4px 20px 12px; flex: none; }
  .search input { width: 100%; height: 34px; font: inherit; font-size: var(--t-sm); line-height: var(--lh-sm-ui); padding: 0 30px 0 10px; border: 1px solid var(--control-line); border-radius: 8px; background: var(--paper); color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .search input::placeholder { color: var(--muted); }
  .search input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .search kbd { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: var(--side-bg); }

  /* The list scrolls only if it must, and its scrollbar stays invisible until you hover it. */
  .side-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 4px 20px 16px; scrollbar-color: transparent transparent; scrollbar-gutter: stable; }
  .side-scroll:hover { scrollbar-color: var(--scroll) transparent; }
  .nav-root, .nav-sub { display: grid; gap: 16px; }
  .nav-root { view-transition-name: nav-root; }
  .nav-sub { view-transition-name: nav-sub; }
  .sec { display: grid; gap: 2px; }
  .sec-name { padding: 0 10px 4px; font-size: var(--t-xs); line-height: var(--lh-xs); color: var(--muted); font-weight: 500; }
  .nav { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .nav a { display: flex; align-items: center; gap: var(--s1); min-height: 30px; padding: 0 10px; border-radius: 7px; color: var(--ink-soft); text-decoration: none; font-size: var(--t-sm); line-height: var(--lh-sm-ui); font-weight: 500; transition: background .12s, color .12s; }
  .nav a:hover { background: var(--studio); color: var(--ink); }
  .nav a.on { background: var(--studio-2); color: var(--ink-strong); }
  .drill span { margin-left: auto; font-size: var(--t-xs); color: var(--muted); font-variant-numeric: tabular-nums; font-weight: 400; }
  .want { color: var(--muted) !important; font-weight: 400 !important; }
  .want::after { content: "to order"; margin-left: auto; font-size: var(--t-xs); line-height: var(--lh-xs); color: var(--muted); }
  .back { display: inline-flex; gap: 6px; padding: 0 10px; font-size: var(--t-sm); color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .group-title { padding: 0 10px; font-size: var(--t-lg); line-height: var(--lh-lg); font-weight: 600; color: var(--ink-strong); }
  .add { padding: 0 10px; font-size: var(--t-sm); color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .add:hover { color: var(--ink); text-decoration-color: currentColor; }

  .results :global(a) { display: grid; min-height: 0; padding: 6px 10px; border-radius: 7px; font-size: var(--t-sm); line-height: var(--lh-sm-ui); font-weight: 500; color: var(--ink); text-decoration: none; }
  .results :global(a:hover), .results :global(a.sel) { background: var(--studio-2); }
  .results :global(small) { font-size: var(--t-xs); color: var(--muted); font-weight: 400; }
  .results :global(.empty) { padding: 6px 10px; font-size: var(--t-sm); color: var(--muted); }

  .side-foot { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 20px 16px; border-top: 1px solid var(--line); }
  .theme { display: inline-flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--studio); }
  .theme button { display: grid; place-items: center; width: 28px; height: 26px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  .theme button :global(svg) { width: 15px; height: 15px; }
  .theme button:hover { color: var(--ink); }
  .theme button[aria-pressed="true"] { background: var(--paper); color: var(--ink-strong); box-shadow: 0 1px 2px rgba(0,0,0,.12); }
  .initiative { display: inline-flex; opacity: .7; transition: opacity .15s; }
  .initiative:hover { opacity: 1; }
  .initiative img { height: 13px; width: auto; filter: var(--logo-filter); }

  .scrim { display: none; }
  @media (max-width: 960px) {
    .side { position: fixed; inset: 0 auto 0 0; z-index: 30; width: min(86vw, 300px); height: 100%; transform: translateX(-100%); transition: transform .25s cubic-bezier(.2,.7,.2,1); }
    .side.open { transform: none; box-shadow: 0 0 80px rgba(0,0,0,.25); }
    .close { display: block; }
    .scrim { display: block; position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.35); }
  }
</style>

<script>
  import { makeSearch } from "../lib/search.js";

  // ---- Theme: System (follows the device), Light or Dark; remembered in this browser only ----
  const THEME = "ftt:theme";
  const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-set]")];
  function applyTheme(choice: string) {
    const root = document.documentElement;
    if (choice === "light" || choice === "dark") root.dataset.theme = choice; else delete root.dataset.theme;
    themeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeSet === (choice === "light" || choice === "dark" ? choice : "system"))));
  }
  let stored = "system";
  try { stored = localStorage.getItem(THEME) || "system"; } catch {}
  applyTheme(stored);
  themeButtons.forEach((b) => b.addEventListener("click", () => {
    const choice = b.dataset.themeSet!;
    try { choice === "system" ? localStorage.removeItem(THEME) : localStorage.setItem(THEME, choice); } catch {}
    applyTheme(choice);
  }));

  // ---- Search ----
  type Item = { n: string; c: string; u: string; k: string; w?: 1 };
  const index: Item[] = JSON.parse(document.getElementById("search-index")!.textContent!);
  const input = document.getElementById("find") as HTMLInputElement;
  const key = document.getElementById("find-key")!;
  const results = document.getElementById("side-results")!;
  const panel = document.getElementById("panel")!;
  const side = document.getElementById("side")!;
  const scrim = document.getElementById("scrim")!;

  const status = document.getElementById("side-status")!;
  const find = makeSearch(index);
  function search() {
    const q = input.value;
    results.hidden = !q.trim();
    panel.hidden = !!q.trim();
    if (!q.trim()) { status.textContent = ""; return; }
    const hits = find(q).slice(0, 12);
    results.replaceChildren(
      ...hits.map((h, i) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = h.u;
        if (i === 0) a.className = "sel";
        a.append(h.n);
        const small = document.createElement("small");
        small.textContent = h.w ? `${h.c} · made to order` : h.c;
        a.append(small);
        li.append(a);
        return li;
      }),
    );
    if (!hits.length) {
      const li = document.createElement("li");
      li.className = "empty";
      li.textContent = "No tool matches yet. Press Enter to request it.";
      results.append(li);
    }
    status.textContent = hits.length ? `${hits.length} ${hits.length === 1 ? "result" : "results"}. Use the up and down arrow keys, then Enter.` : "No tool matches yet. Press Enter to request it.";
  }

  // Arrow keys move through results; Enter opens the highlighted one.
  input.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    const links = [...results.querySelectorAll("a")];
    if (!links.length) return;
    e.preventDefault();
    const at = links.findIndex((l) => l.classList.contains("sel"));
    const next = (at + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length;
    links.forEach((l, i) => l.classList.toggle("sel", i === next));
    links[next].scrollIntoView({ block: "nearest" });
    // The highlight is visual only, so say which result is selected.
    status.textContent = `${links[next].textContent}, ${next + 1} of ${links.length}`;
  });

  input.addEventListener("input", search);
  input.form!.addEventListener("submit", (e) => {
    e.preventDefault();
    const first = (results.querySelector("a.sel") ?? results.querySelector("a")) as HTMLAnchorElement | null;
    location.href = first ? first.href : "https://github.com/sapience-design/freethetools/issues/new?template=tool_request.yml";
  });
  input.addEventListener("focus", () => (key.hidden = true));
  input.addEventListener("blur", () => (key.hidden = !!input.value));
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key === "/" && t.tagName !== "INPUT" && t.tagName !== "TEXTAREA") { e.preventDefault(); openSide(); input.focus(); }
    if (e.key === "Escape") { input.value = ""; search(); closeSide(); }
  });
  const q = new URLSearchParams(location.search).get("q");
  if (q) { input.value = q; search(); }

  // Phone: the sidebar is a drawer. Closed, it is inert (off screen, so out of the tab order).
  // Open, it takes focus, keeps Tab inside it and makes the page behind it inert.
  const phone = window.matchMedia("(max-width: 960px)");
  const menu = document.getElementById("menu");
  const main = document.querySelector<HTMLElement>(".main");
  const isOpen = () => side.classList.contains("open");
  function syncInert() {
    side.inert = phone.matches && !isOpen();
    if (main) main.inert = phone.matches && isOpen();
  }
  function openSide() {
    side.classList.add("open");
    scrim.hidden = false;
    syncInert();
    if (phone.matches && document.activeElement !== input) document.getElementById("side-close")!.focus();
  }
  function closeSide() {
    const wasOpen = isOpen();
    const hadFocus = side.contains(document.activeElement);
    side.classList.remove("open");
    scrim.hidden = true;
    syncInert();
    // Give focus back to the button that opened the drawer.
    if (wasOpen && phone.matches && (hadFocus || document.activeElement === document.body)) menu?.focus();
  }
  menu?.addEventListener("click", openSide);
  document.getElementById("side-close")!.addEventListener("click", closeSide);
  scrim.addEventListener("click", closeSide);
  side.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || !phone.matches || !isOpen()) return;
    const stops = [...side.querySelectorAll<HTMLElement>("a[href], button, input")].filter((el) => !el.hidden && !el.closest("[hidden]") && el.getClientRects().length);
    const first = stops[0], last = stops[stops.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  phone.addEventListener("change", () => { side.classList.remove("open"); scrim.hidden = true; syncInert(); });
  syncInert();
</script>
