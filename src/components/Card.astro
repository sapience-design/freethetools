---
// A product card. Tools that exist show the finished object and are "In stock"; planned tools
// show a clay prototype and are "Made to order", linking to the open request.
import { artFor, prototypeFor } from "../data/art";

interface Props {
  name: string;
  href: string;
  category: string;
  number: string;
  blurb: string;
  toolId?: string;
  planned?: boolean;
}
const { name, href, category, number, blurb, toolId, planned = false } = Astro.props;
const uid = (toolId ?? `${category}-${name}`).replace(/[^a-z0-9]/gi, "");
const shot = planned ? prototypeFor(name, category, uid) : artFor(toolId ?? "", category, uid);
---
<li class:list={["card", { planned }]}>
  <a href={href}>
    <span class="shot" set:html={shot} />
    <span class="body">
      <span class="no">{number}</span>
      <span class="name">{name}</span>
      <span class="blurb">{blurb}</span>
      <span class="stock">{planned ? "Made to order" : "In stock"}</span>
    </span>
  </a>
  {!planned && toolId && (
    <button class="save" type="button" data-save={toolId} data-name={name} data-href={href} aria-pressed="false" aria-label={`Save ${name}`}>
      <span class="off">Save</span><span class="on">Saved</span>
    </button>
  )}
</li>

<style>
  .card { position: relative; list-style: none; }
  .card a { display: grid; gap: 14px; text-decoration: none; color: var(--ink); }
  .shot { display: block; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; background: var(--studio); }
  .shot :global(svg) { display: block; width: 100%; height: 100%; }
  .shot :global(.obj) {
    transition: transform .7s cubic-bezier(.2, .7, .2, 1);
  }
  .card a:hover .shot :global(.obj) {
    transform: translateY(-5px);
  }
  .body { display: grid; gap: 2px; }
  .no { font-family: var(--mono); font-size: var(--t-xs); line-height: var(--lh-xs); color: var(--muted); margin-bottom: 4px; }
  .name { font-family: var(--serif); font-size: var(--t-xl); line-height: var(--lh-xl); color: var(--ink-strong); }
  .blurb { font-size: var(--t-sm); line-height: var(--lh-sm); color: var(--muted); max-width: 40ch; }
  .stock { margin-top: 8px; font-size: var(--t-xs); line-height: var(--lh-xs); font-weight: 500; color: var(--ink); letter-spacing: .01em; }
  .planned .stock { color: var(--muted); font-weight: 400; }
  .planned .name { color: var(--ink-soft); }
  .card a:hover .name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .save {
    position: absolute; top: 10px; right: 10px; height: 28px; padding: 0 12px; border: 0; border-radius: 999px;
    background: rgba(255, 255, 255, .86); backdrop-filter: blur(6px); color: #111;
    font: inherit; font-size: var(--t-xs); line-height: var(--lh-xs); font-weight: 500; cursor: pointer;
    opacity: 0; transform: translateY(-2px); transition: opacity .2s, transform .2s;
  }
  .card:hover .save, .save:focus-visible, .save[aria-pressed="true"] { opacity: 1; transform: none; }
  .save .on { display: none; }
  .save[aria-pressed="true"] { background: #111; color: #fff; }
  .save[aria-pressed="true"] .on { display: inline; }
  .save[aria-pressed="true"] .off { display: none; }
  @media (hover: none) { .save { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .card a:hover .shot :global(*) { transform: none !important; } }
</style>
