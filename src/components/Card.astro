---
// A tool card: studio shot, name, one line on what it does.
import { artFor } from "../data/art";

interface Props { name: string; href: string; category: string; toolId: string; blurb: string; group?: string; size?: "lg" }
const { name, href, category, toolId, blurb, group, size } = Astro.props;
const uid = toolId.replace(/[^a-z0-9]/gi, "");
---
<li class:list={["card", size]}>
  <a href={href}>
    <span class="shot" set:html={artFor(toolId, category, uid)} />
    <span class="body">
      <span class="row">
        <span class="name">{name}</span>
        {group && <span class="group">{group}</span>}
      </span>
      <span class="blurb">{blurb}</span>
    </span>
  </a>
  <button class="save" type="button" data-save={toolId} data-name={name} data-href={href} aria-pressed="false" aria-label={`Save ${name}`}>
    <span class="off">Save</span><span class="on">Saved</span>
  </button>
</li>

<style>
  .card { position: relative; list-style: none; }
  .card a { display: grid; gap: var(--s2); text-decoration: none; color: var(--ink); }
  .shot { display: block; aspect-ratio: 4 / 3; background: var(--studio); border-radius: 14px; overflow: hidden; }
  .shot :global(svg) { display: block; width: 100%; height: 100%; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .card a:hover .shot :global(svg) { transform: scale(1.035); }
  .body { display: grid; gap: 4px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s2); }
  .name { font-size: var(--t-base); line-height: var(--lh-base); font-weight: 500; color: var(--ink-strong); }
  .group { font-size: var(--t-xs); line-height: var(--lh-xs); color: var(--muted); }
  .blurb { font-size: var(--t-sm); line-height: var(--lh-sm); color: var(--muted); max-width: 44ch; }
  .card a:hover .name { text-decoration: underline; text-underline-offset: 4px; }

  .lg a { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s5); align-items: center; }
  .lg .shot { aspect-ratio: 16 / 10; }
  .lg .name { font-size: var(--t-2xl); line-height: var(--lh-2xl); font-weight: 600; letter-spacing: -0.015em; }
  .lg .blurb { font-size: var(--t-base); line-height: var(--lh-base); color: var(--ink-soft); }
  .lg .body { gap: var(--s2); }
  .lg .row { flex-direction: column-reverse; align-items: flex-start; gap: var(--s1); }
  @media (max-width: 760px) { .lg a { grid-template-columns: 1fr; gap: var(--s3); } }

  .save {
    position: absolute; top: 12px; right: 12px; height: 30px; padding: 0 12px; border: 0; border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(6px); color: var(--ink);
    font: inherit; font-size: var(--t-xs); line-height: var(--lh-xs); font-weight: 500; cursor: pointer; opacity: 0; transition: opacity .2s;
  }
  .card:hover .save, .save:focus-visible, .save[aria-pressed="true"] { opacity: 1; }
  .save .on { display: none; }
  .save[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .save[aria-pressed="true"] .on { display: inline; }
  .save[aria-pressed="true"] .off { display: none; }
  @media (hover: none) { .save { opacity: 1; } }
</style>
