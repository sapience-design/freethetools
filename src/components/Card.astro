---
// A product card: studio shot, name, price. Wanted tools show a dashed backdrop and link to their request.
import { artFor } from "../data/art";

interface Props { name: string; href: string; category: string; toolId?: string; wanted?: boolean; note?: string }
const { name, href, category, toolId, wanted = false, note } = Astro.props;
const uid = (toolId ?? `${category}-${name}`).replace(/[^a-z0-9]/gi, "");
---
<li class:list={["card", { wanted }]}>
  <a href={href}>
    <span class="shot" set:html={artFor(toolId ?? null, category, uid)} />
    {wanted ? <span class="sticker-w">Wanted</span> : <span class="sticker mono">$0</span>}
    <span class="name">{name}</span>
    <span class="price mono">{wanted ? "Open request · build it" : note ?? "Free"}</span>
  </a>
  {!wanted && toolId && (
    <button class="save" type="button" data-save={toolId} data-name={name} data-href={href} aria-pressed="false" aria-label={`Save ${name}`}>
      <span class="off">Save</span><span class="on">Saved</span>
    </button>
  )}
</li>

<style>
  .card { position: relative; }
  .card a { display: grid; gap: 4px; text-decoration: none; color: var(--ink); }
  .shot { display: block; aspect-ratio: 4 / 5; background: var(--studio); overflow: hidden; margin-bottom: 12px; }
  .shot :global(svg) { display: block; width: 100%; height: 100%; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .card a:hover .shot :global(svg) { transform: scale(1.04) translateY(-4px); }
  .sticker { position: absolute; top: 14px; left: 14px; font-size: 11px; font-weight: 500; background: var(--yellow); color: #111; padding: 3px 7px; border-radius: 999px; transform: rotate(-6deg); }
  .name { font-size: 13.5px; color: var(--ink-soft); }
  .price { font-size: 12px; color: var(--ink); }
  .wanted .shot { background: color-mix(in srgb, var(--studio) 55%, var(--paper)); }
  .wanted .shot :global(svg) { opacity: .5; filter: grayscale(1); }
  .wanted .sticker-w { position: absolute; top: 14px; left: 14px; font: 500 10.5px var(--mono); text-transform: uppercase; letter-spacing: .04em; color: var(--ink-soft); border: 1px dashed var(--muted); padding: 3px 8px; border-radius: 999px; }
  .wanted .price { color: var(--muted); }
  .save { position: absolute; top: 12px; right: 12px; border: 0; background: var(--paper); color: var(--ink); font: inherit; font-size: 11px; letter-spacing: .04em; text-transform: uppercase; padding: 5px 9px; cursor: pointer; opacity: 0; transition: opacity .15s; }
  .card:hover .save, .save:focus-visible, .save[aria-pressed="true"] { opacity: 1; }
  .save .on { display: none; }
  .save[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .save[aria-pressed="true"] .on { display: inline; }
  .save[aria-pressed="true"] .off { display: none; }
  @media (hover: none) { .save { opacity: 1; } }
</style>
