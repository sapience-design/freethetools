---
// Sort control for catalogue pages. Sorts every .grid on the page in place; tools you can use
// always come before made-to-order ones. Also fills each card's usage line from the stats API.
const options = [
  ["featured", "Featured"], ["used", "Most used"], ["liked", "Most liked"], ["new", "Newest"], ["az", "A–Z"],
];
---
<div class="sortbar" role="group" aria-label="Sort tools">
  <span class="eyebrow">Sort</span>
  <div class="seg sort">
    {options.map(([v, label], i) => (<><input type="radio" name="sort" id={`sort-${v}`} value={v} checked={i === 0} /><label for={`sort-${v}`}>{label}</label></>))}
  </div>
</div>

<style>
  .sortbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: calc(var(--s4) * -1) 0 var(--s5); }
  .sort { display: inline-grid; grid-auto-flow: column; grid-template-columns: none; }
  .sort label { padding: 5px 12px; white-space: nowrap; }
  @media (max-width: 560px) { .sort { grid-auto-flow: row; grid-template-columns: repeat(3, auto); } }
</style>

<script>
  import { summary, fmtCount, type ToolStats } from "../lib/stats";
  const KEY = "ftt:sort";
  let stats: Record<string, ToolStats> = {};
  const grids = [...document.querySelectorAll<HTMLElement>("main .grid")];
  // Remember each card's original position for "Featured".
  grids.forEach((g) => [...g.children].forEach((c, i) => ((c as HTMLElement).dataset.pos = String(i))));

  const val = (li: HTMLElement, by: string): number | string => {
    const s = stats[li.dataset.tool ?? ""];
    if (by === "used") return s?.uses ?? 0;
    if (by === "liked") return s?.likes ?? 0;
    if (by === "new") return li.dataset.added ?? "";
    if (by === "az") return li.dataset.name ?? "";
    return -Number(li.dataset.pos);
  };
  function sort(by: string) {
    for (const g of grids) {
      const cards = [...g.children] as HTMLElement[];
      cards.sort((a, b) => {
        const pa = a.classList.contains("planned"), pb = b.classList.contains("planned");
        if (pa !== pb) return pa ? 1 : -1;
        if (pa) return Number(a.dataset.pos) - Number(b.dataset.pos); // planned keep their order
        const va = val(a, by), vb = val(b, by);
        if (by === "az") return String(va).localeCompare(String(vb));
        return va < vb ? 1 : va > vb ? -1 : Number(a.dataset.pos) - Number(b.dataset.pos);
      });
      g.append(...cards);
    }
  }
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="sort"]')];
  radios.forEach((r) => r.addEventListener("change", () => { sort(r.value); try { localStorage.setItem(KEY, r.value); } catch {} }));
  let saved = "featured";
  try { saved = localStorage.getItem(KEY) || "featured"; } catch {}
  const start = radios.find((r) => r.value === saved);
  if (start) start.checked = true;

  summary().then((s) => {
    if (s) {
      stats = s;
      document.querySelectorAll<HTMLElement>("li[data-tool]").forEach((li) => {
        const t = s[li.dataset.tool!];
        const el = li.querySelector<HTMLElement>("[data-stat]");
        if (!t || !el || !(t.uses || t.likes)) return;
        el.textContent = [t.uses ? `${fmtCount(t.uses)} uses` : "", t.likes ? `${fmtCount(t.likes)} likes` : ""].filter(Boolean).join(" · ");
        el.hidden = false;
      });
    } else {
      // No stats available (e.g. local development): usage sorts would do nothing, so hide them.
      radios.filter((r) => r.value === "used" || r.value === "liked").forEach((r) => { r.disabled = true; (r.nextElementSibling as HTMLElement).hidden = true; });
    }
    sort(radios.find((r) => r.checked && !r.disabled)?.value ?? "featured");
  });
</script>
