---
// The page for a tool that people have asked for and nobody has built yet, at the address the
// tool will have. It cannot do the job, so it is kept out of search results and the sitemap
// (docs/explanation/seo-policy.md). When the tool is built its entry leaves src/data/wanted.json
// and this address becomes the tool.
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { loadCatalogue, groupIn, wantedIn, SUGGEST_URL } from "../data/catalogue";
import { t as ui, jsStrings, localePath } from "../i18n/index";

interface Props { category: string; slug: string; lang?: string }
const { category, slug, lang = "en" } = Astro.props;
const T = (key: string, vars: Record<string, string | number> = {}) => ui(lang, `wanted.${key}`, vars);
const { aisles } = await loadCatalogue();
const group = aisles.find((a) => a.slug === category)!;
const w0 = group.wanted.find((x) => x.slug === slug)!;
const w = { ...w0, ...wantedIn(w0, lang) };
const groupText = groupIn(group, lang);
const ask = `${SUGGEST_URL}?tool=${encodeURIComponent(w.id)}`;
const wantedJs = JSON.stringify(jsStrings(lang, "wanted")).replace(/</g, "\\u003c");
---
<Base
  category={category}
  lang={lang}
  crumb={w.name}
  noindex
  title={T("title", { name: w.name })}
  description={T("description", { name: w.name })}
>
  <div class="page narrow wanted" data-g={category}>
    <a class="back" href={localePath(lang, `/${category}/`)}><Icon name="caret-left" />{groupText.label}</a>
    <header class="head">
      <span class="tag"><span class="tag-ic"><Icon name={group.mark} /></span>{T("tag")}</span>
      <h1 class="h1">{w.task}</h1>
      <p class="lede">{T("lede", { name: w.name })}</p>
    </header>

    <section class="card concept" aria-labelledby="concept-h">
      <h2 class="h3" id="concept-h">{T("conceptTitle")}</h2>
      <dl>
        <div><dt>{T("in")}</dt><dd>{w.concept.in}</dd></div>
        <div><dt>{T("out")}</dt><dd>{w.concept.out}</dd></div>
        <div>
          <dt>{T("options")}</dt>
          <dd><ul>{w.concept.options.map((o) => <li>{o}</li>)}</ul></dd>
        </div>
      </dl>
      <p class="safe-note"><Icon name="shield-check" /><span>{T("safe")}</span></p>
    </section>

    <section class="card want" aria-labelledby="want-h">
      <h2 class="h3" id="want-h">{T("needTitle")}</h2>
      <p class="count" id="want-count" role="status" data-id={w.id}></p>
      <div class="actions">
        <button class="btn" type="button" id="want-btn"><Icon name="thumbs-up" />{T("want")}</button>
        <a class="btn line" href={ask}><Icon name="chat-circle-text" />{T("tell")}</a>
        <a class="btn line" href="/support/#company-h"><Icon name="hand-heart" />{T("sponsor")}</a>
      </div>
      <p class="privacy">{T("privacy")}</p>
    </section>

    <p class="dev"><a href={w.request}><Icon name="code" />{T("dev")}</a></p>
  </div>
  <script type="application/json" id="ftt-wanted" set:html={wantedJs} />
</Base>

<script>
  import { fullSummary, hasWanted, wantThis, fmtCount } from "../lib/stats";
  import { txt, txtN } from "../lib/ui";
  const w = (key: string, fallback: string) => txt(key, fallback, {}, "ftt-wanted");
  const box = document.getElementById("want-count")!;
  const btn = document.getElementById("want-btn") as HTMLButtonElement;
  const id = box.dataset.id!;
  const label = btn.lastChild!;
  let total: number | null = null;

  const show = () => {
    const n = total ?? 0;
    box.textContent = total === null ? "" : n > 0 ? txtN("people", n, { one: "{n} person wants this.", other: "{n} people want this." }, { n: fmtCount(n) }, "ftt-wanted") : w("none", "Nobody has asked for this yet. Be the first.");
  };
  const done = () => { btn.setAttribute("aria-pressed", "true"); btn.disabled = true; label.textContent = w("done", "You want this"); };

  if (hasWanted(id)) done();
  fullSummary().then((s) => { if (s) { total = s.wants?.[id] ?? 0; show(); } });

  btn.addEventListener("click", async () => {
    if (btn.disabled) return;
    btn.disabled = true;
    const n = await wantThis(id);
    if (n === null) {
      btn.disabled = false;
      box.textContent = w("failed", "We could not count that just now. Please try again later.");
      return;
    }
    total = n;
    done();
    show();
  });
</script>

<style>
  .wanted { display: grid; gap: 22px; }
  .head { display: grid; gap: 10px; justify-items: start; }
  .concept, .want { display: grid; gap: 14px; padding: clamp(16px, 2.5vw, 24px); }
  .concept dl { display: grid; gap: 14px; margin: 0; }
  .concept dt { font-weight: 650; }
  .concept dd { margin: 2px 0 0; color: var(--soft); }
  .concept dd ul { margin: 0; padding-left: 20px; }
  .safe-note { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: var(--r); background: var(--ok-t); margin: 0; }
  .safe-note :global(.ic) { color: var(--ok); font-size: 22px; margin-top: 1px; flex: none; }
  .count { font-size: 19px; font-weight: 650; margin: 0; min-height: 1.5em; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .privacy { font-size: 14px; color: var(--muted); margin: 0; }
  .dev { font-size: 14px; margin: 0; }
  .dev a { color: var(--soft); display: inline-flex; align-items: center; gap: 6px; }
  #want-btn[aria-pressed="true"] { opacity: 1; background: var(--ok-t); color: var(--ink); border-color: var(--ok); box-shadow: none; }
</style>
