---
// A wide product-shot banner for tools that don't take files (text, data, generators).
import { artFor } from "../data/art";

interface Props { toolId: string; category: string; name: string }
const { toolId, category, name } = Astro.props;
const shot = artFor(toolId, category, `${toolId.replace(/\W/g, "")}banner`, name);
---
<div class="banner" aria-hidden="true" set:html={shot} />

<style>
  .banner { aspect-ratio: 16 / 7; border-radius: 6px; overflow: hidden; }
  .banner :global(svg) { width: 100%; height: 100%; display: block; }
</style>
