---
// The PDF pages screen (docs/adr/0016-shared-screens.md): one screen for the PDF tools that work on
// a PDF's pages. Each tool's Tool.astro opens it ready for its own job; the job buttons at the top
// switch to another job on the same file, keeping every change, so nobody chooses the file twice.
// The logic is src/lib/pdf-pages/screen.ts and the engine src/lib/pdf-pages/core.js.
// Ids are prefixed with the tool's slug, as in every tool, so each tool keeps the ids it had.
import DropZone from "./DropZone.astro";
import Step from "./Step.astro";
import Icon from "./Icon.astro";

export type PdfPagesJob = "rotate" | "arrange";
interface Props { prefix: string; toolId: string; name: string; job: PdfPagesJob }
const { prefix: p, toolId, name, job } = Astro.props;
const JOBS: { job: PdfPagesJob; label: string }[] = [
  { job: "rotate", label: "Turn pages" },
  { job: "arrange", label: "Delete or reorder" },
];
const STEP2: Record<PdfPagesJob, string> = { rotate: "Which way?", arrange: "Arrange the pages" };
---
<section class="tool pdf-pages" id={`${p}-tool`} aria-label={name} data-pdf-pages data-prefix={p} data-job={job}>
  <fieldset class="pp-jobs">
    <legend class="sr-only">What to do with the pages</legend>
    <div class="seg">
      {JOBS.map((j) => (
        <>
          <input type="radio" name={`${p}-job`} id={`${p}-job-${j.job}`} value={j.job} checked={j.job === job} />
          <label for={`${p}-job-${j.job}`}>{j.label}</label>
        </>
      ))}
    </div>
  </fieldset>

  <Step n={1} title="Choose your PDF">
    <DropZone prefix={p} toolId={toolId} category="pdf" name={name} accept="application/pdf,.pdf" title="Drop your PDF here" hint="From your computer, phone or a USB stick" button="Choose PDF" />
    <p class="tool-error" id={`${p}-reject`} role="alert" hidden></p>
    <ul class="file-list" id={`${p}-picked`} hidden>
      <li class="has-thumb">
        <span class="fthumb" id={`${p}-thumb`}><Icon name="file-pdf" weight="duotone" /></span>
        <span class="finfo"><span class="fname" id={`${p}-name`}></span><span class="fmeta" id={`${p}-meta`}></span></span>
        <span class="fact"><button class="btn quiet small" id={`${p}-change`} type="button">Change</button></span>
      </li>
    </ul>
  </Step>

  <Step n={2} title={STEP2[job]} state="later">
    <div class="pp-job" data-job="rotate" hidden={job !== "rotate"}>
      <fieldset class="choices">
        <legend class="sr-only">Turn</legend>
        <div class="choice"><input type="radio" name={`${p}-turn`} id={`${p}-90`} value="90" checked><label for={`${p}-90`}><b>Turn right</b><small>90° clockwise</small><span class="badge rec">Recommended</span></label></div>
        <div class="choice"><input type="radio" name={`${p}-turn`} id={`${p}-270`} value="270"><label for={`${p}-270`}><b>Turn left</b><small>90° anticlockwise</small></label></div>
        <div class="choice"><input type="radio" name={`${p}-turn`} id={`${p}-180`} value="180"><label for={`${p}-180`}><b>Upside down</b><small>180°</small></label></div>
      </fieldset>
      <fieldset class="field">
        <legend>Which pages</legend>
        <div class="seg">
          <input type="radio" name={`${p}-which`} id={`${p}-all`} value="all" checked><label for={`${p}-all`}>All pages</label>
          <input type="radio" name={`${p}-which`} id={`${p}-some`} value="some"><label for={`${p}-some`}>Some pages</label>
        </div>
      </fieldset>
      <label class="field" id={`${p}-range-field`} hidden>
        <span>Pages to turn</span>
        <input type="text" id={`${p}-range`} placeholder="2, 5-7" autocomplete="off">
        <small>Use a dash for a range and commas between pages, like 2, 5-7.</small>
      </label>
    </div>

    <div class="pp-job" data-job="arrange" hidden={job !== "arrange"}>
      <p class="hint">Each page has buttons to move it earlier or later, turn it or delete it. You can also drag a page to a new place.</p>
      <div class="field">
        <label class="field-label" for={`${p}-del`}>Delete pages by number</label>
        <div class="pp-del">
          <input type="text" class="input" id={`${p}-del`} placeholder="2, 5-7" autocomplete="off" aria-describedby={`${p}-del-help`}>
          <button class="btn quiet small" id={`${p}-del-go`} type="button">Delete them</button>
        </div>
        <small id={`${p}-del-help`}>Use a dash for a range and commas between pages, like 2, 5-7.</small>
        <p class="tool-error" id={`${p}-del-err`} role="alert" hidden></p>
      </div>
    </div>

    <div class="field" id={`${p}-preview`} hidden>
      <span class="field-label" id={`${p}-preview-label`}>How the pages will look</span>
      <div id={`${p}-pages`}></div>
    </div>
    <p class="sr-only" id={`${p}-say`} role="status"></p>
    <div class="actions">
      <button class="btn run" id={`${p}-go`} type="button" disabled>
        <span class="pp-ic" data-job="rotate" hidden={job !== "rotate"}><Icon name="arrow-clockwise" /></span>
        <span class="pp-ic" data-job="arrange" hidden={job !== "arrange"}><Icon name="check" /></span>
        <span id={`${p}-go-label`}>{job === "rotate" ? "Turn pages" : "Delete, move or turn a page first"}</span>
      </button>
      <button class="btn quiet small" id={`${p}-reset`} type="button" hidden>Undo all changes</button>
    </div>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id={`${p}-result`} aria-live="polite"><p class="res-wait">Your new PDF will appear here.</p></div>
    <button class="btn quiet" id={`${p}-again`} type="button" hidden><Icon name="arrow-counter-clockwise" />Do another</button>
  </Step>
</section>

<script>
  import { startPdfPages } from "../lib/pdf-pages/screen";
  document.querySelectorAll<HTMLElement>("[data-pdf-pages]").forEach(startPdfPages);
</script>

<style>
  .pp-jobs { border: 0; margin: 0; padding: 0; min-width: 0; }
  .pp-del { display: flex; flex-wrap: wrap; gap: 8px; }
  .pp-del .input { flex: 1 1 160px; min-width: 0; }
  .pp-ic { display: contents; }
</style>
