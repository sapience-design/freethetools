---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { loadCatalogue, groupIn, toolIn, toolUrl, REPO } from "../data/catalogue";
import { t as ui, slots, localePath } from "../i18n/index";

// A tool page, in English at /<group>/<tool>/ and in every language that has a text file for it at
// /<lang>/<group>/<tool>/. Only the page around the tool is translated; the tool itself is English.
interface Props { category: string; slug: string; lang?: string }
const { category, slug, lang = "en" } = Astro.props;
const T = (key: string, vars: Record<string, string | number> = {}) => ui(lang, `tool.${key}`, vars);
const { tools } = await loadCatalogue();
const tool = tools.find((t) => t.id === `${category}/${slug}`)!;
const d = { ...tool.data, ...toolIn(tool, lang) };
const groupText = groupIn(tool.category, lang);
const agentText = slots(T("agentText")).map((x) => (typeof x === "string" ? x : { href: "/library/", text: T("agentLibrary") }));
const uis = import.meta.glob<{ default: any }>("../../tools/*/*/Tool.astro", { eager: true });
const UI = uis[`../../tools/${tool.id}/Tool.astro`]?.default;
if (!UI) throw new Error(`tools/${tool.id}/Tool.astro is missing`);
const hasAgent = `../../tools/${tool.id}/agent.js` in import.meta.glob("../../tools/*/*/agent.js");
const url = new URL(toolUrl(tool, lang), Astro.site).href;
const specs: [string, string][] = [
  [T("specRuns"), d.offline ? T("specRunsOffline") : T("specRunsOnline")],
  ...Object.entries(d.specs),
  [T("specLicence"), "AGPL-3.0"],
  [T("specAdded"), new Date(d.added).toLocaleDateString(lang === "en" ? "en-GB" : lang, { day: "numeric", month: "long", year: "numeric" })],
];
const files = category === "pdf" || category === "images";
const safe = files ? [T("safeFilesA"), T("safeFilesB")] : [T("safeOtherA"), T("safeOtherB")];
---
<Base
  category={category}
  tool={slug}
  lang={lang}
  title={T("titleSuffix", { title: d.seoTitle })}
  description={d.description}
  jsonLd={{
    "@graph": [
      {
        "@type": "WebApplication",
        name: d.name,
        url,
        description: d.description,
        inLanguage: lang,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any (web browser)",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        license: "https://www.gnu.org/licenses/agpl-3.0.html",
        // The studio is an organisation; contributors are people.
        author: d.authors.map((a) => a.name === "Sapience Design"
          ? { "@type": "Organization", name: a.name, url: "https://sapience.design" }
          : { "@type": "Person", name: a.name, ...(a.github ? { url: `https://github.com/${a.github}` } : {}) }),
      },
      ...(d.faq.length ? [{ "@type": "FAQPage", mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
    ],
  }}
>
  <script>
    // First on the page, so a result a tool draws as it loads is captured too (Share needs its Blob).
    import { installBlobCapture } from "../agent/blob-capture.js";
    installBlobCapture();
  </script>
  <div class="page tool-page" data-g={category}>
    <div class="tp-main">
      <a class="back" href={localePath(lang, `/${category}/`)}><Icon name="caret-left" />{groupText.label}</a>
      <header class="tp-head">
        <span class="tag"><span class="tag-ic"><Icon name={tool.category.mark} /></span>{d.name}</span>
        <h1 class="h1">{d.task}</h1>
        <p class="lede">{d.tagline}</p>
        <div class="tp-actions">
          {/* One heart: it keeps the tool in Favourites (see Base.astro) and counts one public like. */}
          <button class="pillbtn like" type="button" id="tool-like" data-save={tool.id} data-name={tool.data.name} data-href={tool.url} aria-pressed="false">
            <span class="off"><Icon name="heart" /></span><span class="on"><Icon name="heart" weight="fill" /></span>
            <span class="off">{T("favAdd")}</span><span class="on">{T("favOn")}</span><span class="sr-only"> {d.name}</span><span class="count" id="tool-like-count"></span>
          </button>
          <span class="usage" id="tool-usage" hidden></span>
        </div>
      </header>
      {lang !== "en" && <p class="tool-note">{ui(lang, "toolNote")}</p>}
      <div class="work" id="tool-work" lang={lang !== "en" ? "en" : undefined} data-tool={tool.id} data-vendor={JSON.stringify(d.vendor.map((v) => `/${tool.id}/vendor/${v.to}`))}>
        <UI />
      </div>
      {hasAgent && (
        <section class="agent-activity" id="agent-activity" aria-labelledby="agent-activity-h" hidden>
          <h2 class="h3" id="agent-activity-h">{T("agentTitle")}</h2>
          <p>{agentText.map((x) => (typeof x === "string" ? x : <a href={x.href}>{x.text}</a>))}</p>
          <ul class="agent-log" id="agent-log"></ul>
        </section>
      )}
      {hasAgent && <p class="sr-only" id="agent-status" role="status"></p>}
    </div>

    <aside class="tp-side" aria-label={T("sideLabel")}>
      <p class="safe"><Icon name="shield-check" /><span><b>{safe[0]}</b> {safe[1]} <a href="/how-it-works/">{T("check")}</a></span></p>
      {d.offline && <p class="safe offline-note" data-offline-note hidden><Icon name="wifi-slash" /><span><b>{T("offlineBold")}</b> {T("offlineText")}</span></p>}
      {d.faq.length > 0 && (
        <section class="help" aria-labelledby="faq">
          <h2 class="sr-only" id="faq">{T("questions")}</h2>
          {d.faq.map((f) => <details class="qa"><summary>{f.q}<Icon name="plus" /></summary><p>{f.a}</p></details>)}
        </section>
      )}
      <section class="facts" aria-labelledby="facts-h">
        <h2 class="h3" id="facts-h">{T("about")}</h2>
        <table class="specs">
          <tbody>
            {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
            <tr><th scope="row">{T("specBuilt")}</th><td>{d.authors.map((a, i) => <>{i > 0 && ", "}{a.github ? <a href={`https://github.com/${a.github}`}>{a.name}</a> : a.name}</>)}</td></tr>
            <tr><th scope="row">{T("specSource")}</th><td><a href={`${REPO}/tree/main/tools/${tool.id}`}>tools/{tool.id}</a></td></tr>
          </tbody>
        </table>
        <p class="report"><a href={`/suggest/?tool=${encodeURIComponent(tool.id)}&kind=problem`}>{T("report")}</a></p>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { trackView, watchUse, watchOutcomes, summary, fmtCount } from "../lib/stats";
  import { txtN } from "../lib/ui";
  const work = document.getElementById("tool-work")!;
  const tool = work.dataset.tool!;
  const like = document.getElementById("tool-like") as HTMLButtonElement;
  const count = document.getElementById("tool-like-count")!;
  const usage = document.getElementById("tool-usage")!;

  import { startAgentPage } from "../agent/page.js";
  trackView(tool);
  watchUse(tool, work);
  watchOutcomes(tool, work);
  startAgentPage(work, tool);

  // When the service worker is serving this page, say the tool works offline. Its vendor files
  // (WebAssembly engines) load only on first use, so fetch them on the first touch of the tool;
  // the service worker keeps them.
  import { isOfflineReady } from "../lib/offline";
  if (isOfflineReady()) {
    document.querySelector<HTMLElement>("[data-offline-note]")?.removeAttribute("hidden");
    const vendor: string[] = JSON.parse(work.dataset.vendor || "[]");
    if (vendor.length) {
      const warm = () => vendor.forEach((u) => fetch(u).then((r) => r.arrayBuffer()).catch(() => {}));
      work.addEventListener("pointerdown", warm, { once: true });
      work.addEventListener("change", warm, { once: true });
    }
  }

  // A Share button next to every result link, where this browser can share the file.
  import { watchShare, liveRegion } from "../lib/share";
  const say = liveRegion("agent-status");
  watchShare(work, {
    say,
    onShared: (link) => work.dispatchEvent(new CustomEvent("ftt:shared", { detail: { link } })),
  });
  const log = document.getElementById("agent-log");
  if (log) watchShare(log, { say });

  summary().then((s) => {
    const t = s?.[tool];
    if (!t) return;
    count.textContent = t.likes ? fmtCount(t.likes) : "";
    if (t.uses) { usage.textContent = txtN("used", t.uses, { one: "Used {n} time", other: "Used {n} times" }, { n: fmtCount(t.uses) }); usage.hidden = false; }
  });
  // Base.astro handles the press (favourite and like together, once) and the pressed state. Here
  // we only show the new public count when it arrives.
  document.addEventListener("likes-change", (e) => {
    const { tool: id, likes } = (e as CustomEvent).detail;
    if (id === tool && likes !== null) count.textContent = likes ? fmtCount(likes) : "";
  });
</script>

<style>
  .tool-page { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px clamp(28px, 3vw, 48px); align-items: start; }
  .tp-main { min-width: 0; display: grid; gap: 22px; }
  .tp-head { display: grid; gap: 10px; justify-items: start; }
  .tp-head .h1 { margin-top: 2px; }
  .tp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 4px; }
  .pillbtn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 1.5px solid var(--hair); border-radius: 999px; background: var(--card); font-weight: 650; font-size: 15px; cursor: pointer; }
  .pillbtn:hover { border-color: var(--edge); }
  .pillbtn :global(.ic) { font-size: 18px; }
  .pillbtn .on { display: none; }
  .pillbtn[aria-pressed="true"] .on { display: inline-flex; }
  .pillbtn[aria-pressed="true"] .off { display: none; }
  .like .count { color: var(--muted); font-family: var(--mono); font-size: 13px; font-weight: 400; }
  .like .count:empty { display: none; }
  .like[aria-pressed="true"] { border-color: var(--edge); background: var(--bad-t); }
  .like[aria-pressed="true"] :global(.ic) { color: var(--bad); }
  .usage { font-size: 14px; color: var(--muted); }
  .tool-note { margin: 0; padding: 10px 14px; border-radius: var(--r); background: var(--well); font-size: 15px; }

  .tp-side { min-width: 0; display: grid; gap: 18px; position: sticky; top: 90px; }
  .safe { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: var(--r); background: var(--ok-t); }
  .safe :global(.ic) { color: var(--ok); font-size: 22px; margin-top: 1px; }
  .safe a { color: var(--ink); font-weight: 650; white-space: nowrap; }
  .help { border-bottom: 1px solid var(--hair); }
  .facts { display: grid; gap: 8px; padding: 16px; border: 1.5px solid var(--hair); border-radius: var(--r-lg); background: var(--card); }
  .facts .specs { font-size: 14px; }
  .facts .specs tr:last-child th, .facts .specs tr:last-child td { border-bottom: 0; }
  .report { font-size: 14px; }
  .report a { color: var(--soft); }
  @media (max-width: 960px) {
    .tool-page { grid-template-columns: minmax(0, 1fr); }
    .tp-side { position: static; }
  }
  .agent-activity { display: grid; gap: 12px; padding: clamp(16px, 2vw, 22px); border: 1.5px solid var(--edge); border-radius: var(--r-xl); background: var(--card); box-shadow: var(--shadow); }
  .agent-activity[hidden] { display: none; }
  .agent-activity > p { color: var(--soft); }
  .agent-activity a:not(.btn) { color: var(--ink); }
  .agent-log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .agent-log :global(.agent-call) { display: grid; gap: 6px; padding: 12px 14px; border: 1.5px solid var(--hair); border-radius: var(--r); font-size: 15px; }
  .agent-log :global(.agent-call p) { margin: 0; }
  .agent-log :global(.agent-head) { font-weight: 650; }
  .agent-log :global(.agent-call.bad .agent-head + p) { color: var(--bad); }
  .agent-log :global(.agent-data) { color: var(--soft); overflow-wrap: anywhere; }
  .agent-log :global(.agent-files) { display: flex; flex-wrap: wrap; gap: 8px; }
  .agent-log :global(.agent-files .btn) { min-height: 44px; padding: 0 16px; font-size: 15px; border-radius: var(--r); }
  }
</style>
