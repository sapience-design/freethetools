---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { loadCatalogue, groupIn, toolIn, REPO, SUGGEST_URL } from "../data/catalogue";
import { LANGS, langOf, t, slots, jsStrings, localePath, splitPath } from "../i18n/index";
import originTrials from "../data/origin-trials.json";
import { version } from "../../package.json";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  category?: string;
  tool?: string;
  /** Last breadcrumb for a page under a group that is not a built tool, such as a wanted tool. */
  crumb?: string;
  page?: "home" | "about" | "how" | "ai" | "licenses" | "saved" | "library" | "stats";
  /** The language of the page. English unless a translated page says otherwise. */
  lang?: string;
}
const { title, description, jsonLd, noindex = false, category, tool, crumb, page, lang = "en" } = Astro.props;
const L = langOf(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const publisher = { "@type": "Organization", name: "Sapience Design", url: "https://sapience.design" };
const { aisles, tools, hasPage } = await loadCatalogue();
// The English address of this page, to find its twins in the other languages. A 404 page has none.
const is404 = /\/404\/?$/.test(Astro.url.pathname);
const enPath = is404 ? "/" : splitPath(Astro.url.pathname, LANGS.map((l) => l.code)).path;
const homeHref = localePath(lang, "/");
const alternates = is404 ? [] : LANGS.filter((l) => hasPage(l.code, enPath));
// Breadcrumbs for search engines: Free the Tools › group › tool, or Free the Tools › this page.
const home = new URL(homeHref, Astro.site).href;
const group = category ? aisles.find((a) => a.slug === category) : undefined;
const groupText = group ? groupIn(group, lang) : undefined;
const toolEntry = category && tool ? tools.find((x) => x.id === `${category}/${tool}`) : undefined;
const crumbs = page === "home" || enPath === "/" ? [] : [
  { name: "Free the Tools", url: home },
  ...(group ? [{ name: groupText!.label, url: new URL(localePath(lang, `/${group.slug}/`), Astro.site).href }] : []),
  ...(toolEntry ? [{ name: toolIn(toolEntry, lang).name, url: canonical }] : crumb ? [{ name: crumb, url: canonical }] : group ? [] : [{ name: title.split(" | ")[0], url: canonical }]),
];
const breadcrumbs = crumbs.length > 1 ? { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.url })) } : null;
// Share image, drawn at build time by src/pages/og/[...slug].png.ts (in English). Groups with no tools yet use the site's.
const ogPath = category && tool ? `/og/${category}/${tool}.png`
  : category && aisles.some((a) => a.slug === category && a.live.length) ? `/og/${category}.png`
  : "/og/site.png";
const ogImage = new URL(ogPath, Astro.site).href;
const themes = [["system", "monitor", t(lang, "foot.system")], ["light", "sun", t(lang, "foot.light")], ["dark", "moon", t(lang, "foot.dark")]];
const abs = (p: string) => new URL(p, Astro.site).href;
const hrefFor = (code: string) => localePath(code, hasPage(code, enPath) ? enPath : "/");
const uiJson = JSON.stringify(jsStrings(lang, "common")).replace(/</g, "\\u003c");
const slashParts = slots(t(lang, "foot.slash", { key: "{key}" }));
---
<!doctype html>
<html lang={lang} dir={L.dir}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Apply a saved Light/Dark choice before the first paint, so the page never flashes the wrong theme. -->
  <script is:inline>try{var t=localStorage.getItem("ftt:theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  <!-- Page-change animation. Chrome rejects it when a page the service worker does not control links to one it does (a console error, no harm), so a page opts in only once the worker controls it. Without a service worker it always opts in. -->
  <script is:inline>try{if(!("serviceWorker" in navigator)||navigator.serviceWorker.controller){var vt=new CSSStyleSheet();vt.replaceSync("@view-transition{navigation:auto}");document.adoptedStyleSheets=[vt]}}catch(e){}</script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {alternates.length > 1 && alternates.map((l) => <link rel="alternate" hreflang={l.code} href={abs(localePath(l.code, enPath))}>)}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={abs(enPath)}>}
  {noindex && <meta name="robots" content="noindex">}
  <meta name="author" content="Sapience Design">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Free the Tools">
  <meta property="og:locale" content={L.locale}>
  {alternates.length > 1 && alternates.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.locale}>)}
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title.replace(/ \| Free the Tools$/, "") + ", on Free the Tools"}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#fbf8f2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon-192.png">
  {originTrials.map((token) => <meta http-equiv="origin-trial" content={token}>)}
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="Free the Tools: what's new" href="/changelog.xml">
  <link rel="alternate" type="application/json" href="/api/tools.json" title="Tool catalogue (JSON)">
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", publisher, ...(jsonLd ?? { "@type": "WebPage", name: title, description, url: canonical }) })} />
  {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
</head>
<body>
  <a class="skip" href="#main">{t(lang, "skip")}</a>
  <header class="bar">
    <div class="bar-in">
    <a class="brand" href={homeHref}><span class="logo" aria-hidden="true"><Icon name="sparkle" /></span><span class="brand-name">Free the Tools</span></a>
    <nav class="bar-nav" aria-label={t(lang, "bar.nav")}>
      <a class="navlink with-ic" href="/library/" aria-current={page === "library" ? "page" : undefined}><Icon name="books" /><span class="bar-label">{t(lang, "bar.library")}</span></a>
      {page === "home"
        ? <a class="navlink with-ic" href="/saved/"><Icon name="heart" /><span class="bar-label">{t(lang, "bar.favourites")}</span><span class="count-pill" data-saved-count hidden>0</span></a>
        : <a class="navlink with-ic" href={`${homeHref}#find`}><Icon name="magnifying-glass" /><span class="bar-label">{t(lang, "bar.allTools")}</span></a>}
      <a class="navlink gh" href={REPO} aria-label={t(lang, "bar.github")} title={t(lang, "bar.github")}><Icon name="github-logo" /></a>
      <a class="donate-btn" href="https://ko-fi.com/freethetools"><Icon name="hand-heart" /><span class="donate-label">{t(lang, "bar.donate")}</span></a>
    </nav>
    </div>
  </header>

  {!L.reviewed && (
    <div class="review-note" role="note">
      <p>{t(lang, "review.note")} <a href="/suggest/?kind=problem">{t(lang, "review.report")}</a></p>
    </div>
  )}

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="foot">
    <div class="foot-in">
      <div class="colophon">
        <p class="foot-big">{t(lang, "foot.tagline")}</p>
        <a class="initiative" href="https://sapience.design"><img src="/brand/sapience-wordmark.webp" alt="Sapience Design" width="86" height="16"><span>{t(lang, "foot.initiative")}</span></a>
        <div class="theme" role="group" aria-label={t(lang, "foot.theme")}>
          {themes.map(([v, ic, label], i) => (
            <button type="button" data-theme-set={v} aria-pressed={i === 0 ? "true" : "false"}><Icon name={ic} />{label}</button>
          ))}
        </div>
        {LANGS.length > 1 && (
          <nav class="langs" aria-label={t(lang, "lang.label")}>
            <ul>
              {LANGS.map((l) => (
                <li><a href={hrefFor(l.code)} lang={l.code} hreflang={l.code} aria-current={l.code === lang ? "true" : undefined}>{l.name}</a></li>
              ))}
            </ul>
          </nav>
        )}
        <label class="slash-opt"><input type="checkbox" id="slash-key" checked> <span>{slashParts.map((p) => (typeof p === "string" ? p : <kbd>/</kbd>))}</span></label>
      </div>
      <div class="col">
        <p class="col-h">{t(lang, "foot.groups")}</p>
        <ul>{aisles.map((a) => <li><a href={localePath(lang, `/${a.slug}/`)}>{groupIn(a, lang).label}</a></li>)}</ul>
      </div>
      <div class="col">
        <p class="col-h">{t(lang, "foot.project")}</p>
        <ul>
          <li><a href="/about/">{t(lang, "foot.about")}</a></li>
          <li><a href="/changelog/">{t(lang, "foot.changelog")}</a></li>
          <li><a href="/saved/">{t(lang, "foot.favourites")}</a></li>
          <li><a href="/library/">{t(lang, "foot.library")}</a></li>
          <li><a href={SUGGEST_URL}>{t(lang, "foot.suggest")}</a></li>
          <li><a href="https://ko-fi.com/freethetools">{t(lang, "foot.donate")}</a></li>
          <li><a href="/support/#company-h">{t(lang, "foot.sponsor")}</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="col-h">{t(lang, "foot.trust")}</p>
        <ul>
          <li><a href="/how-it-works/">{t(lang, "foot.howItWorks")}</a></li>
          <li><a href="/verify/">{t(lang, "foot.verify")}</a></li>
          <li><a href="/stats/">{t(lang, "foot.stats")}</a></li>
          <li><a href="/privacy/">{t(lang, "foot.privacy")}</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="col-h">{t(lang, "foot.developers")}</p>
        <ul>
          <li><a href="/ai/">{t(lang, "foot.ai")}</a></li>
          <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>{t(lang, "foot.build")}</a></li>
          <li><a href={REPO}>{t(lang, "foot.source")}</a></li>
          <li><a href="/api/tools.json">{t(lang, "foot.api")}</a></li>
          <li><a href="/llms.txt">{t(lang, "foot.llms")}</a></li>
          <li><a href={`${REPO}/blob/main/openapi.yaml`}>{t(lang, "foot.openapi")}</a></li>
        </ul>
      </div>
      <div class="legal">
        <span>{t(lang, "foot.copyright", { year: new Date().getFullYear() })}</span>
        <span><a href="/licenses/">{t(lang, "foot.licences")}</a><a href={`${REPO}/blob/main/TRADEMARKS.md`}>{t(lang, "foot.trademarks")}</a><a href={`${REPO}/security/policy`}>{t(lang, "foot.security")}</a><a href={`/changelog/#v${version.replaceAll(".", "-")}`} id="site-version">{t(lang, "foot.version", { version })}</a></span>
      </div>
    </div>
  </footer>

  {/* Words the scripts need, in this page's language (src/lib/ui.ts reads them). */}
  <script type="application/json" id="ftt-ui" set:html={uiJson} />

  <script>
    import { trackVisit, isLiked, setLiked } from "../lib/stats";
    import { registerServiceWorker } from "../lib/offline";
    import { watchExternalLinks } from "../lib/external-links.js";
    import { txt } from "../lib/ui";
    trackVisit();
    registerServiceWorker();
    watchExternalLinks();

    // ---- Theme: System (follows the device), Light or Dark; remembered in this browser only ----
    const THEME = "ftt:theme";
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-set]")];
    function applyTheme(choice: string) {
      const root = document.documentElement;
      const fixed = choice === "light" || choice === "dark";
      if (fixed) root.dataset.theme = choice; else delete root.dataset.theme;
      themeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeSet === (fixed ? choice : "system"))));
    }
    let stored = "system";
    try { stored = localStorage.getItem(THEME) || "system"; } catch {}
    applyTheme(stored);
    themeButtons.forEach((b) => b.addEventListener("click", () => {
      const choice = b.dataset.themeSet!;
      try { choice === "system" ? localStorage.removeItem(THEME) : localStorage.setItem(THEME, choice); } catch {}
      applyTheme(choice);
    }));

    // Pills and option cards hide their radio inputs and show the label. When Tab reaches a hidden
    // input, bring its label into view: the browser would scroll to the input's own box instead.
    document.addEventListener("focusin", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement) || (t.type !== "radio" && t.type !== "checkbox")) return;
      if (getComputedStyle(t).opacity !== "0") return;
      t.labels?.[0]?.scrollIntoView({ block: "nearest", inline: "nearest" });
    });

    // "/" jumps to search from anywhere, unless the person turned it off in the footer (WCAG 2.1.4).
    // It is also ignored while typing in a field. The choice is remembered in this browser only.
    const SLASH = "ftt:slash";
    const slashBox = document.getElementById("slash-key") as HTMLInputElement | null;
    let slashOn = true;
    try { slashOn = localStorage.getItem(SLASH) !== "off"; } catch {}
    if (slashBox) {
      slashBox.checked = slashOn;
      slashBox.addEventListener("change", () => {
        slashOn = slashBox.checked;
        try { slashOn ? localStorage.removeItem(SLASH) : localStorage.setItem(SLASH, "off"); } catch {}
      });
    }
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (!slashOn || e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
      const find = document.getElementById("find") as HTMLInputElement | null;
      e.preventDefault();
      if (find) find.focus(); else location.href = `${document.querySelector(".brand")?.getAttribute("href") ?? "/"}#find`;
    });

    // Favourites live in this browser only (localStorage). The page works without it.
    const KEY = "ftt:saved";
    const read = (): Record<string, { name: string; href: string }> => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } };
    const write = (v: object) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
    function paint() {
      const saved = read();
      const n = Object.keys(saved).length;
      document.querySelectorAll<HTMLElement>("[data-saved-count]").forEach((el) => { el.textContent = String(n); el.hidden = n === 0; });
      document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((b) => b.setAttribute("aria-pressed", String(!!saved[b.dataset.save!])));
      document.dispatchEvent(new CustomEvent("saved-change", { detail: saved }));
    }
    document.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-save]");
      if (!b) return;
      const saved = read();
      const id = b.dataset.save!;
      const on = !saved[id];
      if (on) saved[id] = { name: b.dataset.name!, href: b.dataset.href! }; else delete saved[id];
      write(saved);
      paint();
      // A favourite is also a like, so the public count is how many people keep the tool. Send
      // only when the like differs from what this browser already sent, so it is never counted twice.
      if (isLiked(id) === on) return;
      setLiked(id, on).then((likes) => document.dispatchEvent(new CustomEvent("likes-change", { detail: { tool: id, likes } })));
    });
    paint();

    // "On this page": reading pages with three or more sections list them beside the text on wide
    // screens, and mark the one being read. Long lines are hard to read, so the text keeps its
    // width and the panel uses the space beside it. It starts below any wide part (a diagram).
    const reading = document.querySelector<HTMLElement>(".page.narrow");
    const heads = reading ? [...reading.querySelectorAll<HTMLElement>("h2[id]")] : [];
    if (reading && heads.length >= 3) {
      const nav = document.createElement("nav");
      nav.className = "toc-rail";
      nav.setAttribute("aria-label", txt("toc", "On this page"));
      const inner = document.createElement("div");
      inner.className = "toc";
      const title = document.createElement("p");
      title.className = "toc-h";
      title.textContent = txt("toc", "On this page");
      const list = document.createElement("ul");
      const links = heads.map((h) => {
        const a = document.createElement("a");
        a.href = `#${h.id}`;
        a.textContent = (h.textContent ?? "").replace(/\s+/g, " ").trim();
        const li = document.createElement("li");
        li.append(a);
        list.append(li);
        return a;
      });
      inner.append(title, list);
      nav.append(inner);
      reading.append(nav);
      const place = () => {
        const wide = [...reading.querySelectorAll<HTMLElement>(".wide")].pop();
        nav.style.top = wide ? `${wide.offsetTop + wide.offsetHeight + 24}px` : "";
      };
      new ResizeObserver(place).observe(reading);
      // The section being read: the last heading above the top fifth of the window, or the last
      // section at the bottom of the page (it may never reach the top). A clicked one counts at once.
      let queued = false, picked = -1;
      const show = (at: number) => links.forEach((a, i) => (i === at ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current")));
      const mark = () => {
        queued = false;
        let at = 0;
        heads.forEach((h, i) => { if (h.getBoundingClientRect().top < innerHeight / 5) at = i; });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) at = Math.max(at, picked >= 0 ? picked : heads.length - 1);
        show(at);
      };
      links.forEach((a, i) => a.addEventListener("click", () => { picked = i; show(i); }));
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
      addEventListener("wheel", () => { picked = -1; }, { passive: true });
      mark();
    }
  </script>
</body>
</html>

<style>
  .bar {
    position: sticky; top: 0; z-index: 30;
    padding: 10px var(--gutter); background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--hair);
  }
  .bar-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; max-width: var(--content); margin: 0 auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-family: var(--display); font-weight: 700; font-size: 17px; text-decoration: none; white-space: nowrap; }
  .logo { display: grid; place-items: center; width: 32px; height: 32px; border: 1.5px solid #1d1b16; border-radius: 10px; background: #ffe27a; color: #1d1b16; box-shadow: 0 3px 0 #1d1b16; font-size: 18px; }
  .bar-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px; margin-left: auto; }
  .navlink { display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; border-radius: var(--r); font-weight: 650; text-decoration: none; white-space: nowrap; }
  .navlink:hover, .navlink[aria-current="page"] { background: var(--hover); }
  .navlink.with-ic { gap: 6px; position: relative; }
  .navlink.with-ic :global(.ic) { font-size: 20px; }
  .navlink .count-pill { font-size: 12px; padding: 0 8px; }
  /* Donate (styled in global.css): the one highlighted button, last in the bar, as most sites place their main action. */
  .bar-nav .donate-btn { margin-left: 4px; }
  @media (max-width: 560px) {
    .bar-nav .donate-btn { width: 48px; min-height: 48px; padding: 0; justify-content: center; margin-left: 0; }
    .donate-label, .navlink.with-ic .bar-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .navlink.with-ic { width: 48px; padding: 0; justify-content: center; gap: 0; }
    .navlink.with-ic .count-pill { position: absolute; transform: translate(14px, -14px); }
  }
  .navlink.gh { width: 48px; padding: 0; justify-content: center; font-size: 22px; }
  /* On phones the top bar has no room for it; the footer's "Source code" link stays. */
  @media (max-width: 560px) { .navlink.gh { display: none; } }
  .bar-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 12px; border: 1px solid var(--hair); font-size: 15px; border-radius: var(--r); background: var(--card); font-weight: 650; text-decoration: none; white-space: nowrap; }
  .bar-btn:hover { border-color: var(--edge); }
  .bar-btn :global(.ic) { font-size: 18px; }
  .bar-btn .count-pill { font-size: 12px; padding: 0 8px; }

  .foot { border-top: 1px solid var(--hair); background: var(--bg); }
  .foot-in {
    max-width: calc(var(--content) + 2 * var(--gutter)); margin: 0 auto; padding: 48px var(--gutter) 32px; display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(4, minmax(0, 1fr)); gap: 40px 32px; color: var(--soft);
  }
  .foot a { color: inherit; text-decoration: none; }
  .foot a:hover { color: var(--ink); text-decoration: underline; }
  .col-h { font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 15px; }
  .foot li a { display: inline-block; padding: 2px 0; }
  .colophon { display: grid; gap: 16px; align-content: start; justify-items: start; }
  .foot-big { font-family: var(--display); font-weight: 700; font-size: 24px; line-height: 1.15; letter-spacing: -0.01em; color: var(--ink); max-width: 16ch; }
  .initiative { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; min-height: 32px; }
  .initiative img { height: 15px; width: auto; filter: var(--logo-filter); opacity: .85; }
  .theme { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 12px; background: var(--well); }
  .theme button { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border: 0; border-radius: 9px; background: transparent; color: var(--soft); font-size: 14px; font-weight: 600; cursor: pointer; }
  .slash-opt { display: flex; align-items: center; gap: 10px; margin-top: 14px; min-height: 40px; font-size: 14px; cursor: pointer; }
  .slash-opt input { width: 20px; height: 20px; accent-color: var(--ink); }
  .slash-opt kbd { font: inherit; font-weight: 700; padding: 0 6px; border: 1px solid var(--hair); border-radius: 5px; background: var(--well); }
  .theme button:hover { color: var(--ink); }
