---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { loadCatalogue, REPO, REQUEST_URL } from "../data/catalogue";
import originTrials from "../data/origin-trials.json";
import { version } from "../../package.json";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  category?: string;
  tool?: string;
  page?: "home" | "about" | "licenses" | "saved" | "library" | "stats";
}
const { title, description, jsonLd, noindex = false, category, tool, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const publisher = { "@type": "Organization", name: "Sapience Design", url: "https://sapience.design" };
const { aisles } = await loadCatalogue();
// Share image, drawn at build time by src/pages/og/[...slug].png.ts. Groups with no tools yet use the site's.
const ogPath = category && tool ? `/og/${category}/${tool}.png`
  : category && aisles.some((a) => a.slug === category && a.live.length) ? `/og/${category}.png`
  : "/og/site.png";
const ogImage = new URL(ogPath, Astro.site).href;
const themes = [["system", "monitor", "System"], ["light", "sun", "Light"], ["dark", "moon", "Dark"]];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Apply a saved Light/Dark choice before the first paint, so the page never flashes the wrong theme. -->
  <script is:inline>try{var t=localStorage.getItem("ftt:theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="author" content="Sapience Design">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Free the Tools">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title.replace(/ \| Free the Tools$/, "") + ", on Free the Tools"}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#fbf8f2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon-192.png">
  {originTrials.map((token) => <meta http-equiv="origin-trial" content={token}>)}
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/json" href="/api/tools.json" title="Tool catalogue (JSON)">
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", publisher, ...(jsonLd ?? { "@type": "WebPage", name: title, description, url: canonical }) })} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar">
    <div class="bar-in">
    <a class="brand" href="/"><span class="logo" aria-hidden="true"><Icon name="sparkle" /></span><span class="brand-name">Free the Tools</span></a>
    <nav class="bar-nav" aria-label="Site">
      <a class="navlink" href="/about/" aria-current={page === "about" ? "page" : undefined}>About</a>
      <a class="navlink" href="/library/" aria-current={page === "library" ? "page" : undefined}>Library</a>
      {page === "home"
        ? <a class="bar-btn" href="/saved/"><Icon name="bookmark-simple" /><span class="bar-label">Saved</span><span class="count-pill" data-saved-count hidden>0</span></a>
        : <a class="bar-btn" href="/#find"><Icon name="magnifying-glass" /><span class="bar-label">All tools</span></a>}
    </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="foot">
    <div class="foot-in">
      <div class="colophon">
        <p class="foot-big">Useful tools that stay on your device.</p>
        <a class="initiative" href="https://sapience.design"><img src="/brand/sapience-wordmark.webp" alt="Sapience" width="86" height="16"><span>A Sapience initiative</span></a>
        <div class="theme" role="group" aria-label="Theme">
          {themes.map(([v, ic, label], i) => (
            <button type="button" data-theme-set={v} aria-pressed={i === 0 ? "true" : "false"}><Icon name={ic} />{label}</button>
          ))}
        </div>
      </div>
      <div class="col">
        <p class="col-h">Groups</p>
        <ul>{aisles.map((a) => <li><a href={`/${a.slug}/`}>{a.label}</a></li>)}</ul>
      </div>
      <div class="col">
        <p class="col-h">Project</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/saved/">Saved tools</a></li>
          <li><a href="/library/">Library</a></li>
          <li><a href="/stats/">Usage stats</a></li>
          <li><a href={REQUEST_URL}>Suggest a tool</a></li>
          <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Build a tool</a></li>
          <li><a href="/support/">Support the project</a></li>
          <li><a href={REPO}>Source code</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="col-h">Developers</p>
        <ul>
          <li><a href="/api/tools.json">API</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href={`${REPO}/blob/main/openapi.yaml`}>OpenAPI</a></li>
        </ul>
      </div>
      <div class="legal">
        <span>© {new Date().getFullYear()} Sapience Design and contributors</span>
        <span><a href="/licenses/">Licences</a><a href={`${REPO}/blob/main/TRADEMARKS.md`}>Trademarks</a><a href={`${REPO}/security/policy`}>Security</a><a href={`${REPO}/releases/tag/v${version}`} id="site-version">Version {version}</a></span>
      </div>
    </div>
  </footer>

  <script>
    import { trackVisit } from "../lib/stats";
    trackVisit();

    // ---- Theme: System (follows the device), Light or Dark; remembered in this browser only ----
    const THEME = "ftt:theme";
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-set]")];
    function applyTheme(choice: string) {
      const root = document.documentElement;
      const fixed = choice === "light" || choice === "dark";
      if (fixed) root.dataset.theme = choice; else delete root.dataset.theme;
      themeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeSet === (fixed ? choice : "system"))));
    }
    let stored = "system";
    try { stored = localStorage.getItem(THEME) || "system"; } catch {}
    applyTheme(stored);
    themeButtons.forEach((b) => b.addEventListener("click", () => {
      const choice = b.dataset.themeSet!;
      try { choice === "system" ? localStorage.removeItem(THEME) : localStorage.setItem(THEME, choice); } catch {}
      applyTheme(choice);
    }));

    // Pills and option cards hide their radio inputs and show the label. When Tab reaches a hidden
    // input, bring its label into view: the browser would scroll to the input's own box instead.
    document.addEventListener("focusin", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement) || (t.type !== "radio" && t.type !== "checkbox")) return;
      if (getComputedStyle(t).opacity !== "0") return;
      t.labels?.[0]?.scrollIntoView({ block: "nearest", inline: "nearest" });
    });

    // "/" jumps to search from anywhere.
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
      const find = document.getElementById("find") as HTMLInputElement | null;
      e.preventDefault();
      if (find) find.focus(); else location.href = "/#find";
    });

    // Saved tools live in this browser only (localStorage). The page works without it.
    const KEY = "ftt:saved";
    const read = (): Record<string, { name: string; href: string }> => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } };
    const write = (v: object) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
    function paint() {
      const saved = read();
      const n = Object.keys(saved).length;
      document.querySelectorAll<HTMLElement>("[data-saved-count]").forEach((el) => { el.textContent = String(n); el.hidden = n === 0; });
      document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((b) => b.setAttribute("aria-pressed", String(!!saved[b.dataset.save!])));
      document.dispatchEvent(new CustomEvent("saved-change", { detail: saved }));
    }
    document.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-save]");
      if (!b) return;
      const saved = read();
      const id = b.dataset.save!;
      if (saved[id]) delete saved[id]; else saved[id] = { name: b.dataset.name!, href: b.dataset.href! };
      write(saved);
      paint();
    });
    paint();
  </script>
</body>
</html>

<style>
  .bar {
    position: sticky; top: 0; z-index: 30;
    padding: 10px var(--gutter); background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--hair);
  }
  .bar-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; max-width: var(--content); margin: 0 auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-family: var(--display); font-weight: 700; font-size: 17px; text-decoration: none; white-space: nowrap; }
  .logo { display: grid; place-items: center; width: 32px; height: 32px; border: 1.5px solid #1d1b16; border-radius: 10px; background: #ffe27a; color: #1d1b16; box-shadow: 0 3px 0 #1d1b16; font-size: 18px; }
  .bar-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px; margin-left: auto; }
  .navlink { display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; border-radius: var(--r); font-weight: 650; text-decoration: none; white-space: nowrap; }
  .navlink:hover, .navlink[aria-current="page"] { background: var(--hover); }
  .bar-btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 14px; border: 1.5px solid var(--hair); border-radius: var(--r); background: var(--card); font-weight: 650; text-decoration: none; white-space: nowrap; }
  .bar-btn:hover { border-color: var(--edge); }
  .bar-btn :global(.ic) { font-size: 20px; }
  .bar-btn .count-pill { font-size: 12px; padding: 0 8px; }

  .foot { border-top: 1px solid var(--hair); background: var(--bg); }
  .foot-in {
    max-width: calc(var(--content) + 2 * var(--gutter)); margin: 0 auto; padding: 48px var(--gutter) 32px; display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: 40px 32px; color: var(--soft);
  }
  .foot a { color: inherit; text-decoration: none; }
  .foot a:hover { color: var(--ink); text-decoration: underline; }
  .col-h { font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 15px; }
  .foot li a { display: inline-block; padding: 2px 0; }
  .colophon { display: grid; gap: 16px; align-content: start; justify-items: start; }
  .foot-big { font-family: var(--display); font-weight: 700; font-size: 24px; line-height: 1.15; letter-spacing: -0.01em; color: var(--ink); max-width: 16ch; }
  .initiative { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; min-height: 32px; }
  .initiative img { height: 15px; width: auto; filter: var(--logo-filter); opacity: .85; }
  .theme { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 12px; background: var(--well); }
  .theme button { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border: 0; border-radius: 9px; background: transparent; color: var(--soft); font-size: 14px; font-weight: 600; cursor: pointer; }
  .theme button:hover { color: var(--ink); }
  .theme button[aria-pressed="true"] { background: var(--card); color: var(--ink); box-shadow: 0 1px 2px rgba(0, 0, 0, .12); }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 20px; border-top: 1px solid var(--hair); font-size: 14px; }
  .legal span:last-child { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  @media (max-width: 860px) {
    .foot-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .colophon { grid-column: 1 / -1; }
  }
  /* Phones: the two buttons show their icon only (the words stay for screen readers), so About,
     Library, the button and the name all fit; on the narrowest screens the name hides the same way. */
  @media (max-width: 560px) {
    .bar-btn { width: 48px; padding: 0; justify-content: center; gap: 0; }
    .bar-btn .bar-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .bar-btn .count-pill { position: absolute; transform: translate(14px, -14px); }
    .bar-btn { position: relative; }
  }
  @media (max-width: 350px) {
    .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 520px) {
    .bar-in { gap: 6px; }
    .brand { gap: 8px; font-size: 16px; }
    .navlink { padding: 0 8px; }
    .foot-in { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
