---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { loadCatalogue, REPO } from "../data/catalogue";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  category?: string;
  tool?: string;
  page?: "home" | "about" | "licenses" | "saved";
}
const { title, description, jsonLd, noindex = false, category, tool, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const publisher = { "@type": "Organization", name: "Sapience Design", url: "https://sapience.design" };
const { aisles } = await loadCatalogue();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="author" content="Sapience Design">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Free the Tools">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/json" href="/api/tools.json" title="Tool catalogue (JSON)">
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", publisher, ...(jsonLd ?? { "@type": "WebPage", name: title, description, url: canonical }) })} />
</head>
<body>
  <div class="shell">
    <Sidebar category={category} tool={tool} page={page} />
    <div class="main">
      <div class="mobilebar">
        <a class="mw" href="/">Free <i>the</i> Tools</a>
        <button id="menu" type="button">Menu</button>
      </div>
      <main>
        <slot />
      </main>
    </div>
  </div>

  <footer class="foot">
    <div class="foot-in">
      <div class="colophon">
        <p class="big">Useful tools that stay on your device.</p>
        <a class="initiative" href="https://sapience.design"><img src="/brand/sapience-wordmark.webp" alt="Sapience" width="86" height="16"><span>A Sapience initiative</span></a>
      </div>
      <div class="col">
        <p class="eyebrow">Groups</p>
        <ul>{aisles.map((a) => <li><a href={`/${a.slug}/`}>{a.name}</a></li>)}</ul>
      </div>
      <div class="col">
        <p class="eyebrow">Project</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contribute</a></li>
          <li><a href={REPO}>Source code</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="eyebrow">Developers</p>
        <ul>
          <li><a href="/api/tools.json">API</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href={`${REPO}/blob/main/openapi.yaml`}>OpenAPI</a></li>
        </ul>
      </div>
      <div class="legal">
        <span>© {new Date().getFullYear()} Sapience Design and contributors</span>
        <span><a href="/licenses/">Licences</a><a href={`${REPO}/blob/main/TRADEMARKS.md`}>Trademarks</a><a href={`${REPO}/security/policy`}>Security</a></span>
      </div>
    </div>
  </footer>

  <script>
    // Saved tools live in this browser only (localStorage). The page works without it.
    const KEY = "ftt:saved";
    const read = (): Record<string, { name: string; href: string }> => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } };
    const write = (v: object) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
    function paint() {
      const saved = read();
      document.querySelectorAll<HTMLElement>("[data-saved-count]").forEach((el) => (el.textContent = String(Object.keys(saved).length)));
      document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((b) => b.setAttribute("aria-pressed", String(!!saved[b.dataset.save!])));
      document.dispatchEvent(new CustomEvent("saved-change", { detail: saved }));
    }
    document.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-save]");
      if (!b) return;
      const saved = read();
      const id = b.dataset.save!;
      if (saved[id]) delete saved[id]; else saved[id] = { name: b.dataset.name!, href: b.dataset.href! };
      write(saved);
      paint();
    });
    paint();
  </script>
</body>
</html>

<style>
  .mobilebar { display: none; }
  .foot { background: var(--foot); color: #9a9fa6; }
  .foot-in { max-width: 1480px; margin: 0 auto; padding: var(--s7) clamp(var(--s2), 4vw, var(--s5)) var(--s4); display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: var(--s5) var(--s4); }
  .foot a { color: inherit; text-decoration: none; transition: color .15s; }
  .foot a:hover { color: #fff; }
  .foot .eyebrow { color: #6d727a; margin-bottom: var(--s2); }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: var(--t-sm); line-height: var(--lh-sm-ui); }
  .colophon { display: grid; gap: var(--s4); align-content: start; }
  .big { font-family: var(--serif); font-size: var(--t-3xl); line-height: var(--lh-3xl); font-weight: 400; color: #fff; max-width: 18ch; }
  .initiative { display: inline-flex; align-items: center; gap: 12px; font-size: var(--t-xs); }
  .initiative img { height: 16px; width: auto; filter: invert(1); opacity: .85; }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s1) var(--s3); padding-top: var(--s3); border-top: 1px solid #22252a; font-size: var(--t-xs); color: #6d727a; }
  .legal span:last-child { display: flex; gap: var(--s3); }
  @media (max-width: 960px) {
    .mobilebar { display: flex; justify-content: space-between; align-items: center; padding: var(--s2) 0 var(--s3); }
    .mw { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: var(--t-base); line-height: var(--lh-base); text-decoration: none; }
    .mw::before { content: ""; width: 22px; height: 22px; border-radius: 6px; background: var(--ink); box-shadow: inset 0 -8px 0 -5px var(--accent); }
    .mw i { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 17px; }
    #menu { border: 0; background: none; font: inherit; font-size: var(--t-sm); color: var(--ink); cursor: pointer; padding: var(--s1) 0; }
    .foot-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .colophon { grid-column: 1 / -1; }
  }
</style>
