// Cloudflare Workers static assets: serves dist/ as plain files. There is no Worker code,
// so nothing runs on the server and requests to static assets are free and unmetered.
// _headers in dist/ (from public/_headers) sets the security headers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freethetools",
  "compatibility_date": "2026-09-26",
  // Preview URLs let pull requests from this repo get their own link. Canonical tags keep
  // search engines on freethetools.com.
  "workers_dev": true,
  "preview_urls": true,
  // Cloudflare Workers Builds runs "wrangler preview" for branches other than main.
  // It needs this block; everything else (assets, domains) stays at the top level.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "freethetools.com", "custom_domain": true },
    { "pattern": "www.freethetools.com", "custom_domain": true }
  ]
}
