---
// Split PDF: every page as its own file, or custom ranges.
import DropZone from "../../../src/components/DropZone.astro";
---
<section class="tool" aria-label="Split PDF">
  <DropZone prefix="pdfs" toolId="pdf/split" category="pdf" name="Split PDF" accept="application/pdf,.pdf" title="Drop a PDF here" pick="Choose a PDF" />

  <div id="pdfs-panel" hidden class="tool">
    <ul class="file-list"><li><span class="fname" id="pdfs-name"></span><span class="fmeta" id="pdfs-meta"></span></li></ul>
    <fieldset class="field">
      <legend class="eyebrow">Split into</legend>
      <div class="seg">
        <input type="radio" name="pdfs-mode" id="pdfs-each" value="each" checked><label for="pdfs-each">Every page<small>one file per page</small></label>
        <input type="radio" name="pdfs-mode" id="pdfs-ranges" value="ranges"><label for="pdfs-ranges">Custom ranges<small>e.g. 1-3, 5, 8-</small></label>
      </div>
    </fieldset>
    <label class="field" id="pdfs-range-field" hidden><span>Pages</span><input type="text" id="pdfs-range" placeholder="1-3, 5, 8-" autocomplete="off"></label>
    <div class="actions"><button class="btn" id="pdfs-go" type="button">Split PDF</button></div>
  </div>
  <div id="pdfs-result" aria-live="polite"></div>
</section>

<script>
  import { parseRanges, everyPage, splitPdf } from "./core.js";
  import { pageCount } from "../merge/core.js";
  import { wireDrop, fmtBytes, downloadLink, showError, baseName } from "../../../src/lib/files";

  let file: File | null = null, bytes: ArrayBuffer | null = null, total = 0;
  const $ = (id: string) => document.getElementById(id)!;
  const rangeField = $("pdfs-range-field"), result = $("pdfs-result");

  document.querySelectorAll<HTMLInputElement>('input[name="pdfs-mode"]').forEach((r) =>
    r.addEventListener("change", () => { rangeField.hidden = r.value !== "ranges" || !r.checked; if (!rangeField.hidden) ($("pdfs-range") as HTMLInputElement).focus(); }));

  wireDrop("pdfs", async (files) => {
    const f = files.find((x) => /\.pdf$/i.test(x.name) || x.type === "application/pdf");
    if (!f) return;
    result.replaceChildren();
    try {
      bytes = await f.arrayBuffer();
      total = await pageCount(bytes.slice(0));
      file = f;
      $("pdfs-name").textContent = f.name;
      $("pdfs-meta").textContent = `${total} ${total === 1 ? "page" : "pages"} · ${fmtBytes(f.size)}`;
      $("pdfs-panel").hidden = false;
    } catch (e) { showError(result, (e as Error).message); }
  });

  $("pdfs-go").addEventListener("click", async () => {
    if (!bytes || !file) return;
    const mode = (document.querySelector('input[name="pdfs-mode"]:checked') as HTMLInputElement).value;
    try {
      const ranges = mode === "each" ? everyPage(total) : parseRanges(($("pdfs-range") as HTMLInputElement).value, total);
      const parts = await splitPdf(bytes.slice(0), ranges);
      const ul = document.createElement("ul"); ul.className = "file-list";
      for (const p of parts) {
        const label = p.range[0] === p.range[1] ? `page ${p.range[0]}` : `pages ${p.range[0]}-${p.range[1]}`;
        const fname = `${baseName(file.name)}_${label.replace(/\s/g, "-")}.pdf`;
        const li = document.createElement("li");
        const n = document.createElement("span"); n.className = "fname"; n.textContent = fname;
        const m = document.createElement("span"); m.className = "fmeta"; m.textContent = `${label} · ${fmtBytes(p.bytes.byteLength)}`;
        const a = document.createElement("span"); a.className = "fact"; a.append(downloadLink(p.bytes, fname, "application/pdf"));
        li.append(n, m, a); ul.append(li);
      }
      result.replaceChildren(ul);
    } catch (e) { showError(result, (e as Error).message); }
  });
</script>
