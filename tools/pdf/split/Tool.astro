---
// Split PDF: every page as its own file, or the pages you pick.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="pdfs-tool" aria-label="Split PDF">
  <Step n={1} title="Choose your PDF">
    <DropZone prefix="pdfs" toolId="pdf/split" category="pdf" name="Split PDF" accept="application/pdf,.pdf" title="Drop your PDF here" hint="From your computer, phone or a USB stick" button="Choose PDF" />
    <ul class="file-list" id="pdfs-picked" hidden>
      <li class="has-thumb">
        <span class="fthumb" id="pdfs-thumb"><Icon name="file-pdf" weight="duotone" /></span>
        <span class="finfo"><span class="fname" id="pdfs-name"></span><span class="fmeta" id="pdfs-meta"></span></span>
        <span class="fact"><button class="btn quiet small" id="pdfs-change" type="button">Change</button></span>
      </li>
    </ul>
  </Step>

  <Step n={2} title="How should we split it?" state="later">
    <fieldset class="choices cols">
      <legend class="sr-only">Split into</legend>
      <div class="choice"><input type="radio" name="pdfs-mode" id="pdfs-each" value="each" checked><label for="pdfs-each"><b>Every page on its own</b><small>One file per page</small></label></div>
      <div class="choice"><input type="radio" name="pdfs-mode" id="pdfs-ranges" value="ranges"><label for="pdfs-ranges"><b>Pick the pages</b><small>Type pages or ranges below</small></label></div>
    </fieldset>
    <label class="field" id="pdfs-range-field" hidden>
      <span>Pages to take out</span>
      <input type="text" id="pdfs-range" placeholder="1-3, 5, 8-" autocomplete="off">
      <small>Use a dash for a range and commas between pages, like 1-3, 7.</small>
    </label>
    <div class="field" id="pdfs-preview" hidden>
      <span class="field-label" id="pdfs-preview-label">The pages you'll get</span>
      <div id="pdfs-pages"></div>
    </div>
    <button class="btn run" id="pdfs-go" type="button" disabled><Icon name="scissors" /><span>Split PDF</span></button>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="pdfs-result" aria-live="polite"><p class="res-wait">Your new files will appear here.</p></div>
    <ul class="file-list" id="pdfs-files"></ul>
  </Step>
</section>

<script>
  import { parseRanges, everyPage, splitPdf } from "./core.js";
  import { wireDrop, fmtBytes, downloadLink, downloadAllButton, showError, showBusy, showDone, showWait, compactDrop, baseName, paint, progress, working, fileRow, pdfThumb } from "../../../src/lib/files";
  import { pdfFacts, pdfMeta } from "../../../src/lib/pdfinfo";
  import { usePdfWorker, pdfPreview, pageStrip, type PageTile } from "../../../src/lib/pdfthumb";
  import { stepTo } from "../../../src/lib/steps";
  import { pagesFromRanges } from "../rotate/core.js";
  import { withUnlocked } from "../../../src/lib/pdfpassword";
  usePdfWorker("pdf/split");

  let file: File | null = null, bytes: ArrayBuffer | null = null, total = 0;
  let tiles: PageTile[] = [];
  const $ = (id: string) => document.getElementById(id)!;
  const root = $("pdfs-tool"), rangeField = $("pdfs-range-field"), result = $("pdfs-result"), files = $("pdfs-files");
  const go = $("pdfs-go") as HTMLButtonElement, picked = $("pdfs-picked");
  const WAIT = "Your new files will appear here.";
  const modeChosen = () => (document.querySelector('input[name="pdfs-mode"]:checked') as HTMLInputElement).value;

  // The page pictures show which pages the split will take: all of them, or the ones typed.
  function preview() {
    if (!tiles.length) return;
    let chosen: Set<number> | null = null;
    if (modeChosen() === "ranges") {
      try { chosen = new Set(pagesFromRanges(parseRanges(($("pdfs-range") as HTMLInputElement).value, total))); } catch { chosen = new Set(); }
    }
    for (const t of tiles) {
      const on = !chosen || chosen.has(t.n);
      t.tile.classList.toggle("pick", on);
      t.tile.classList.toggle("dim", !on);
    }
    $("pdfs-preview-label").textContent = chosen ? (chosen.size ? `The ${chosen.size === 1 ? "page" : "pages"} you'll get` : "Type the pages you want") : "Every page becomes its own file";
  }

  document.querySelectorAll<HTMLInputElement>('input[name="pdfs-mode"]').forEach((r) =>
    r.addEventListener("change", () => { rangeField.hidden = r.value !== "ranges" || !r.checked; if (!rangeField.hidden) ($("pdfs-range") as HTMLInputElement).focus(); preview(); }));
  $("pdfs-range").addEventListener("input", preview);

  $("pdfs-change").addEventListener("click", () => $("pdfs-file").click());

  wireDrop("pdfs", async (picks) => {
    const picked0 = picks.find((x) => /\.pdf$/i.test(x.name) || x.type === "application/pdf");
    if (!picked0) return;
    await withUnlocked(picked0, $("pdfs-drop"), use);
  });

  async function use(f: File) {
    showWait(result, WAIT);
    files.replaceChildren();
    // Show the file straight away, with a spinner, and let the page draw it before reading:
    // a large PDF takes a while, and without this the page looks frozen.
    file = null;
    bytes = null;
    go.disabled = true;
    $("pdfs-name").textContent = f.name;
    working($("pdfs-meta"), `Reading ${fmtBytes(f.size)}…`);
    picked.hidden = false;
    compactDrop("pdfs", true);
    await paint();
    try {
      // One read gives the page count and the details line.
      const facts = await pdfFacts(f);
      if (!facts) throw new Error("This file isn't a readable PDF.");
      if (facts.locked) throw new Error("This PDF is password-protected. Open Unlock PDF to take the lock off first.");
      bytes = await f.arrayBuffer();
      total = facts.pages;
      file = f;
      $("pdfs-meta").textContent = pdfMeta(facts, f.size);
      pdfPreview($("pdfs-thumb"), f, f.name, total);
      const strip = pageStrip(f, total);
      tiles = strip.tiles;
      $("pdfs-pages").replaceChildren(strip.el);
      $("pdfs-preview").hidden = false;
      preview();
      go.disabled = false;
      stepTo(root, 2);
    } catch (e) {
      $("pdfs-meta").textContent = fmtBytes(f.size);
      showError(result, (e as Error).message);
    }
  }

  go.addEventListener("click", async () => {
    if (!bytes || !file) return;
    const mode = (document.querySelector('input[name="pdfs-mode"]:checked') as HTMLInputElement).value;
    go.disabled = true;
    files.replaceChildren();
    stepTo(root, 3);
    await showBusy(result, total > 50 ? "A large PDF can take a minute. Please keep this page open." : undefined);
    const show = progress(result);
    try {
      const ranges = mode === "each" ? everyPage(total) : parseRanges(($("pdfs-range") as HTMLInputElement).value, total);
      await show(`Reading ${total} ${total === 1 ? "page" : "pages"}…`, true);
      const parts = await splitPdf(bytes.slice(0), ranges, (done, n) => show(`Making file ${done} of ${n}`));
      const rows: HTMLElement[] = [];
      const made: { name: string; blob: Blob }[] = [];
      for (const p of parts) {
        const label = p.range[0] === p.range[1] ? `page ${p.range[0]}` : `pages ${p.range[0]}-${p.range[1]}`;
        const fname = `${baseName(file.name)}_${label.replace(/\s/g, "-")}.pdf`;
        const blob = new Blob([p.bytes], { type: "application/pdf" });
        const li = fileRow({ name: fname, meta: `${label} · ${fmtBytes(p.bytes.byteLength)}`, thumb: pdfPreview(pdfThumb(), blob, fname), actions: [downloadLink(p.bytes, fname, "application/pdf")] });
        rows.push(li);
        made.push({ name: fname, blob });
      }
      const all = downloadAllButton(() => made, `${baseName(file.name)}-pages.zip`);
      showDone(result, `Done. ${parts.length} new ${parts.length === 1 ? "PDF" : "PDFs"}.`, ...(all ? [all] : []));
      files.replaceChildren(...rows);
      stepTo(root, 4);
    } catch (e) { showError(result, (e as Error).message); }
    go.disabled = false;
  });

  // Changing anything in step 2 makes an earlier result out of date.
  root.querySelector('.step[data-step="2"]')!.addEventListener("input", () => {
    if (!result.querySelector(".res-done, .res-bad")) return;
    files.replaceChildren();
    showWait(result, WAIT);
    stepTo(root, 2);
  });
</script>
