---
// PDF to images: pick a picture type, a sharpness and the pages; each page becomes a picture.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
import { RESOLUTIONS } from "./core.js";
---
<section class="tool" id="p2i-tool" aria-label="PDF to images">
  <Step n={1} title="Choose your PDF">
    <DropZone prefix="p2i" toolId="pdf/to-images" category="pdf" name="PDF to Images" accept="application/pdf,.pdf" title="Drop your PDF here" hint="From your computer, phone or a USB stick" button="Choose PDF" />
    <ul class="file-list" id="p2i-picked" hidden>
      <li class="has-thumb">
        <span class="fthumb" id="p2i-thumb"><Icon name="file-pdf" weight="duotone" /></span>
        <span class="finfo"><span class="fname" id="p2i-name"></span><span class="fmeta" id="p2i-meta"></span></span>
        <span class="fact"><button class="btn quiet small" id="p2i-change" type="button">Change</button></span>
      </li>
    </ul>
  </Step>

  <Step n={2} title="Pick a picture type" state="later">
    <fieldset class="choices cols">
      <legend class="sr-only">Picture type</legend>
      <div class="choice"><input type="radio" name="p2i-fmt" id="p2i-png" value="png" checked><label for="p2i-png"><b>PNG</b><small>Sharp, good for text</small><span class="badge rec">Recommended</span></label></div>
      <div class="choice"><input type="radio" name="p2i-fmt" id="p2i-jpg" value="jpg"><label for="p2i-jpg"><b>JPG</b><small>Smaller files, good for photos</small></label></div>
    </fieldset>
    <fieldset class="field">
      <legend>Sharpness</legend>
      <div class="seg">
        {RESOLUTIONS.map((r, i) => (<><input type="radio" name="p2i-dpi" id={`p2i-${r.dpi}`} value={r.dpi} checked={i === 1} /><label for={`p2i-${r.dpi}`}>{r.label}<small>{r.dpi} dpi</small></label></>))}
      </div>
    </fieldset>
    <label class="field">
      <span>Pages (leave empty for all)</span>
      <input type="text" id="p2i-range" placeholder="e.g. 1-3, 5" autocomplete="off">
      <small>Use a dash for a range and commas between pages, like 1-3, 5.</small>
    </label>
    <button class="btn run" id="p2i-go" type="button" disabled><Icon name="images" /><span>Save as pictures</span></button>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="p2i-result" aria-live="polite"><p class="res-wait">Your pictures will appear here.</p></div>
    <ul class="file-list" id="p2i-files"></ul>
  </Step>
</section>

<script>
  import * as pdfjs from "pdfjs-dist";
  import { safeScale, pageFileName } from "./core.js";
  import { parseRanges, everyPage } from "../split/core.js";
  import { pagesFromRanges } from "../rotate/core.js";
  import { wireDrop, fmtBytes, downloadLink, downloadAllButton, baseName, showError, showBusy, showDone, showWait, compactDrop } from "../../../src/lib/files";
  import { paperName } from "../../../src/lib/paper.js";
  import { stepTo } from "../../../src/lib/steps";

  // The worker is served from this site (see "vendor" in tool.json), never from a CDN.
  pdfjs.GlobalWorkerOptions.workerSrc = "/pdf/to-images/vendor/pdf.worker.min.mjs";
  const $ = (id: string) => document.getElementById(id)!;
  const root = $("p2i-tool"), result = $("p2i-result"), files = $("p2i-files"), go = $("p2i-go") as HTMLButtonElement;
  const WAIT = "Your pictures will appear here.";
  let doc: pdfjs.PDFDocumentProxy | null = null, file: File | null = null;

  $("p2i-change").addEventListener("click", () => $("p2i-file").click());

  wireDrop("p2i", async (picks) => {
    const f = picks.find((x) => /\.pdf$/i.test(x.name) || x.type === "application/pdf");
    if (!f) return;
    showWait(result, WAIT);
    files.replaceChildren();
    try {
      doc = await pdfjs.getDocument({ data: new Uint8Array(await f.arrayBuffer()), isEvalSupported: false, useSystemFonts: true }).promise;
      file = f;
      $("p2i-name").textContent = f.name;
      // Page 1 sets the paper size and is drawn small as the thumbnail.
      const first = await doc.getPage(1);
      const vp = first.getViewport({ scale: 1 });
      $("p2i-meta").textContent = `${doc.numPages} ${doc.numPages === 1 ? "page" : "pages"} · ${paperName(vp.width, vp.height)} · ${fmtBytes(f.size)}`;
      const small = first.getViewport({ scale: 112 / Math.max(vp.width, vp.height) });
      const thumb = document.createElement("canvas");
      thumb.width = Math.ceil(small.width); thumb.height = Math.ceil(small.height);
      const tctx = thumb.getContext("2d")!;
      tctx.fillStyle = "#fff"; tctx.fillRect(0, 0, thumb.width, thumb.height);
      first.render({ canvas: thumb, canvasContext: tctx, viewport: small }).promise.then(() => $("p2i-thumb").replaceChildren(thumb)).catch(() => {});
      $("p2i-picked").hidden = false;
      compactDrop("p2i", true);
      go.disabled = false;
      stepTo(root, 2);
    } catch (e) {
      const msg = /password/i.test(String((e as Error).message)) ? "This PDF is password-protected. Remove the password in your PDF reader first." : "This file isn't a readable PDF.";
      showError(result, msg);
    }
  });

  go.addEventListener("click", async () => {
    if (!doc || !file) return;
    const ext = (document.querySelector('input[name="p2i-fmt"]:checked') as HTMLInputElement).value;
    const dpi = +(document.querySelector('input[name="p2i-dpi"]:checked') as HTMLInputElement).value;
    const rangeText = ($("p2i-range") as HTMLInputElement).value.trim();
    go.disabled = true;
    files.replaceChildren();
    stepTo(root, 3);
    await showBusy(result);
    let made = 0;
    const outs: { name: string; blob: Blob }[] = [];
    try {
      const pages = pagesFromRanges(rangeText ? parseRanges(rangeText, doc.numPages) : everyPage(doc.numPages));
      // Each picture appears as soon as it's made, so a long PDF shows progress and a late error keeps the rest.
      const progress = result.querySelector<HTMLElement>(".res-busy > span:last-child");
      for (const n of pages) {
        if (progress) progress.textContent = `Page ${made + 1} of ${pages.length}. Please keep this page open.`;
        const page = await doc.getPage(n);
        const base = page.getViewport({ scale: 1 });
        const viewport = page.getViewport({ scale: safeScale(base.width, base.height, dpi) });
        const canvas = document.createElement("canvas");
        canvas.width = Math.floor(viewport.width); canvas.height = Math.floor(viewport.height);
        const ctx = canvas.getContext("2d")!;
        if (ext === "jpg") { ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, canvas.width, canvas.height); }
        await page.render({ canvas, canvasContext: ctx, viewport }).promise;
        const type = ext === "jpg" ? "image/jpeg" : "image/png";
        const blob: Blob = await new Promise((r) => canvas.toBlob((b) => r(b!), type, 0.9));
        const name = pageFileName(file.name, n, doc.numPages, ext);
        const li = document.createElement("li");
        const nm = document.createElement("span"); nm.className = "fname"; nm.textContent = name;
        const m = document.createElement("span"); m.className = "fmeta"; m.textContent = `Page ${n} · ${canvas.width}×${canvas.height} · ${fmtBytes(blob.size)}`;
        const a = document.createElement("span"); a.className = "fact"; a.append(downloadLink(blob, name, type));
        li.append(nm, m, a); files.append(li); made++; outs.push({ name, blob });
      }
      const all = downloadAllButton(() => outs, `${baseName(file.name)}-images.zip`);
      showDone(result, `Done. ${made} ${made === 1 ? "picture" : "pictures"}.`, ...(all ? [all] : []));
      stepTo(root, 4);
    } catch (e) { showError(result, made ? `${(e as Error).message} The ${made} ${made === 1 ? "picture" : "pictures"} below were made before it stopped.` : (e as Error).message); }
    go.disabled = false;
  });

  // Changing the picture type, sharpness or pages makes an earlier result out of date.
  root.querySelector('.step[data-step="2"]')!.addEventListener("input", () => {
    if (!doc || !result.querySelector(".res-done, .res-bad")) return;
    files.replaceChildren();
    showWait(result, WAIT);
    stepTo(root, 2);
  });
</script>
