---
// Fill PDF Form: choose a form, type into its boxes, save.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="pff-tool" aria-label="Fill PDF form">
  <Step n={1} title="Choose your form">
    <DropZone prefix="pff" toolId="pdf/fill-form" category="pdf" name="Fill PDF Form" accept="application/pdf,.pdf" title="Drop your form here" hint="From your computer, phone or a USB stick" button="Choose PDF" />
    <ul class="file-list" id="pff-picked" hidden>
      <li class="has-thumb">
        <span class="fthumb" id="pff-thumb"><Icon name="file-pdf" weight="duotone" /></span>
        <span class="finfo"><span class="fname" id="pff-name"></span><span class="fmeta" id="pff-meta"></span></span>
        <span class="fact"><button class="btn quiet small" id="pff-change" type="button">Change</button></span>
      </li>
    </ul>
  </Step>

  <Step n={2} title="Fill it in" state="later">
    <form id="pff-form" class="pff-fields" novalidate></form>
    <label class="check"><input type="checkbox" id="pff-flat"> <span>Lock the answers so they can't be changed</span></label>
    <button class="btn run" id="pff-go" type="button" disabled><Icon name="pencil-simple" /><span>Save filled form</span></button>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="pff-result" aria-live="polite"><p class="res-wait">Your filled form will appear here.</p></div>
  </Step>
</section>

<script>
  import { listFields, fillForm } from "./core.js";
  import { wireDrop, fmtBytes, downloadLink, showError, showBusy, showDone, showWait, compactDrop, baseName } from "../../../src/lib/files";
  import { pdfFacts, pdfMeta } from "../../../src/lib/pdfinfo";
  import { stepTo } from "../../../src/lib/steps";
  const $ = (id: string) => document.getElementById(id)!;
  let bytes: ArrayBuffer | null = null, file: File | null = null;
  type Field = Awaited<ReturnType<typeof listFields>>[number];
  let fields: Field[] = [];
  const root = $("pff-tool"), result = $("pff-result"), go = $("pff-go") as HTMLButtonElement;
  const WAIT = "Your filled form will appear here.";

  const pretty = (name: string) => name.replace(/[._]+/g, " ").replace(/([a-z])([A-Z])/g, "$1 $2").trim();

  function control(f: Field, i: number): HTMLElement {
    const id = `pff-f${i}`;
    const wrap = document.createElement(f.type === "checkbox" ? "label" : "div");
    wrap.className = f.type === "checkbox" ? "check" : "field";
    if (f.type === "checkbox") {
      const c = document.createElement("input"); c.type = "checkbox"; c.id = id; c.checked = !!f.value; c.disabled = f.readOnly;
      wrap.append(c, document.createTextNode(" " + pretty(f.name)));
      return wrap;
    }
    const label = document.createElement("label"); label.htmlFor = id; label.textContent = pretty(f.name) + (f.readOnly ? " (read-only)" : "");
    const span = document.createElement("span"); span.append(label);
    let input: HTMLElement;
    if (f.type === "text") {
      const el = document.createElement(f.multiline ? "textarea" : "input") as HTMLInputElement;
      if (!f.multiline) el.type = "text";
      el.value = String(f.value ?? ""); input = el;
    } else {
      const sel = document.createElement("select"); sel.multiple = f.type === "list";
      if (f.type !== "list") sel.append(new Option("—", ""));
      for (const o of f.options ?? []) sel.append(new Option(o, o, false, Array.isArray(f.value) ? f.value.includes(o) : f.value === o));
      input = sel;
    }
    input.id = id; (input as HTMLInputElement).disabled = f.readOnly;
    wrap.append(span, input);
    return wrap;
  }

  $("pff-change").addEventListener("click", () => $("pff-file").click());

  wireDrop("pff", async (files) => {
    const f = files.find((x) => /\.pdf$/i.test(x.name) || x.type === "application/pdf");
    if (!f) return;
    showWait(result, WAIT);
    try {
      bytes = await f.arrayBuffer();
      fields = await listFields(bytes.slice(0));
      file = f;
      $("pff-name").textContent = f.name;
      $("pff-meta").textContent = [fields.length ? `${fields.length} ${fields.length === 1 ? "box" : "boxes"} to fill` : "", pdfMeta(await pdfFacts(f), f.size)].filter(Boolean).join(" · ");
      $("pff-picked").hidden = false;
      compactDrop("pff", true);
      $("pff-form").replaceChildren(...fields.map(control));
      go.disabled = !fields.length;
      if (!fields.length) {
        showError(result, "It may be a scanned page. Print it and fill it by hand, or ask the sender for a fillable copy.", "This PDF has no boxes to type in");
        stepTo(root, 1);
      } else stepTo(root, 2);
    } catch (e) { showError(result, (e as Error).message); }
  });

  go.addEventListener("click", async () => {
    if (!bytes || !file) return;
    const values: Record<string, string | boolean | string[]> = {};
    fields.forEach((f, i) => {
      const el = document.getElementById(`pff-f${i}`) as HTMLInputElement & HTMLSelectElement;
      values[f.name] = f.type === "checkbox" ? el.checked : f.type === "list" ? [...el.selectedOptions].map((o) => o.value) : el.value;
    });
    go.disabled = true;
    stepTo(root, 3);
    showBusy(result);
    try {
      const out = await fillForm(bytes.slice(0), values, { flatten: ($("pff-flat") as HTMLInputElement).checked });
      const name = `${baseName(file.name)}_filled.pdf`;
      const dl = downloadLink(out, name, "application/pdf", "Download PDF");
      dl.classList.add("run");
      showDone(result, "Done. Your form is filled in.", `${name} · ${fmtBytes(out.byteLength)}`);
      result.append(dl);
      stepTo(root, 4);
    } catch (e) { showError(result, (e as Error).message); }
    go.disabled = !fields.length;
  });

  // Changing anything in step 2 makes an earlier result out of date.
  root.querySelector('.step[data-step="2"]')!.addEventListener("input", () => {
    if (!result.querySelector(".res-done, .res-bad")) return;
    showWait(result, WAIT);
    stepTo(root, 2);
  });
</script>

<style>
  .pff-fields { display: grid; gap: 16px; }
  .pff-fields :global(select[multiple]) { min-height: 110px; }
</style>
