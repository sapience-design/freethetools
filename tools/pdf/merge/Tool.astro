---
// Merge PDFs: add files, put them in order, combine.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="pdfm-tool" aria-label="Merge PDFs">
  <Step n={1} title="Choose your PDFs">
    <DropZone prefix="pdfm" toolId="pdf/merge" category="pdf" name="Merge PDFs" accept="application/pdf,.pdf" multiple title="Drop your PDFs here" hint="Add as many as you like" button="Choose PDFs" />
  </Step>

  <Step n={2} title="Put them in order" state="later">
    <div id="pdfm-panel" class="tool-order" hidden>
      <ol class="file-list" id="pdfm-list"></ol>
      <p class="hint">The top file comes first. Use the arrows to move a file up or down.</p>
    </div>
    <p class="res-wait" id="pdfm-none">Your PDFs will appear here, in the order they'll be combined.</p>
    <div class="actions">
      <button class="btn run" id="pdfm-go" type="button" disabled><Icon name="arrows-merge" /><span id="pdfm-go-label">Add at least two PDFs</span></button>
      <button class="btn quiet small" id="pdfm-clear" type="button" hidden>Clear the list</button>
    </div>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="pdfm-result" aria-live="polite"><p class="res-wait">Your combined PDF will appear here.</p></div>
  </Step>
</section>

<script>
  import { mergePdfs, pageCount } from "./core.js";
  import { wireDrop, fmtBytes, downloadLink, showError, showBusy, showDone, showWait, compactDrop, iconButton, refocus, fileRow, pdfThumb } from "../../../src/lib/files";
  import { pdfFacts, pdfMeta } from "../../../src/lib/pdfinfo";
  import { stepTo } from "../../../src/lib/steps";

  type Item = { file: File; bytes: ArrayBuffer; pages: number };
  const items: Item[] = [];
  const $ = (id: string) => document.getElementById(id)!;
  const root = $("pdfm-tool"), list = $("pdfm-list"), panel = $("pdfm-panel"), none = $("pdfm-none");
  const go = $("pdfm-go") as HTMLButtonElement, goLabel = $("pdfm-go-label"), clear = $("pdfm-clear") as HTMLButtonElement;
  const result = $("pdfm-result");
  const WAIT = "Your combined PDF will appear here.";

  function render() {
    panel.hidden = !items.length;
    none.hidden = items.length > 0;
    clear.hidden = !items.length;
    go.disabled = items.length < 2;
    goLabel.textContent = items.length < 2 ? "Add at least two PDFs" : `Combine ${items.length} PDFs into one`;
    compactDrop("pdfm", items.length > 0);
    list.replaceChildren(...items.map((it, i) => {
      const li = fileRow({ name: it.file.name, meta: `${it.pages} ${it.pages === 1 ? "page" : "pages"} · ${fmtBytes(it.file.size)}`, thumb: pdfThumb() });
      pdfFacts(it.file).then((facts) => { if (facts) li.querySelector(".fmeta")!.textContent = pdfMeta(facts, it.file.size); });
      li.querySelector(".fact")!.append(
        iconButton("up", `Move up ${it.file.name}`, () => { [items[i - 1], items[i]] = [items[i], items[i - 1]]; changed(); refocus(list, i - 1, "up"); }, i === 0),
        iconButton("down", `Move down ${it.file.name}`, () => { [items[i + 1], items[i]] = [items[i], items[i + 1]]; changed(); refocus(list, i + 1, "down"); }, i === items.length - 1),
        iconButton("remove", `Remove ${it.file.name}`, () => { items.splice(i, 1); changed(); refocus(list, i, "remove", document.getElementById("pdfm-drop")); }),
      );
      return li;
    }));
    stepTo(root, items.length ? 2 : 1);
  }
  // Any change to the list makes an earlier result out of date.
  function changed() { showWait(result, WAIT); render(); }

  wireDrop("pdfm", async (files) => {
    showWait(result, WAIT);
    for (const file of files) {
      if (!/\.pdf$/i.test(file.name) && file.type !== "application/pdf") continue;
      const bytes = await file.arrayBuffer();
      try {
        items.push({ file, bytes, pages: await pageCount(bytes.slice(0)) });
      } catch (e) {
        showError(result, `${file.name}: ${(e as Error).message}`, "We can't open this PDF");
      }
    }
    render();
  });

  clear.onclick = () => { items.length = 0; changed(); };

  go.onclick = async () => {
    go.disabled = true;
    stepTo(root, 3);
    showBusy(result);
    try {
      const out = await mergePdfs(items.map((it) => it.bytes.slice(0)));
      const pages = items.reduce((n, it) => n + it.pages, 0);
      const dl = downloadLink(out, "merged.pdf", "application/pdf", "Download PDF");
      dl.classList.add("run");
      showDone(result, `Done. ${items.length} files are now one PDF.`, `merged.pdf · ${pages} pages · ${fmtBytes(out.byteLength)}, in the order you chose`);
      result.append(dl);
      stepTo(root, 4);
    } catch (e) {
      showError(result, (e as Error).message);
    }
    go.disabled = items.length < 2;
  };

  render();
</script>
