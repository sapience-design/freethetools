---
// Compress PDF: the working area. The page around it (name, specs, FAQ, credits) comes from tool.json.
import { artFor } from "../../../src/data/art";
const shot = artFor("pdf/compress", "pdf", "pdfcdrop");
---
<section class="shrink" aria-label="Compress PDFs">
  <div class="drop" id="pdfc-drop" tabindex="0" role="button">
    <span class="shot" aria-hidden="true" set:html={shot} />
    <span class="label"><strong>Drop PDFs here</strong><span>Several at once is fine</span><span class="btn pick">Choose PDFs</span></span>
    <input type="file" id="pdfc-file" accept="application/pdf,.pdf" multiple hidden>
  </div>

  <fieldset>
    <legend class="eyebrow">Quality</legend>
    <div class="presets">
      <div class="preset"><input type="radio" name="preset" id="pdfc-p-screen" value="screen"><label for="pdfc-p-screen"><b>Smallest</b><small>72 dpi</small></label></div>
      <div class="preset"><input type="radio" name="preset" id="pdfc-p-ebook" value="ebook" checked><label for="pdfc-p-ebook"><b>Balanced</b><small>150 dpi</small></label></div>
      <div class="preset"><input type="radio" name="preset" id="pdfc-p-printer" value="printer"><label for="pdfc-p-printer"><b>Print</b><small>300 dpi</small></label></div>
      <div class="preset"><input type="radio" name="preset" id="pdfc-p-prepress" value="prepress"><label for="pdfc-p-prepress"><b>Prepress</b><small>colour kept</small></label></div>
    </div>
    <label class="check"><input type="checkbox" id="pdfc-first"> <span>Keep only the first page</span></label>
  </fieldset>

  <div class="results" id="pdfc-results" aria-live="polite">
    <div class="row example" id="pdfc-example">
      <div class="name">schematic.pdf <span class="tag">Example</span></div>
      <div class="meta mono">1.92 MB → 828 KB · <span class="saved">57% smaller</span></div>
      <div class="act mono muted">your files appear here</div>
    </div>
  </div>
</section>

<style>
  .shrink { display: grid; gap: 28px; }
  .drop {
    position: relative; display: grid; place-items: center; align-content: end; gap: 4px; text-align: center; aspect-ratio: 4 / 3;
    padding-bottom: 28px; border-radius: 6px; overflow: hidden; cursor: pointer; isolation: isolate;
  }
  .drop .shot { position: absolute; inset: 0; z-index: -1; }
  .drop .shot :global(svg) { width: 100%; height: 100%; display: block; }
  .drop .shot :global(.obj) { transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .drop:hover .shot :global(.obj), .drop.over .shot :global(.obj) { transform: translateY(-8px); }
  .drop::after { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; box-shadow: inset 0 0 0 2px transparent; transition: box-shadow .2s; }
  .drop.over::after { box-shadow: inset 0 0 0 2px var(--ink); }
  .label { display: grid; gap: 2px; padding: 10px 18px 11px; border-radius: 14px; background: rgba(255,255,255,.78); backdrop-filter: blur(10px); box-shadow: 0 1px 2px rgba(0,0,0,.06); }
  /* The label is always light, whatever the theme, so its text and button use fixed colours. */
  .drop strong { font-size: var(--t-lg); line-height: var(--lh-lg); font-weight: 600; color: #111; }
  .drop span:not(.plus):not(.pick) { color: #555a60; font-size: var(--t-sm); line-height: var(--lh-sm); }
  .drop .pick { justify-self: center; margin-top: 6px; min-height: 32px; padding: 0 14px; background: #111; color: #fff; }
  .drop:hover .pick, .drop:focus-visible .pick { opacity: .86; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 14px; }
  legend { padding: 0; margin-bottom: 10px; color: var(--muted); }
  .presets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; padding: 4px; background: var(--studio); border-radius: 12px; }
  .preset input { position: absolute; opacity: 0; pointer-events: none; }
  .preset label { display: grid; gap: 2px; padding: 10px 14px; cursor: pointer; height: 100%; border-radius: 9px; transition: background .15s; }
  .preset label:hover { background: var(--studio-2); }
  .preset label b { font-weight: 500; font-size: var(--t-sm); line-height: var(--lh-sm-ui); }
  .preset label small { color: var(--muted); font-size: var(--t-xs); line-height: var(--lh-xs); font-family: var(--sans); }
  .preset input:checked + label { background: var(--paper); color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 0 0 1px var(--line); }
  .preset input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: -2px; }
  @media (max-width: 560px) { .presets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .check { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: var(--t-base); line-height: var(--lh-base); }
  .check input { width: 17px; height: 17px; accent-color: var(--ink); }
  .results { display: grid; border-top: 1px solid var(--line); }
  .results :global(.row) { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .results :global(.name) { font-size: var(--t-base); line-height: var(--lh-base); font-weight: 500; overflow-wrap: anywhere; }
  .results :global(.meta) { grid-column: 1; color: var(--muted); font-size: var(--t-sm); line-height: var(--lh-sm); }
  .results :global(.act) { grid-row: 1 / span 2; grid-column: 2; font-size: var(--t-sm); }
  .results :global(.example) .tag { border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; }
  .tag { font-size: var(--t-xs); color: var(--muted); margin-left: 8px; font-weight: 400; }
  .results :global(.saved) { color: var(--ok); }
  .results :global(.err) { color: var(--bad); }
  .results :global(.spin) { display: inline-block; width: 11px; height: 11px; border: 1.5px solid var(--line); border-top-color: var(--ink); border-radius: 50%; animation: spin .8s linear infinite; vertical-align: -1px; margin-right: 4px; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  import { reportFailure } from "../../../src/lib/files";
  import { buildArgs } from "./core.js";
  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const drop = $("#pdfc-drop"), input = $<HTMLInputElement>("#pdfc-file"), results = $("#pdfc-results");
  const worker = new Worker(new URL("./worker.js", import.meta.url));
  type Job = { row: HTMLElement; file: File; preset: string; firstPage: boolean };
  const jobs = new Map<number, Job>();
  let nextId = 1;

  const fmt = (n: number) => (n >= 1048576 ? (n / 1048576).toFixed(2) + " MB" : Math.max(1, Math.round(n / 1024)) + " KB");
  const labels: Record<string, string> = { screen: "smallest", ebook: "balanced", printer: "print", prepress: "prepress" };
  const setMeta = (row: HTMLElement, html: string) => ((row.querySelector(".meta") as HTMLElement).innerHTML = html);

  const LOAD_ERROR = '<span class="err">The compressor could not load. Reload the page and try again.</span>';
  let broken = false; // the worker failed to start; files dropped later must not wait forever
  worker.onerror = () => {
    broken = true;
    reportFailure();
    for (const { row } of jobs.values()) setMeta(row, LOAD_ERROR);
    jobs.clear();
  };

  worker.onmessage = ({ data }) => {
    const job = jobs.get(data.id);
    if (!job) return;
    jobs.delete(data.id);
    const { row, file, preset, firstPage } = job;
    if (!data.ok) {
      reportFailure();
      setMeta(row, "");
      const err = document.createElement("span");
      err.className = "err";
      err.textContent = `Could not compress: ${data.error}. The PDF may be password-protected or damaged.`;
      row.querySelector(".meta")!.append(err);
      return;
    }
    const size = data.out.byteLength;
    const pct = Math.round(100 * (1 - size / file.size));
    const note = pct > 0 ? `<span class="saved">${pct}% smaller</span>` : `<span>already compact, ${-pct}% larger</span>`;
    setMeta(row, `${fmt(file.size)} → ${fmt(size)} · ${note} · ${labels[preset]}${firstPage ? " · page 1 only" : ""}`);
    const a = document.createElement("a");
    a.className = "btn";
    a.textContent = "Download";
    a.href = URL.createObjectURL(new Blob([data.out], { type: "application/pdf" }));
    a.download = `${file.name.replace(/\.pdf$/i, "")}${firstPage ? "_p1" : ""}_small.pdf`;
    row.querySelector(".act")!.replaceChildren(a);
  };

  async function handle(files: File[]) {
    document.getElementById("pdfc-example")?.remove();
    const preset = (document.querySelector('input[name="preset"]:checked') as HTMLInputElement).value;
    const firstPage = $<HTMLInputElement>("#pdfc-first").checked;
    for (const file of files) {
      if (!/\.pdf$/i.test(file.name) && file.type !== "application/pdf") continue;
      const row = document.createElement("div");
      row.className = "row";
      row.innerHTML = `<div class="name"></div><div class="meta mono"><span class="spin"></span>compressing ${fmt(file.size)}…</div><div class="act"></div>`;
      row.querySelector(".name")!.textContent = file.name;
      results.prepend(row);
      if (broken) { setMeta(row, LOAD_ERROR); continue; }
      const id = nextId++;
      jobs.set(id, { row, file, preset, firstPage });
      const bytes = await file.arrayBuffer();
      worker.postMessage({ id, bytes, args: buildArgs({ preset, firstPage }) }, [bytes]);
    }
  }

  drop.addEventListener("click", () => input.click());
  drop.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); } });
  input.addEventListener("change", () => { handle([...(input.files ?? [])]); input.value = ""; });
  for (const t of ["dragenter", "dragover"]) drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add("over"); });
  for (const t of ["dragleave", "drop"]) drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove("over"); });
  drop.addEventListener("drop", (e) => handle([...((e as DragEvent).dataTransfer?.files ?? [])]));
</script>
