---
// Compress PDF: the working area. The page around it (name, specs, FAQ, credits) comes from tool.json.
// Choose PDFs, pick a quality, press the button; each PDF is compressed by Ghostscript in a worker.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="pdfc-tool" aria-label="Compress PDFs">
  <Step n={1} title="Choose your PDF">
    <DropZone prefix="pdfc" toolId="pdf/compress" category="pdf" name="Compress PDF" accept="application/pdf,.pdf" multiple title="Drop your PDF here" hint="Several at once is fine" button="Choose PDF" />
    <ul class="file-list" id="pdfc-picked" hidden></ul>
  </Step>

  <Step n={2} title="Pick how small" state="later">
    <fieldset class="choices">
      <legend class="sr-only">Quality</legend>
      <div class="choice"><input type="radio" name="preset" id="pdfc-p-screen" value="screen"><label for="pdfc-p-screen"><b>Smallest</b><small>Good for reading on screen · 72 dpi</small></label></div>
      <div class="choice"><input type="radio" name="preset" id="pdfc-p-ebook" value="ebook" checked><label for="pdfc-p-ebook"><b>Good quality</b><small>Right for email and forms · 150 dpi</small><span class="badge rec">Recommended</span></label></div>
      <div class="choice"><input type="radio" name="preset" id="pdfc-p-printer" value="printer"><label for="pdfc-p-printer"><b>For printing</b><small>Sharp text and pictures · 300 dpi</small></label></div>
      <div class="choice"><input type="radio" name="preset" id="pdfc-p-prepress" value="prepress"><label for="pdfc-p-prepress"><b>For a print shop</b><small>Keeps colour profiles for professional printing</small></label></div>
    </fieldset>
    <label class="check"><input type="checkbox" id="pdfc-first"> <span>Keep only the first page</span></label>
    <button class="btn run" id="pdfc-go" type="button" disabled><Icon name="arrows-in" /><span id="pdfc-go-label">Make it smaller</span></button>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="pdfc-status" aria-live="polite"><p class="res-wait">Your smaller PDF will appear here.</p></div>
    <ul class="file-list" id="pdfc-results"></ul>
    <button class="btn quiet" id="pdfc-again" type="button" hidden><Icon name="arrow-counter-clockwise" />Do another</button>
  </Step>
</section>

<script>
  import { reportFailure, fmtBytes, compactDrop, compareBars, iconButton, showBusy, showDone, showProblem, showWait, wireDrop, fileRow, pdfThumb } from "../../../src/lib/files";
  import { pdfFacts, pdfMeta } from "../../../src/lib/pdfinfo";
  import { stepTo } from "../../../src/lib/steps";
  import { buildArgs } from "./core.js";
  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const root = $("#pdfc-tool"), picked = $("#pdfc-picked"), results = $("#pdfc-results"), status = $("#pdfc-status");
  const go = $<HTMLButtonElement>("#pdfc-go"), goLabel = $("#pdfc-go-label"), again = $("#pdfc-again");
  const worker = new Worker(new URL("./worker.js", import.meta.url));
  type Job = { row: HTMLElement; file: File; preset: string; firstPage: boolean };
  const jobs = new Map<number, Job>();
  let pending: File[] = [];
  let nextId = 1;
  let batch = { total: 0, done: 0, failed: 0, before: 0, after: 0 };
  const running = () => batch.done + batch.failed < batch.total;

  const labels: Record<string, string> = { screen: "smallest", ebook: "good quality", printer: "for printing", prepress: "for a print shop" };
  const setMeta = (row: HTMLElement, html: string) => ((row.querySelector(".fmeta") as HTMLElement).innerHTML = html);

  const LOAD_ERROR = '<span class="err">The compressor could not load. Reload the page and try again.</span>';
  let broken = false; // the worker failed to start; files added later must not wait forever
  worker.onerror = () => {
    broken = true;
    reportFailure();
    for (const { row } of jobs.values()) setMeta(row, LOAD_ERROR);
    batch.failed += jobs.size;
    jobs.clear();
    finish();
  };

  // ---- Step 1: the files waiting to be compressed ----
  function renderPicked() {
    picked.hidden = !pending.length;
    picked.replaceChildren(...pending.map((f, i) => {
      const warn = document.createElement("ul");
      warn.className = "ffacts";
      warn.hidden = true;
      const li = fileRow({ name: f.name, meta: fmtBytes(f.size), thumb: pdfThumb(), extra: [warn], actions: [iconButton("remove", `Remove ${f.name}`, () => { pending.splice(i, 1); renderPicked(); })] });
      pdfFacts(f).then((facts) => {
        li.querySelector(".fmeta")!.textContent = pdfMeta(facts, f.size);
        if (facts?.locked) {
          const w = document.createElement("li");
          w.className = "warn";
          w.textContent = "Locked with a password. Remove the password in your PDF reader first, or this one won't compress.";
          warn.replaceChildren(w);
          warn.hidden = false;
        }
      });
      return li;
    }));
    compactDrop("pdfc", pending.length > 0 || results.children.length > 0);
    go.disabled = !pending.length || running();
    goLabel.textContent = pending.length > 1 ? `Make ${pending.length} PDFs smaller` : "Make it smaller";
    if (pending.length) stepTo(root, 2);
    else if (!batch.total) stepTo(root, 1);
  }

  wireDrop("pdfc", (files) => {
    pending.push(...files.filter((f) => /\.pdf$/i.test(f.name) || f.type === "application/pdf"));
    renderPicked();
  });

  // ---- Step 2 → 3: compress ----
  worker.onmessage = ({ data }) => {
    const job = jobs.get(data.id);
    if (!job) return;
    jobs.delete(data.id);
    const { row, file, preset, firstPage } = job;
    if (!data.ok) {
      reportFailure();
      setMeta(row, "");
      const err = document.createElement("span");
      err.className = "err";
      err.textContent = `Could not compress: ${data.error}. The PDF may be password-protected or damaged.`;
      row.querySelector(".fmeta")!.append(err);
      batch.failed++;
      finish();
      return;
    }
    const size = data.out.byteLength;
    const pct = Math.round(100 * (1 - size / file.size));
    const note = pct > 0 ? `<span class="saved">${pct}% smaller</span>` : `<span>already compact, ${-pct}% larger</span>`;
    setMeta(row, `${fmtBytes(file.size)} → ${fmtBytes(size)} · ${note} · ${labels[preset]}${firstPage ? " · page 1 only" : ""}`);
    const a = document.createElement("a");
    a.className = "btn";
    a.textContent = "Download";
    a.href = URL.createObjectURL(new Blob([data.out], { type: "application/pdf" }));
    a.download = `${file.name.replace(/\.pdf$/i, "")}${firstPage ? "_p1" : ""}_small.pdf`;
    row.querySelector(".fact")!.replaceChildren(a);
    batch.done++;
    batch.before += file.size;
    batch.after += size;
    finish();
  };

  function finish() {
    if (!batch.total || running()) return;
    go.disabled = !pending.length;
    again.hidden = false;
    if (!batch.done) { showProblem(status, batch.total > 1 ? "None of these PDFs could be compressed. Each row says why." : "This PDF could not be compressed. The row below says why.", "That didn't work"); return; }
    stepTo(root, 4);
    const pct = Math.round(100 * (1 - batch.after / batch.before));
    const title = pct > 0
      ? (batch.done > 1 ? `Done. ${batch.done} PDFs, ${pct}% smaller in total.` : `Done. It's ${pct}% smaller.`)
      : "Done, but it didn't get smaller. Keep your original.";
    showDone(status, title, compareBars(batch.before, batch.after));
  }

  go.addEventListener("click", async () => {
    if (!pending.length || running()) return;
    const files = pending;
    pending = [];
    renderPicked();
    const preset = (document.querySelector('input[name="preset"]:checked') as HTMLInputElement).value;
    const firstPage = $<HTMLInputElement>("#pdfc-first").checked;
    batch = { total: files.length, done: 0, failed: 0, before: 0, after: 0 };
    again.hidden = true;
    results.replaceChildren();
    stepTo(root, 3);
    compactDrop("pdfc", true);
    showBusy(status, files.length > 1 ? `Compressing ${files.length} PDFs. Please keep this page open.` : undefined);
    for (const file of files) {
      const row = fileRow({ name: file.name, meta: "", thumb: pdfThumb() });
      setMeta(row, `<span class="spin"></span>compressing ${fmtBytes(file.size)}…`);
      results.append(row);
      if (broken) { setMeta(row, LOAD_ERROR); batch.failed++; finish(); continue; }
      const id = nextId++;
      jobs.set(id, { row, file, preset, firstPage });
      const bytes = await file.arrayBuffer();
      worker.postMessage({ id, bytes, args: buildArgs({ preset, firstPage }) }, [bytes]);
    }
  });

  again.addEventListener("click", () => {
    results.replaceChildren();
    batch = { total: 0, done: 0, failed: 0, before: 0, after: 0 };
    again.hidden = true;
    showWait(status, "Your smaller PDF will appear here.");
    renderPicked();
    stepTo(root, 1);
    document.getElementById("pdfc-drop")?.focus();
  });
</script>
