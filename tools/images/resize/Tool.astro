---
// Resize images: choose photos, pick a size, press the button; each photo is redrawn in the browser.
import DropZone from "../../../src/components/DropZone.astro";
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="rsz-tool" aria-label="Resize images">
  <Step n={1} title="Choose your photos">
    <DropZone prefix="rsz" toolId="images/resize" category="images" name="Resize Images" accept="image/*" multiple title="Drop your photos here" hint="JPG, PNG or WebP · one or many" button="Choose photos" />
    <ul class="file-list" id="rsz-picked" hidden></ul>
  </Step>

  <Step n={2} title="Pick a size" state="later">
    <fieldset class="field">
      <legend>Resize by</legend>
      <div class="seg">
        <input type="radio" name="rsz-mode" id="rsz-width" value="width" checked><label for="rsz-width">Width</label>
        <input type="radio" name="rsz-mode" id="rsz-height" value="height"><label for="rsz-height">Height</label>
        <input type="radio" name="rsz-mode" id="rsz-box" value="box"><label for="rsz-box">Fit in a box</label>
        <input type="radio" name="rsz-mode" id="rsz-percent" value="percent"><label for="rsz-percent">Percentage</label>
      </div>
    </fieldset>
    <div class="rsz-row">
      <label class="field" id="rsz-w-f"><span>Width (px)</span><input type="number" id="rsz-w" value="1200" min="1"></label>
      <label class="field" id="rsz-h-f" hidden><span>Height (px)</span><input type="number" id="rsz-h" value="1200" min="1"></label>
      <label class="field" id="rsz-p-f" hidden><span>Percent</span><input type="number" id="rsz-p" value="50" min="1"></label>
    </div>
    <button class="btn run" id="rsz-go" type="button" disabled><Icon name="arrows-out" /><span id="rsz-go-label">Resize photos</span></button>
  </Step>

  <Step n={3} title="Save it" state="later">
    <div class="result" id="rsz-status" aria-live="polite"><p class="res-wait">Your resized photos will appear here.</p></div>
    <ul class="file-list" id="rsz-list"></ul>
    <button class="btn quiet" id="rsz-again" type="button" hidden><Icon name="arrow-counter-clockwise" />Do another</button>
  </Step>
</section>

<script>
  import { targetSize, checkSize } from "./core.js";
  import { decode, encode, EXT, type Format } from "../../../src/lib/images";
  import { wireDrop, compactDrop, fmtBytes, downloadLink, baseName, reportFailure, iconButton, showBusy, showDone, showProblem, showWait } from "../../../src/lib/files";
  import { stepTo } from "../../../src/lib/steps";
  const $ = (id: string) => document.getElementById(id)!;
  const root = $("rsz-tool"), picked = $("rsz-picked"), list = $("rsz-list"), status = $("rsz-status");
  const go = $("rsz-go") as HTMLButtonElement, goLabel = $("rsz-go-label"), again = $("rsz-again");
  const num = (id: string) => +($(id) as HTMLInputElement).value;
  const mode = () => (document.querySelector('input[name="rsz-mode"]:checked') as HTMLInputElement).value;
  let pending: File[] = [];
  let running = false;

  function fields() {
    const m = mode();
    $("rsz-w-f").hidden = !(m === "width" || m === "box");
    $("rsz-h-f").hidden = !(m === "height" || m === "box");
    $("rsz-p-f").hidden = m !== "percent";
  }
  document.querySelectorAll('input[name="rsz-mode"]').forEach((r) => r.addEventListener("change", fields));

  function renderPicked() {
    picked.hidden = !pending.length;
    picked.replaceChildren(...pending.map((f, i) => {
      const li = document.createElement("li");
      const n = document.createElement("span"); n.className = "fname"; n.textContent = f.name;
      const m = document.createElement("span"); m.className = "fmeta"; m.textContent = fmtBytes(f.size);
      const act = document.createElement("span"); act.className = "fact";
      act.append(iconButton("remove", `Remove ${f.name}`, () => { pending.splice(i, 1); renderPicked(); }));
      li.append(n, m, act);
      return li;
    }));
    compactDrop("rsz", pending.length > 0 || list.children.length > 0);
    go.disabled = !pending.length || running;
    goLabel.textContent = pending.length > 1 ? `Resize ${pending.length} photos` : "Resize photos";
    if (pending.length) stepTo(root, 2);
    else if (!list.children.length) stepTo(root, 1);
  }

  wireDrop("rsz", (files) => {
    pending.push(...files.filter((x) => x.type.startsWith("image/")));
    renderPicked();
  });

  go.addEventListener("click", async () => {
    if (!pending.length || running) return;
    running = true;
    const files = pending;
    pending = [];
    renderPicked();
    again.hidden = true;
    list.replaceChildren();
    stepTo(root, 3);
    compactDrop("rsz", true);
    showBusy(status, files.length > 1 ? `Resizing ${files.length} photos. Please keep this page open.` : undefined);
    let done = 0;
    for (const f of files) {
      const li = document.createElement("li");
      const n = document.createElement("span"); n.className = "fname"; n.textContent = f.name;
      const m = document.createElement("span"); m.className = "fmeta"; m.textContent = "Resizing…";
      const act = document.createElement("span"); act.className = "fact";
      li.append(n, m, act); list.append(li);
      try {
        const bmp = await decode(f);
        const md = mode();
        const opt = md === "percent" ? { mode: md, percent: num("rsz-p") } : md === "width" ? { mode: md, width: num("rsz-w") } : md === "height" ? { mode: md, height: num("rsz-h") } : { mode: md, width: num("rsz-w"), height: num("rsz-h") };
        const size = checkSize(targetSize(bmp.width, bmp.height, opt as never));
        const type: Format = f.type === "image/png" || f.type === "image/webp" ? (f.type as Format) : "image/jpeg";
        const blob = await encode(bmp, size.width, size.height, type, 0.9);
        m.textContent = `${bmp.width}×${bmp.height} → ${size.width}×${size.height} · ${fmtBytes(blob.size)}`;
        act.append(downloadLink(blob, `${baseName(f.name)}_${size.width}x${size.height}.${EXT[type]}`, type));
        done++;
      } catch (e) { reportFailure(); m.textContent = (e as Error).message; }
    }
    running = false;
    go.disabled = !pending.length;
    again.hidden = false;
    if (!done) {
      showProblem(status, files.length > 1 ? "None of these photos could be resized. Each row says why." : "This photo could not be resized. The row below says why.", "That didn't work");
      return;
    }
    stepTo(root, 4);
    showDone(status, done > 1 ? `Done. ${done} photos resized.` : "Done. Your photo is resized.");
  });

  again.addEventListener("click", () => {
    list.replaceChildren();
    again.hidden = true;
    showWait(status, "Your resized photos will appear here.");
    renderPicked();
    stepTo(root, 1);
    document.getElementById("rsz-drop")?.focus();
  });
  fields();
</script>

<style>
  .rsz-row { display: flex; flex-wrap: wrap; gap: 16px; }
  .rsz-row .field { width: 160px; }
</style>
