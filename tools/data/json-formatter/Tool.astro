---
import ToolShot from "../../../src/components/ToolShot.astro";
const sample = JSON.stringify({ name: "Free the Tools", tools: ["Compress PDF", "Merge PDFs"], uploads: 0, open: true });
---
<section class="tool" aria-label="JSON formatter">
  <ToolShot toolId="data/json-formatter" category="data" name="JSON Formatter" />
  <label class="field"><span>JSON</span><textarea id="jf-in" rows="9" spellcheck="false">{sample}</textarea></label>
  <fieldset class="field">
    <legend class="eyebrow">Layout</legend>
    <div class="seg">
      <input type="radio" name="jf-indent" id="jf-2" value="2" checked><label for="jf-2">2 spaces</label>
      <input type="radio" name="jf-indent" id="jf-4" value="4"><label for="jf-4">4 spaces</label>
      <input type="radio" name="jf-indent" id="jf-tab" value="tab"><label for="jf-tab">Tabs</label>
      <input type="radio" name="jf-indent" id="jf-min" value="0"><label for="jf-min">Minify</label>
    </div>
  </fieldset>
  <label class="check"><input type="checkbox" id="jf-sort"> Sort keys A to Z</label>
  <div class="out">
    <span class="eyebrow" id="jf-status"></span>
    <pre class="out-box" id="jf-out" aria-live="polite"></pre>
    <div class="actions"><button class="btn line" id="jf-copy" type="button">Copy result</button></div>
  </div>
</section>

<script>
  import { formatJson } from "./core.js";
  const $ = (id: string) => document.getElementById(id)!;
  const input = $("jf-in") as HTMLTextAreaElement, out = $("jf-out"), status = $("jf-status");
  function update() {
    const v = (document.querySelector('input[name="jf-indent"]:checked') as HTMLInputElement).value;
    const r = formatJson(input.value, { indent: v === "tab" ? "tab" : +v, sort: ($("jf-sort") as HTMLInputElement).checked });
    if (r.ok) { out.textContent = r.output; status.textContent = "Valid JSON"; out.classList.remove("bad"); }
    else { out.textContent = r.error + (r.line ? `\nLine ${r.line}, column ${r.column}.` : ""); status.textContent = "Needs fixing"; out.classList.add("bad"); }
  }
  input.addEventListener("input", update);
  document.querySelectorAll('input[name="jf-indent"], #jf-sort').forEach((el) => el.addEventListener("change", update));
  const copy = $("jf-copy") as HTMLButtonElement;
  copy.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(out.textContent ?? ""); copy.textContent = "Copied"; } catch { copy.textContent = "Select the text to copy"; }
    setTimeout(() => (copy.textContent = "Copy result"), 1600);
  });
  update();
</script>

<style>
  pre.out-box { margin: 0; max-height: 420px; overflow: auto; }
  pre.out-box.bad { color: var(--bad); }
</style>
