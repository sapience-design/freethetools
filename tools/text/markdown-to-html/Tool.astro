---
// Markdown to HTML: works as you type. Step 1 the text, step 2 the direction, step 3 the result,
// shown as a cleaned preview or as code.
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
import { EXAMPLE_MARKDOWN } from "./core.js";
---
<section class="tool" id="md-tool" aria-label="Markdown to HTML">
  <Step n={1} title="Type or paste your text">
    <label class="field"><span id="md-in-label">Markdown</span><textarea id="md-in" rows="10" spellcheck="false">{EXAMPLE_MARKDOWN}</textarea></label>
    <div class="actions">
      <button type="button" class="btn quiet small" id="md-open"><Icon name="folder-open" />Open a file instead</button><input type="file" id="md-file" accept=".md,.markdown,.txt,.html,.htm,text/markdown,text/html,text/plain" hidden>
    </div>
  </Step>
  <Step n={2} title="Which way?">
    <fieldset class="field">
      <legend class="sr-only">Direction</legend>
      <div class="seg">
        <input type="radio" name="md-dir" id="md-m2h" value="m2h" checked><label for="md-m2h">Markdown to HTML</label>
        <input type="radio" name="md-dir" id="md-h2m" value="h2m"><label for="md-h2m">HTML to Markdown</label>
      </div>
    </fieldset>
    <label class="check" id="md-clean-wrap"><input type="checkbox" id="md-clean" checked> Remove scripts and unsafe markup from the HTML</label>
  </Step>
  <Step n={3} title="Copy or save the result">
    <div class="md-bar">
      <span class="hint" id="md-status"></span>
      <fieldset class="md-view">
        <legend class="sr-only">Show the result as</legend>
        <div class="seg">
          <input type="radio" name="md-view" id="md-view-preview" value="preview" checked><label for="md-view-preview"><Icon name="eye" />Preview</label>
          <input type="radio" name="md-view" id="md-view-code" value="code"><label for="md-view-code"><Icon name="code" />Code</label>
        </div>
      </fieldset>
    </div>
    <div class="md-preview" id="md-preview" tabindex="0" role="region" aria-label="Rendered preview"></div>
    <pre class="out-box" id="md-out" tabindex="0" role="region" aria-label="Result code" hidden></pre>
    <p class="sr-only" id="md-live" role="status"></p>
    <button class="btn run" id="md-copy" type="button"><Icon name="copy" /><span id="md-copy-label">Copy result</span></button>
    <div class="actions" id="md-actions"></div>
  </Step>
</section>

<script>
  import { markdownToHtml, htmlToMarkdown, sanitizeHtml } from "./core.js";
  import { downloadLink, baseName, reportFailure } from "../../../src/lib/files";
  const $ = (id: string) => document.getElementById(id)!;
  const input = $("md-in") as HTMLTextAreaElement, out = $("md-out"), status = $("md-status"), preview = $("md-preview");
  let dl: HTMLAnchorElement | null = null;
  // The result box is rewritten on every keystroke, so it is not a live region. This short message is,
  // and it is written only when it changes.
  const live = $("md-live");
  const announce = (text: string) => { if (live.textContent !== text) live.textContent = text; };
  let stem = "document";
  const dir = () => (document.querySelector('input[name="md-dir"]:checked') as HTMLInputElement).value;

  function update() {
    const m2h = dir() === "m2h";
    $("md-in-label").textContent = m2h ? "Markdown" : "HTML";
    $("md-clean-wrap").hidden = !m2h;
    dl?.remove(); dl = null;
    try {
      let result: string, html: string;
      if (m2h) {
        const clean = ($("md-clean") as HTMLInputElement).checked;
        result = html = markdownToHtml(input.value, { sanitize: clean });
        status.textContent = clean ? "HTML ready, cleaned" : "HTML ready, exactly as written";
        announce(status.textContent);
        dl = downloadLink(result, `${stem}.html`, "text/html", "Download .html");
        dl.classList.add("line");
      } else {
        result = htmlToMarkdown(input.value);
        html = markdownToHtml(result);
        status.textContent = "Markdown ready";
        announce(status.textContent);
        dl = downloadLink(result, `${stem}.md`, "text/markdown", "Download .md");
        dl.classList.add("line");
      }
      out.textContent = result;
      // The preview is always cleaned, and never loads images from other sites.
      preview.innerHTML = sanitizeHtml(html, { preview: true });
      // Headings in the preview are styled text, so they never compete with the page's own headings.
      preview.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach((h) => {
        const d = document.createElement("div");
        d.className = `md-h md-${h.tagName.toLowerCase()}`;
        d.append(...h.childNodes);
        h.replaceWith(d);
      });
      $("md-actions").prepend(dl);
      out.classList.remove("bad");
    } catch (e) {
      reportFailure();
      out.textContent = (e as Error).message; status.textContent = "Needs fixing"; announce((e as Error).message); out.classList.add("bad");
      // Show the problem in whichever view is open.
      const p = document.createElement("p");
      p.className = "md-err";
      p.textContent = (e as Error).message;
      preview.replaceChildren(p);
    }
  }

  input.addEventListener("input", update);
  document.querySelectorAll('input[name="md-dir"], #md-clean').forEach((el) => el.addEventListener("change", update));
  $("md-open").addEventListener("click", () => ($("md-file") as HTMLInputElement).click());
  ($("md-file") as HTMLInputElement).addEventListener("change", async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    input.value = await f.text();
    stem = baseName(f.name) || "document";
    ($(/\.html?$/i.test(f.name) ? "md-h2m" : "md-m2h") as HTMLInputElement).checked = true;
    update();
  });
  // Preview or Code: one result area, two views. The choice is remembered in this browser.
  const VIEW_KEY = "ftt:md-view";
  const codeView = $("md-view-code") as HTMLInputElement;
  const showView = () => { out.hidden = !codeView.checked; preview.hidden = codeView.checked; };
  try { if (localStorage.getItem(VIEW_KEY) === "code") codeView.checked = true; } catch {}
  document.querySelectorAll<HTMLInputElement>('input[name="md-view"]').forEach((r) =>
    r.addEventListener("change", () => { showView(); try { localStorage.setItem(VIEW_KEY, r.value); } catch {} }),
  );
  showView();

  const copy = $("md-copy") as HTMLButtonElement, copyLabel = $("md-copy-label");
  copy.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(out.textContent ?? ""); copyLabel.textContent = "Copied"; } catch { copyLabel.textContent = "Select the text to copy"; }
    setTimeout(() => (copyLabel.textContent = "Copy result"), 1600);
  });
  update();
</script>

<style>
  .md-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .md-view { margin: 0; padding: 0; border: 0; min-width: 0; }
  .md-view .seg label { display: inline-flex; align-items: center; gap: 8px; }
  .md-view :global(.ic) { font-size: 18px; }
  .md-preview :global(.md-err) { margin: 0; color: var(--bad); }
  pre.out-box { margin: 0; max-height: 480px; overflow: auto; }
  .md-preview { padding: 14px 16px; border: 1px solid var(--hair); border-radius: var(--r); background: var(--bg); max-height: 480px; overflow: auto; overflow-wrap: anywhere; }
  .md-preview :global(> :first-child) { margin-top: 0; }
  .md-preview :global(> :last-child) { margin-bottom: 0; }
  .md-preview :global(.md-h) { margin: 1em 0 .4em; font-family: var(--display); font-weight: 700; line-height: 1.2; }
  .md-preview :global(.md-h1) { font-size: 1.5rem; }
  .md-preview :global(.md-h2) { font-size: 1.2rem; }
  .md-preview :global(p), .md-preview :global(ul), .md-preview :global(ol), .md-preview :global(blockquote), .md-preview :global(pre), .md-preview :global(table) { margin: 0 0 .8em; }
  .md-preview :global(ul), .md-preview :global(ol) { padding-left: 1.4em; }
  .md-preview :global(blockquote) { padding-left: 12px; border-left: 3px solid var(--hair); color: var(--soft); }
  .md-preview :global(code), .md-preview :global(pre) { font-family: var(--mono); font-size: 14px; background: var(--well); border-radius: 6px; }
  .md-preview :global(code) { padding: 1px 5px; }
  .md-preview :global(pre) { padding: 10px 12px; overflow: auto; }
  .md-preview :global(pre code) { padding: 0; background: none; }
  .md-preview :global(table) { border-collapse: collapse; }
  .md-preview :global(th), .md-preview :global(td) { padding: 6px 10px; border: 1px solid var(--hair); text-align: left; }
  .md-preview :global(a) { color: var(--ink); }
  .md-preview :global(img) { max-width: 100%; height: auto; }
</style>
