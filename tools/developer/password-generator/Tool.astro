---
import Step from "../../../src/components/Step.astro";
import Icon from "../../../src/components/Icon.astro";
---
<section class="tool" id="pw-tool" aria-label="Password generator">
  <Step n={1} title="Pick a kind">
    <fieldset class="field">
      <legend class="sr-only">Kind</legend>
      <div class="seg">
        <input type="radio" name="pw-kind" id="pw-password" value="password" checked><label for="pw-password">Password</label>
        <input type="radio" name="pw-kind" id="pw-phrase" value="phrase"><label for="pw-phrase">Passphrase</label>
      </div>
    </fieldset>
    <div id="pw-opts-password" class="pw-opts">
      <label class="field"><span>Length: <b id="pw-len-v">20</b></span><input type="range" id="pw-len" min="8" max="64" value="20"></label>
      <label class="check"><input type="checkbox" id="pw-upper" checked> A–Z</label>
      <label class="check"><input type="checkbox" id="pw-lower" checked> a–z</label>
      <label class="check"><input type="checkbox" id="pw-digits" checked> 2–9</label>
      <label class="check"><input type="checkbox" id="pw-symbols" checked> Symbols</label>
      <label class="check"><input type="checkbox" id="pw-similar"> Allow look-alikes (l, I, O, 0, 1)</label>
    </div>
    <div id="pw-opts-phrase" class="pw-opts" hidden>
      <label class="field"><span>Words: <b id="pw-words-v">6</b></span><input type="range" id="pw-words" min="3" max="12" value="6"></label>
      <label class="check"><input type="checkbox" id="pw-cap" checked> Capitalise</label>
      <label class="check"><input type="checkbox" id="pw-num" checked> Add a number</label>
    </div>
  </Step>
  <Step n={2} title="Copy your password">
    <div class="out">
      <output id="pw-out" class="out-box"></output>
      <span id="pw-meta" class="hint"></span>
    </div>
    <div class="actions">
      <button class="btn run" id="pw-copy" type="button"><Icon name="copy" /><span id="pw-copy-label">Copy</span></button>
      <button class="btn line" id="pw-new" type="button">Make another</button>
    </div>
  </Step>
</section>

<script>
  import { password, passphrase, strength } from "./core.js";
  import { WORDS } from "./words.js";
  const $ = (id: string) => document.getElementById(id)!;
  const on = (id: string) => ($(id) as HTMLInputElement).checked;
  const val = (id: string) => +($(id) as HTMLInputElement).value;
  function gen() {
    const phrase = on("pw-phrase");
    $("pw-opts-password").hidden = phrase; $("pw-opts-phrase").hidden = !phrase;
    $("pw-len-v").textContent = String(val("pw-len")); $("pw-words-v").textContent = String(val("pw-words"));
    try {
      const r = phrase
        ? passphrase(WORDS, { count: val("pw-words"), capitalize: on("pw-cap"), number: on("pw-num") })
        : password({ length: val("pw-len"), upper: on("pw-upper"), lower: on("pw-lower"), digits: on("pw-digits"), symbols: on("pw-symbols"), similar: on("pw-similar") });
      $("pw-out").textContent = r.value;
      $("pw-meta").textContent = `${strength(r.bits)} · about ${r.bits} bits of randomness`;
    } catch (e) { $("pw-out").textContent = ""; $("pw-meta").textContent = (e as Error).message; }
  }
  document.querySelectorAll("#pw-tool input").forEach((el) => el.addEventListener("input", gen));
  $("pw-new").addEventListener("click", gen);
  const copyLabel = $("pw-copy-label");
  $("pw-copy").addEventListener("click", async () => {
    try { await navigator.clipboard.writeText($("pw-out").textContent ?? ""); copyLabel.textContent = "Copied"; } catch { copyLabel.textContent = "Select to copy"; }
    setTimeout(() => (copyLabel.textContent = "Copy"), 1600);
  });
  gen();
</script>

<style>
  .pw-opts { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .pw-opts .field { width: 100%; }
  #pw-out { display: block; font-size: 20px; line-height: 1.4; overflow-wrap: anywhere; white-space: normal; }
  input[type="range"] { accent-color: var(--ink); }
</style>
