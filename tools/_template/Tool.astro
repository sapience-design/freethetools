---
// The working area of the tool. The page around it (name, $0 tag, specs, FAQ, credits) is built
// from tool.json, so this file only needs the interface. Style with the tokens in src/styles/global.css.
// Prefix every id with the tool slug: the sidebar shares the page, and the build fails on duplicate ids.
---
<section class="tool" aria-label="__NAME__">
  <label class="caps" for="__ID__-in">Input</label>
  <textarea id="__ID__-in" rows="8" placeholder="Type or paste here">Free the tools</textarea>
  <p class="caps">Result</p>
  <output id="__ID__-out" for="__ID__-in"></output>
</section>

<style>
  .tool { display: grid; gap: 10px; }
  .caps { color: var(--muted); }
  textarea { width: 100%; font: inherit; padding: 14px; border: 0; background: var(--studio); color: var(--ink); resize: vertical; }
  textarea:focus { outline: 2px solid var(--yellow); }
  output { display: block; min-height: 3em; padding: 14px; border: 1px solid var(--line); white-space: pre-wrap; }
</style>

<script>
  import { run } from "./core.js";
  const input = document.getElementById("__ID__-in") as HTMLTextAreaElement;
  const output = document.getElementById("__ID__-out")!;
  const update = () => (output.textContent = run(input.value));
  input.addEventListener("input", update);
  update(); // show a working example on first load
</script>
